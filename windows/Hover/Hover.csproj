<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows shell: a code-first WinUI 3 app (no .xaml files), unpackaged and
       self-contained, built with `dotnet build` / `dotnet publish`. The file is
       hoverai.exe, not Hover.exe: Discord's game list matches hover/hover.exe. -->
  <PropertyGroup>
    <AssemblyName>hoverai</AssemblyName>
    <RootNamespace>Hover</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hover.ico</ApplicationIcon>
    <StartupObject>Hover.Program</StartupObject>
    <!-- The version the Help menu shows is the repository's VERSION file. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</Version>
    <!-- This app has its own Main; there is no App.xaml. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Inter weights the notch's text is set in; they are looked up beside the program. -->
    <None Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Windows App SDK is referenced by the two components this app uses (Foundation, with
         the app lifecycle and the unpackaged start, and WinUI, which brings the input and window
         parts with it), not by the Microsoft.WindowsAppSDK package that adds all the others. Its
         Windows ML component alone is onnxruntime.dll and DirectML.dll, 42 MB nothing here calls. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <!-- The notch is drawn with Direct2D and DirectWrite onto a Direct3D 11 swap chain that
         DirectComposition shows; Vortice is the managed binding for all four. -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <ProjectReference Include="..\Hover.Host\Hover.Host.csproj" />
    <ProjectReference Include="..\Hover.Chat\Hover.Chat.csproj" />
    <ProjectReference Include="..\Hover.Notch\Hover.Notch.csproj" />
    <ProjectReference Include="..\Hover.Office\Hover.Office.csproj" />
    <!-- Voice, sound and music: the shortcut, the microphone, the voice card and the beats (office-beats.ogg is linked into it). -->
    <ProjectReference Include="..\Hover.Voice\Hover.Voice.csproj" />
    <!-- Settings: the pages, the painter, the Discord status and the Run value. -->
    <ProjectReference Include="..\Hover.Settings\Hover.Settings.csproj" />
  </ItemGroup>
</Project>
