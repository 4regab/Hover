<Project Sdk="Microsoft.NET.Sdk">
  <!-- `dotnet test` for Settings, the Discord status and the Screen capture. The pages, the painter and the
       controller run on any system with a fixed-width shaper; the round trips run against the real hover-backend
       (HOVER_BACKEND, as in Hover.Tests); the Run value, the capture of a window and the real-app checks need Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Hover.Settings.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hover.Settings\Hover.Settings.csproj" />
    <ProjectReference Include="..\Hover.Host\Hover.Host.csproj" />
    <ProjectReference Include="..\Hover.Voice\Hover.Voice.csproj" />
    <!-- What the Go code printed (golden/pages-dump.go.txt says how). -->
    <None Include="golden\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
