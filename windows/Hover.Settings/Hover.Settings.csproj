<Project Sdk="Microsoft.NET.Sdk">
  <!-- Settings with no window and no Windows call: the pages as data (internal/app/pages.go), what a
       click or a key in them asks of the backend (view.go), the page's own drawing on the panels'
       canvas, and the Discord status client. Text is measured by the shaper the caller gives, so
       Hover.Settings.Tests runs all of it on any system. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hover.Settings</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hover.Host\Hover.Host.csproj" />
    <ProjectReference Include="..\Hover.Notch\Hover.Notch.csproj" />
    <ProjectReference Include="..\Hover.Chat\Hover.Chat.csproj" />
    <ProjectReference Include="..\Hover.Voice\Hover.Voice.csproj" />
  </ItemGroup>
</Project>
