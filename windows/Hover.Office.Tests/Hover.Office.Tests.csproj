<Project Sdk="Microsoft.NET.Sdk">
  <!-- `dotnet test` for Hover.Office: the scene logic against numbers the Go code printed, and
       (on Windows) the Direct3D 11 drawing on the software adapter, with pictures. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Hover.Office.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Numbers the Go office printed (internal/office/golden_test.go). -->
    <None Include="golden\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hover.Office\Hover.Office.csproj" />
  </ItemGroup>
</Project>
