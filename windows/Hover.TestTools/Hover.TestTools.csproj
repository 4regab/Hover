<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programs the tests start: stand-ins for the tools Hover launches (codex-acp, codex), a
       backend that misbehaves on purpose, and a host that is killed in the job-object test.
       The same exe is copied under each stand-in's name; see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hover.TestTools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hover.Host\Hover.Host.csproj" />
  </ItemGroup>
</Project>
