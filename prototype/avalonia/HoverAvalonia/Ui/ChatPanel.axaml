<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HoverAvalonia.Ui.ChatPanel"
             x:CompileBindings="False"
             Width="360" Margin="0,8,8,8">
  <!-- Hover's chat drawer: card #120f14 with a #24212a border, 12 radius; header, thread, reply FAB. Sizes/colours read from the baseline screenshots (office-drawer.png). -->
  <Border Background="#FF120F14" BorderBrush="#FF24212A" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,10,10,8">
        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#FF9466F5" VerticalAlignment="Top">
          <TextBlock x:Name="Avatar" Text="K" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
          <TextBlock x:Name="Title" Text="Tidy the imports" Foreground="White" FontWeight="SemiBold" FontSize="14" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Background="#FF1F1D23" CornerRadius="6" Padding="7,2"><TextBlock Text="▭ project" Foreground="#FFB4B2BC" FontSize="11" /></Border>
            <Border Background="#33FFB340" CornerRadius="6" Padding="7,2"><TextBlock Text="◇ Trust all" Foreground="#FFFFC060" FontSize="11" FontWeight="Medium" /></Border>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
          <Border Background="#FF1F1D21" CornerRadius="8" Width="28" Height="28"><TextBlock Text="···" Foreground="#FFC8C6D0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <Border Background="#FF1F1D21" CornerRadius="8" Width="28" Height="28"><TextBlock Text="⤢" Foreground="#FFC8C6D0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <Border Background="#FF1F1D21" CornerRadius="8" Width="28" Height="28"><TextBlock Text="⌫" Foreground="#FFC8C6D0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <Border Background="#FF1F1D21" CornerRadius="8" Width="28" Height="28"><TextBlock Text="×" Foreground="#FFC8C6D0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" /></Border>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="12,4,12,56" Spacing="8">
          <!-- The user's message: right-aligned bubble with its time. -->
          <Border HorizontalAlignment="Right" Background="#FF1F1D23" CornerRadius="14,14,4,14" Padding="12,8" MaxWidth="260">
            <StackPanel>
              <TextBlock x:Name="UserText" Text="Tidy the imports" Foreground="#FFEDEBF2" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Text="2:55 PM" Foreground="#FF7C7A86" FontSize="10.5" HorizontalAlignment="Right" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="Steps" Text="2 read  ·  1 file edited  ·  1 run" Foreground="#FF8E8C98" FontSize="11.5" Margin="2,6,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
            <Border Background="#FF9466F5" CornerRadius="5" Width="16" Height="16"><TextBlock x:Name="Mini" Text="K" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock x:Name="Who" Text="Pip" Foreground="White" FontWeight="SemiBold" FontSize="13" />
          </StackPanel>
          <TextBlock x:Name="Heading" Text="Imports tidied" Foreground="White" FontWeight="Bold" FontSize="15" Margin="2,0,0,0" />
          <TextBlock x:Name="Body" Text="All 14 files now sort their imports." Foreground="#FFD6D4DC" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,0" />
          <Border x:Name="Code" Background="#FF0E0C10" BorderBrush="#FF24212A" BorderThickness="1" CornerRadius="8">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="10,6,6,0">
                <TextBlock Text="ts" Foreground="#FF8E8C98" FontSize="11" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="#FF1F1D23" CornerRadius="5" Padding="7,2"><TextBlock Text="Copy" Foreground="#FFB4B2BC" FontSize="11" /></Border>
              </Grid>
              <TextBlock Margin="10,10,10,12" FontFamily="monospace" FontSize="11.5" TextWrapping="NoWrap">
                <Run Foreground="#FFB48CFF" Text="export const " /><Run Foreground="#FFD6D4DC" Text="tidy = (f) =&gt; f." /><Run Foreground="#FF7CC0FF" Text="map" /><Run Foreground="#FFD6D4DC" Text="(sortImports);" />
              </TextBlock>
            </StackPanel>
          </Border>
          <Border x:Name="Changed" Background="#FF0E0C10" BorderBrush="#FF24212A" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="1 file changed" Foreground="White" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock Text="+3 -1" Foreground="#FF8E8C98" FontSize="11.5" VerticalAlignment="Center" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="app/imports.ts" Foreground="#FFB4B2BC" FontSize="11.5" FontFamily="monospace" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Text="+3" Foreground="#FF4ADE80" FontSize="11.5" /><TextBlock Text="−1" Foreground="#FFFF6B6B" FontSize="11.5" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,2,0,0">
            <TextBlock Text="⧉ Copy" Foreground="#FF9A98A4" FontSize="11.5" />
            <TextBlock Text="↻ Try again" Foreground="#FF9A98A4" FontSize="11.5" />
            <TextBlock x:Name="Meta" Text="1 s · 0.09 credits" Foreground="#FF7C7A86" FontSize="11.5" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="38" Height="38" CornerRadius="19" Background="#FF1B1A20" BorderBrush="#FF24212A" BorderThickness="1">
        <TextBlock Text="◌" Foreground="#FFC8C6D0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
      </Border>
    </Grid>
  </Border>
</UserControl>
