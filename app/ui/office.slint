// Owl/OfficeView.cs and web/office/page.html's UI around the scene: the office (the
// native renderer's frame) with the name tags over the bots, the HUD, the new-task
// circle, the panels (board, overview, history), the chat drawer, the toast, the prop
// tooltip and the delete confirmation; Settings laid over it all from the gear.

import { Pal, Fonts, Icon, Icons, PillButton } from "widgets.slint";
import { SettingsPage, Side, Block, Opt } from "settings.slint";
import { MarkPaths } from "marks.slint";
import { BotGlyph } from "bot.slint";
import { Desk, DeskBody, DeskTiles, DeskIcons, DButton } from "desk.slint";
export { Side, Block, Opt }


import "../assets/PixelifySans.ttf";

// What Settings shows, set from Rust for each window that has an office.
export global Page {
    in property <[Side]> sections;
    in property <int> current;
    in property <[Block]> blocks;
    in property <bool> recording;
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <[Opt]> menu;
    in property <string> menu-id;
    callback section(int);
    callback toggled(string, bool);
    callback pressed(string);
    callback picked-seg(string, int);
    callback open-picker(string, length, length);
    callback menu-pick(string, int);
    callback menu-close();
    callback tile(string);
    callback record();
    callback chord(KeyEvent) -> bool;
}

// What an agent asks before it acts (the state message's session.ask), as its card shows it.
// A question's choice (label, description), and whether it is picked now.
export struct QOpt { label: string, description: string, on: bool }
// One of the questions an agent asks the user (OpenCode's question tool): its header,
// the question, its choices, whether several may be picked, whether one's own answer
// may be typed, and what was typed so far.
export struct QData { header: string, question: string, options: [QOpt], multiple: bool, custom: bool, text: string }
export struct AskData { id: string, title: string, command: string, path: string, preview: string, reason: string, danger: bool, allow: string, more: int,
    question: bool, qs: [QData] }
// A model or an effort in the model menu.
export struct MOpt { id: string, label: string, on: bool }
// A bot's name tag and its bubble. stage: 0 waking, 1 working, 2 done, 3 failed, 4 stopped,
// 5 waiting (its question shows over its head in place of the bubble).
export struct TagData { id: int, x: length, y: length, name: string, color: color, tool: string, tool-color: color, text: string, stage: int, hot: bool,
    tool-id: string, asking: bool, ask: AskData }
// An access choice in the new-task box's menu.
export struct AccessOpt { id: string, label: string, note: string, on: bool }
export struct ToolData { id: string, name: string, ready: bool, hint: string }
// A panel row. kind: 0 heading (text, color, count), 1 card, 2 stats, 3 meter, 4 note, 5 search,
// 6 a history row (tool in sub, stage word in meta, its date in s1, the rest in count).
export struct PanelRow { kind: int, text: string, sub: string, meta: string, color: color, stage: int, count: string, open: int, key: string, pct: float, desk: bool,
    s1: string, s2: string, s3: string, s4: string }

export global Office {
    // The office's items are made (office_ui: false once the office is dropped after 30 s
    // hidden, so the renderer lets go of what it kept for them; true when it is made again).
    in property <bool> built: true;
    in property <image> scene;
    in property <[TagData]> tags;
    in property <string> hint;
    in property <length> tip-x;
    in property <length> tip-y;
    // What the pointer is over besides a prop: 1 a bot ("Chat with Juno"), 2 a desk with a
    // session at it ("Juno’s desk"); its name and colour.
    in property <int> over-kind;
    in property <string> over-name;
    in property <color> over-color;
    in property <bool> beats;
    // 0 follows the clock, 1 night, 2 day.
    in property <int> time-mode;
    in property <string> summary;
    // The new-task circle: 0 rest, 1 the logos, 2 the box.
    in property <int> fab;
    in property <[ToolData]> tools;
    in property <int> new-tool;
    // The HUD's one menu: time of day, music, history, Settings.
    in property <bool> menu;
    // The new task's tool access (ACCESS in main.js): its label, whether it is Trust all
    // (amber), and the menu of choices.
    in property <string> new-access: "Trust all";
    in property <bool> new-access-full: true;
    in property <string> new-access-tip;
    in property <bool> access-menu;
    in property <string> access-head;
    in property <[AccessOpt]> access-opts;
    // Kiro Web, for Kiro only: the box's cloud switch, the repo it clones ("Empty
    // workspace" for none) in place of the folder, and the menu of connected repos
    // (repo-note says it is loading, or why there are none).
    in property <bool> new-cloud-shown;
    in property <bool> new-cloud;
    in property <string> new-repo;
    in property <bool> repo-menu;
    in property <[AccessOpt]> repo-opts;
    in property <string> repo-note;
    // The open chat runs in Kiro Web: its cloud chip opens the session there.
    in property <bool> d-cloud;
    // The model pills (renderPill): the drawer's (d-) and the new-task box's (n-): the
    // model's name, its effort ("" none), and whether the tool offers any models.
    in property <string> d-model;
    in property <string> d-model-effort;
    in property <bool> d-model-shown;
    in property <string> n-model;
    in property <string> n-model-effort;
    in property <bool> n-model-shown;
    // #mMenu for a pill: 0 closed, 1 the drawer's, 2 the new-task box's; where the pill is
    // (window coordinates), and what it lists.
    in property <int> model-menu;
    in property <length> model-x;
    in property <length> model-y;
    in property <string> mm-head;
    in property <[MOpt]> mm-models;
    // Which of them is the picked one (the list opens on it).
    in property <int> mm-cur;
    in property <string> mm-effort-head;
    in property <[MOpt]> mm-efforts;
    in property <string> mm-note;
    // The note before the first task (KiroPage.Notice): the office waits behind it.
    in property <bool> notice;
    // The pictures attached to the reply (d-) and the new task (n-), as thumbnails.
    in property <[image]> d-shots;
    in property <[image]> n-shots;
    in-out property <string> new-draft;
    in property <string> new-folder: "Choose a folder";
    in property <string> new-note;
    in property <bool> new-go;
    in property <string> toast;
    in property <bool> toast-shown;
    in property <int> panel;
    in property <string> panel-title;
    in property <string> panel-sub;
    in property <[PanelRow]> rows;
    in-out property <string> find;
    in property <bool> confirm;
    in property <string> confirm-text;
    in property <string> confirm-title: "Delete this session?";
    in property <string> confirm-ok: "Delete";
    in property <bool> drawer;
    in property <string> d-name;
    in property <color> d-color;
    in property <string> d-tool;
    in property <color> d-tool-color;
    in property <string> d-title;
    in property <string> d-folder;
    in property <string> d-tool-id;
    // The session's own access: its label ("" hides the chip), id and note.
    in property <string> d-access;
    in property <string> d-access-id;
    in property <string> d-access-note;
    // The question in the chat (askHTML(s, 'chat')).
    in property <bool> d-asking;
    in property <AskData> d-ask;
    in property <float> d-ctx: -1;
    in property <image> d-thread;
    in property <bool> d-busy;
    // Asked to pause or stop; the tool hasn't said it has.
    in property <bool> d-stopping;
    in property <string> d-placeholder;
    // "Reply to Juno": the reply circle's name.
    in property <string> d-reply-label;
    in-out property <string> d-draft;
    // Raised after words are put into the draft from outside (dictation): the caret goes to its end.
    in property <int> d-draft-to-end;
    // The reply box is open (else just its circle at the thread's corner).
    in-out property <bool> d-compose;
    // The pointer is over the chat: voice's shortcut then writes into its open reply box.
    in-out property <bool> d-hover;
    // What dictation into the reply box is doing (Listening, Transcribing), or nothing.
    in property <string> d-voice;
    // "Latest": the reader is well above the end of the thread.
    in property <bool> d-jump;
    in-out property <length> d-thread-w;
    in-out property <length> d-thread-h;
    callback pointer(int, length, length);
    callback wheel(length, length, length);
    callback key(string);
    callback toggle-beats();
    callback toggle-menu();
    callback open-access();
    callback pick-access(string);
    callback toggle-cloud();
    callback open-repos();
    callback pick-repo(string);
    // The repo menu's search box: what is typed, and Enter (the first match is picked).
    callback repo-search(string);
    callback repo-search-enter();
    callback d-open-cloud();
    // The office answered a question: the session, the ask's id, allow | trust | deny.
    callback answer(int, string, string);
    // A question's choices: a pick (the question's index, the label), typed words, Answer,
    // and Answer… over the head, which opens the chat. The session, then the ask's id.
    callback q-pick(int, string, int, string);
    callback q-text(int, string, int, string);
    callback q-send(int, string);
    callback q-open(int);
    // The model pills and their menu.
    callback open-model(int, length, length);
    callback pick-model(string);
    callback pick-effort(string);
    callback notice-ok();
    // + attaches a picture to the box (2) or the reply (1); × takes one off.
    callback attach(int);
    callback unattach(int, int);
    // Ctrl+V in the box (2) or the reply (1): true when the clipboard held a picture and
    // it was attached (the box then doesn't paste); false lets the text be pasted.
    callback paste-image(int) -> bool;
    callback set-time(int);
    callback open-history();
    callback open-settings();
    callback fold();
    callback open-app();
    callback fab-main();
    callback pick-tool(int);
    callback new-go-clicked();
    // The task's words changed: Start is ready only with some.
    callback new-draft-edited();
    callback new-fold();
    callback new-folder-clicked();
    callback tag-clicked(int);
    callback panel-close();
    callback row-clicked(int);
    callback row-delete(int);
    callback find-edited(string);
    callback confirm-yes();
    callback confirm-no();
    callback d-close();
    callback d-send();
    callback d-delete();
    callback d-wheel(length);
    // A click in the thread (its summary lines, step blocks, Copy, links).
    callback d-click(length, length);
    // The pointer in the thread (0 press, 1 move while pressed, 2 release; Shift held): a
    // text selection.
    callback d-pointer(int, length, length, bool);
    // Ctrl+C: true when the thread had text selected and it was copied.
    callback d-copy() -> bool;
    // The thread's box changed size (the question card came or went): paint it again.
    callback d-resized();
    // A printable key while the chat has the keyboard: true when it opened the reply
    // box with that character in it.
    callback d-type(string) -> bool;
    // "Latest": scroll to the end of the thread.
    callback d-latest();
}

// .glass: rgba(22,15,30,.72) over the scene blurred 18 px (backdrop-filter), which
// Slint can't do: the office thread sends a blurred copy of each frame, and a glass
// panel shows the part of it under itself.
export global Backdrop {
    in property <image> blurred;
    in property <length> ox;
    in property <length> oy;
    in property <length> w;
    in property <length> h;
    // Off in the headless shots: the software renderer doesn't clip to rounded
    // corners, so the blurred frame would show as a square behind each glass.
    in property <bool> live: true;
}

// A text box that scrolls inside (the task, the reply): where it scrolls to so the
// caret at `c` (its top) stays in view, a line being about 1.45 of the font size.
global Caret {
    public pure function follow(y: length, h: length, c: length, font: length) -> length {
        if (c + y < 0) { return -c; }
        if (c + font * 1.45 + y > h) { return min(0px, h - c - font * 1.45); }
        y
    }
}

// The thin bar beside a text box that scrolls, so a long prompt shows there is more of it.
component InputThumb inherits Rectangle {
    in property <length> f-height;
    in property <length> f-content;
    in property <length> f-y;
    width: 3px;
    visible: self.f-content > self.f-height + 1px;
    thumb := Rectangle {
        width: 3px;
        border-radius: 1.5px;
        background: #ffffff38;
        height: max(14px, root.f-height * (root.f-height / max(1px, root.f-content)));
        y: (root.f-height - self.height) * (-root.f-y / max(1px, root.f-content - root.f-height));
    }
}

component Glass inherits Rectangle {
    // .glass's 1 px line; #fabMain has none.
    in property <bool> edge: true;
    border-radius: 13px;
    clip: true;
    if Backdrop.live: Image {
        x: Backdrop.ox - root.absolute-position.x;
        y: Backdrop.oy - root.absolute-position.y;
        width: Backdrop.w;
        height: Backdrop.h;
        source: Backdrop.blurred;
        image-fit: fill;
    }
    Rectangle { background: #160f1eb8; border-radius: root.border-radius; }
    // An element over the page's canvas takes the pointer: a press, a drag or the wheel
    // on the panel's empty parts must not reach the scene behind it.
    TouchArea { scroll-event(e) => { accept } }
    background: transparent;
    border-width: edge ? 1px : 0;
    border-color: #ffffff17;
    drop-shadow-blur: 36px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: #00000066;
}

// The chat and the side panel: a neutral graphite, not glass.
component Graphite inherits Rectangle {
    border-radius: 20px;
    clip: true;
    TouchArea { scroll-event(e) => { accept } }
    background: @linear-gradient(180deg, #131116f7 0%, #0d0c0ffa 100%);
    border-width: 1px;
    border-color: #ffffff14;
    drop-shadow-blur: 60px;
    drop-shadow-offset-y: 30px;
    drop-shadow-color: #000000b3;
}

// .x: a 32 px square button in the drawer's and panel's header.
component XButton inherits Rectangle {
    in property <string> icon;
    in property <string> id;
    in property <string> label;
    // The notch's short office (max-height: 620px): 26 px, radius 8.
    in property <bool> small;
    callback clicked;
    width: small ? 26px : 32px;
    height: self.width;
    border-radius: small ? 8px : 10px;
    background: ta.has-hover ? #ffffff17 : #ffffff0f;
    accessible-role: button;
    accessible-id: id;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    Icon { name: icon; size: 14px; tint: #f6f2ff9e; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// .chip: the drawer's folder, access and context.
component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <color> fg: #ffffff99;
    in property <color> bg: #ffffff0e;
    in property <string> tip;
    // A long folder gives way (elided) so the header's buttons keep their place.
    in property <bool> shrink;
    height: 20px;
    preferred-width: cl.preferred-width;
    min-width: shrink ? min(cl.preferred-width, 48px) : cl.preferred-width;
    max-width: cl.preferred-width;
    clip: true;
    border-radius: 6px;
    background: bg;
    accessible-role: AccessibleRole.text;
    accessible-label: tip != "" ? tip : text;
    cl := HorizontalLayout { padding-left: 7px; padding-right: 7px; spacing: 5px;
        if icon != "": VerticalLayout { alignment: center; Icon { name: icon; size: 11px; tint: fg; } }
        Text { text: root.text; font-size: 11px; font-weight: 500; color: fg; vertical-alignment: center; overflow: elide; } }
}

// One 34 × 32 button of a HUD group (.seg button).
component SegButton inherits Rectangle {
    in property <string> icon;
    in property <string> id;
    in property <string> label;
    in property <bool> on;
    in property <bool> gold: true;
    in property <bool> small;
    callback clicked;
    width: small ? 28px : 34px;
    height: small ? 28px : 32px;
    border-radius: small ? 8px : 10px;
    background: on ? #ffffff1f : ta.has-hover ? #ffffff10 : transparent;
    accessible-role: button;
    accessible-id: id;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: on;
    accessible-action-default => { clicked(); }
    Icon { name: icon; size: small ? 15px : 18px; tint: on && gold ? #ffd27a : ta.has-hover ? #f6f2ff : #f6f2ff9e; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
    // Its name shows on hover (the button is only its icon).
    out property <bool> hovered: ta.has-hover;
}

// The page's own HUD paths that Lucide's set here lacks.
global PagePaths {
    out property <string> moon: "M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z";
    out property <string> sun: "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z M12 2v2 M12 20v2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M2 12h2 M20 12h2 M4.9 19.1l1.4-1.4 M17.7 6.3l1.4-1.4";
    out property <string> history: "M3 12a9 9 0 1 0 3-6.7L3 8 M3 3v5h5 M12 7v5l3 2";
    out property <string> plus: "M12 5v14 M5 12h14";
    out property <string> up: "M12 19V5 M5 12l7-7 7 7";
    out property <string> stop: "M8 5h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Z";
    out property <string> search: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Z M20 20l-3.5-3.5";
    out property <string> menu: "M4 7h16 M4 12h16 M4 17h16";
    out property <string> chat: "M7.9 20A9 9 0 1 0 4 16.1L2 22Z";
    out property <string> down: "M12 5v14 M6 13l6 6 6-6";
    out property <string> auto: "M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z M12 4a8 8 0 0 0 0 16Z";
    out property <string> night: "M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z";
    out property <string> notes: "M9 18V5l12-2v13 M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z M18 13a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z";
    out property <string> shield: "M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6Z";
    out property <string> folder: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z";
    out property <string> bin: "M4 7h16 M10 11v6 M14 11v6 M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12 M9 7V4h6v3";
}

// .lg: a tool's logo in its circle (LOGOS in main.js, from LobeHub, MIT; the marks
// belong to their owners; OpenCode's is drawn for Hover in its style), on the page's
// viewBoxes: 24 units, Codex's 3 2.9 18 18.2.
component Logo inherits Rectangle {
    in property <string> tool;
    in property <bool> ready: true;
    in property <length> mark: 22px;
    in property <length> radius: self.width / 2;
    property <bool> codex: tool == "codex";
    property <bool> claude: tool == "claude";
    // Kiro's mark as an image: femtovg fills a Path this small in a few straight cuts,
    // which ran its eyes into one bar. The SVG is drawn at the size it shows.
    property <bool> kiro: !(codex || claude || tool == "cursor" || tool == "opencode");
    border-radius: radius;
    // .lg.off: grayscale(1) brightness(.55), worked out for each tile and mark.
    background: !ready ? (codex ? #8c8c8c : tool == "cursor" ? #070708 : tool == "opencode" ? #09090a : claude ? #4a4a4a : #363636)
        : codex ? white : tool == "cursor" ? #0d0d10 : tool == "opencode" ? #101012 : claude ? #d97757 : #9046ff;
    border-width: tool == "cursor" || tool == "opencode" ? 1px : 0;
    border-color: #ffffff24;
    if kiro: Image {
        width: mark;
        height: mark;
        source: @image-url("../assets/kiro.svg");
        colorize: ready ? white : #8c8c8c;
    }
    if !kiro: Path {
        // Claude's spark fills its whole grid, so it is drawn a little smaller (Marks' pad).
        width: claude ? mark * 0.82 : mark;
        height: claude ? mark * 0.82 : mark;
        viewbox-x: codex ? 3 : 0;
        viewbox-y: codex ? 2.9 : 0;
        viewbox-width: codex ? 18 : 24;
        viewbox-height: codex ? 18.2 : 24;
        commands: codex ? MarkPaths.codex : tool == "cursor" ? MarkPaths.cursor : claude ? MarkPaths.claude : MarkPaths.opencode;
        fill-rule: codex || claude ? nonzero : evenodd;
        fill: !ready ? (codex ? #565656 : tool == "cursor" ? #828283 : claude ? #9a9a9a : #868687)
            : codex ? @linear-gradient(180deg, #b1a7ff 0%, #7a9dff 50%, #3941ff 100%) : tool == "cursor" ? #ececf0 : claude ? white : #f4f4f6;
        stroke: transparent;
    }
    // Codex's prompt again, in the tile's colour (see MarkPaths).
    if codex: Path {
        width: mark;
        height: mark;
        viewbox-x: 3;
        viewbox-y: 2.9;
        viewbox-width: 18;
        viewbox-height: 18.2;
        commands: MarkPaths.codex-glyph;
        fill: root.background;
        stroke: transparent;
    }
}

// .av: the bot's small face in its colour.
component Face inherits Rectangle {
    in property <color> c;
    width: 22px;
    height: 20px;
    border-radius: 6px;
    background: c;
    Rectangle { x: 4px; y: 6px; width: parent.width - 8px; height: 8px; border-radius: 3px; background: #121018;
        Rectangle { x: 3px; y: 2px; width: 2px; height: 4px; background: #aaf6ff; }
        Rectangle { x: parent.width - 5px; y: 2px; width: 2px; height: 4px; background: #aaf6ff; }
    }
}

// .askc button: 0 plain, 1 .pri (light), 2 .dz (red).
component AskButton inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <length> tall: 26px;
    callback clicked;
    height: tall;
    width: t.preferred-width + 20px;
    border-radius: 8px;
    background: kind == 1 ? (ta.has-hover ? white : #f5f5f7) : kind == 2 ? #ff453a : ta.has-hover ? #ffffff2b : #ffffff1a;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }
    t := Text { text: root.text; font-size: 11.5px; font-weight: 600; color: kind == 1 ? black : white; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// .askc: the question as a card, over the bot's head (over) or at the end of its chat.
// Deny, Trust (this again for the session), and the allow button (Run, Allow edit…).
// A question (OpenCode's question tool) shows its choices instead (questionHTML): over
// the head only the first question and Skip / Answer…, which opens the chat; in the
// chat every question, its choices as buttons that toggle, a box for one's own answer
// where it takes one, then Skip / Answer.
component AskCard inherits Rectangle {
    in property <AskData> a;
    in property <string> tool;
    in property <bool> over;
    in property <length> w: 240px;
    callback answer(string);
    callback pick(int, string);
    callback typed(int, string);
    callback send();
    callback open();
    width: w;
    height: col.preferred-height;
    border-radius: 14px;
    background: over ? #0e0a12f2 : a.danger ? #ff453a0f : #ffb3400f;
    border-width: 1px;
    border-color: a.danger ? #ff453a8c : over ? #ffb34080 : #ffb34059;
    drop-shadow-blur: over ? 30px : 0;
    drop-shadow-offset-y: 14px;
    drop-shadow-color: #0000008c;
    accessible-role: groupbox;
    accessible-label: a.title;
    col := VerticalLayout {
        padding: over ? 8px : 10px;
        spacing: 0;
        HorizontalLayout {
            spacing: 7px;
            VerticalLayout { alignment: center; Logo { width: 16px; height: 16px; radius: 5px; mark: 11px; tool: tool; } }
            Text { text: a.title; font-size: 12.5px; font-weight: 600; color: white; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            if a.more > 0: Text { text: "+" + a.more + " more"; font-size: 10.5px; color: #ffffff73; vertical-alignment: center; }
        }
        if !a.question: VerticalLayout {
            Rectangle { height: over ? 6px : 8px; }
            Rectangle {
                border-radius: 9px;
                background: #00000073;
                height: min(pre.preferred-height + 14px, over ? 58px : 120px);
                clip: true;
                pre := VerticalLayout {
                    y: 7px;
                    padding-left: 9px;
                    padding-right: 9px;
                    if a.command != "": HorizontalLayout { spacing: 8px;
                        Text { text: "$"; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: #ffb340; }
                        Text { text: a.command; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: white; wrap: char-wrap; horizontal-stretch: 1; } }
                    if a.command == "" && a.path != "" && a.preview != "": Text { text: a.path; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: #ffffff80; }
                    if a.command == "" && a.preview != "": Text { text: a.preview; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: white; wrap: char-wrap; }
                    if a.command == "" && a.preview == "": Text { text: a.path != "" ? a.path : a.title; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: white; wrap: char-wrap; }
                }
            }
            Rectangle { height: over ? 5px : 7px; }
            HorizontalLayout {
                spacing: 7px;
                VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: a.danger ? #ff453a : #ffb340; } }
                Text { text: a.reason; font-size: 11px; color: #ffffff94; overflow: elide; horizontal-stretch: 1; }
            }
            Rectangle { height: over ? 7px : 9px; }
            HorizontalLayout {
                spacing: 6px;
                AskButton { text: "Deny"; tall: over ? 24px : 26px; clicked => { answer("deny"); } }
                Rectangle { horizontal-stretch: 1; }
                AskButton { text: "Trust"; tall: over ? 24px : 26px; clicked => { answer("trust"); } }
                AskButton { text: a.allow != "" ? a.allow : "Allow"; tall: over ? 24px : 26px; kind: a.danger ? 2 : 1; clicked => { answer("allow"); } }
            }
        }
        // .qq over the head: the first question's header and its question, two lines at most.
        if a.question && over: VerticalLayout {
            padding-top: 8px;
            padding-bottom: 2px;
            Text { text: a.qs[0].header; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px; letter-spacing: 0.63px; color: #ffb340; }
            Rectangle { height: 3px; }
            Text { text: a.qs[0].question; font-size: 12px; color: #ffffffdb; wrap: word-wrap; max-height: 31px; overflow: elide; }
            Rectangle { height: 6px; }
            HorizontalLayout {
                spacing: 6px;
                AskButton { text: "Skip"; tall: 24px; clicked => { answer("deny"); } }
                Rectangle { horizontal-stretch: 1; }
                AskButton { text: "Answer…"; tall: 24px; kind: 1; clicked => { open(); } }
            }
        }
        if a.question && !over: VerticalLayout {
            for q[qi] in a.qs: VerticalLayout {
                padding-top: 8px;
                padding-bottom: 2px;
                Text { text: q.header; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px; letter-spacing: 0.63px; color: #ffb340; }
                Rectangle { height: 3px; }
                Text { text: q.question; font-size: 12px; color: #ffffffdb; wrap: word-wrap; }
                Rectangle { height: 6px; }
                // .qo: the choices, one or several, then one's own answer.
                VerticalLayout {
                    spacing: 4px;
                    padding-bottom: 6px;
                    accessible-role: groupbox;
                    accessible-label: q.header + (q.multiple ? ", pick any" : ", pick one");
                    for o in q.options: Rectangle {
                        height: max(26px, ob.preferred-height);
                        border-radius: 8px;
                        background: o.on ? #ffb34038 : oa.has-hover ? #ffffff2b : #ffffff1a;
                        border-width: o.on ? 1px : 0;
                        border-color: #ffb340b3;
                        accessible-role: button;
                        accessible-label: o.label;
                        accessible-checkable: true;
                        accessible-checked: o.on;
                        accessible-action-default => { pick(qi, o.label); }
                        ob := VerticalLayout {
                            padding-left: 9px; padding-right: 9px; padding-top: 5px; padding-bottom: 5px;
                            spacing: 1px;
                            Text { text: o.label; font-size: 11.5px; font-weight: 500; color: white; wrap: word-wrap; }
                            if o.description != "": Text { text: o.description; font-size: 10.5px; color: #ffffff8c; wrap: word-wrap; }
                        }
                        oa := TouchArea { mouse-cursor: pointer; clicked => { pick(qi, o.label); } }
                    }
                    if q.custom: Rectangle {
                        height: 26px;
                        border-radius: 8px;
                        background: #00000066;
                        border-width: qt.has-focus ? 2px : 0;
                        border-color: #ffb340;
                        qt := TextInput {
                            x: 9px;
                            width: parent.width - 18px;
                            single-line: true;
                            font-size: 11.5px;
                            font-weight: 500;
                            color: white;
                            vertical-alignment: center;
                            accessible-role: text-input;
                            accessible-label: "Your own answer: " + q.header;
                            init => { self.text = q.text; }
                            edited => { typed(qi, self.text); }
                            key-pressed(e) => { if (e.text == "\n") { send(); return accept; } reject }
                        }
                        if qt.text == "": Text { x: 9px; text: "Or type your own answer"; font-size: 11.5px; font-weight: 500; color: #ffffff61; vertical-alignment: center; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                AskButton { text: "Skip"; clicked => { answer("deny"); } }
                Rectangle { horizontal-stretch: 1; }
                AskButton { text: "Answer"; kind: 1; clicked => { send(); } }
            }
        }
    }
    // The tail under the card over the head.
    if over: Rectangle { x: (parent.width - 10px) / 2; y: parent.height - 5px; width: 10px; height: 10px; background: #0e0a12f2; border-radius: 2px; transform-rotation: 45deg; }
}

component Tag inherits Rectangle {
    in property <TagData> t;
    callback clicked;
    width: 0;
    height: 0;
    x: t.x;
    y: t.y;
    // Sized to itself: the Tag is 0 wide, and a layout that narrow puts its rows off
    // centre from one another (the bubble and the name wouldn't line up).
    col := VerticalLayout {
        x: -self.width / 2;
        y: -self.height;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 4px;
        alignment: end;
        if t.asking: HorizontalLayout {
            alignment: center;
            AskCard { a: t.ask; tool: t.tool-id; over: true; answer(how) => { Office.answer(t.id, t.ask.id, how); }
                pick(qi, l) => { Office.q-pick(t.id, t.ask.id, qi, l); } typed(qi, v) => { Office.q-text(t.id, t.ask.id, qi, v); }
                send => { Office.q-send(t.id, t.ask.id); } open => { Office.q-open(t.id); } }
        }
        if t.text != "" && !t.asking: HorizontalLayout {
            alignment: center;
            bub := Rectangle {
                y: t.hot ? -2px : 0;
                // .bub: dark, a done one green and a failed one red, a stopped one only
                // its z z z (max-width 240, padding 6 11 7, Inter 500 12px).
                width: min(240px, bt.preferred-width + 22px);
                height: bt.preferred-height + 13px;
                animate y { duration: 200ms; }
                border-radius: 12px;
                background: t.stage == 4 ? transparent : t.stage == 2 ? #0a1e12eb : t.stage == 3 ? #280a0aeb : #0e0a12e6;
                border-width: t.stage == 4 ? 0 : 1px;
                border-color: t.stage == 2 ? #4ade8059 : t.stage == 3 ? #ff5b5259 : #ffffff1a;
                drop-shadow-blur: t.stage == 4 ? 0 : 24px;
                drop-shadow-offset-y: 10px;
                drop-shadow-color: #00000073;
                bt := Text {
                        x: 11px;
                        y: 6px;
                        width: min(218px, self.preferred-width);
                        text: t.text;
                        font-weight: 500;
                        font-size: t.stage == 4 ? 14px : 12px;
                        letter-spacing: t.stage == 4 ? 2.8px : 0;
                        color: t.stage == 4 ? #c9c2e6 : t.stage == 2 ? #b8f5c9 : t.stage == 3 ? #ffb3ad : white;
                        overflow: elide;
                }
                // The bubble's tail.
                if t.stage != 4: Rectangle { x: (parent.width - 10px) / 2; y: parent.height - 5px; width: 10px; height: 10px; background: parent.background; border-radius: 2px; transform-rotation: 45deg; }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                border-radius: 7px;
                background: t.hot ? t.color : #0a060eb8;
                border-width: t.hot ? 2px : 1px;
                border-color: t.hot ? #ffffffb3 : #ffffff14;
                accessible-role: button;
                accessible-label: t.name;
                accessible-action-default => { clicked(); }
                // .nm: the tool as its own small logo, then the bot's name.
                HorizontalLayout {
                    padding-left: 3px;
                    padding-right: 8px;
                    padding-top: 2px;
                    padding-bottom: 3px;
                    spacing: 5px;
                    VerticalLayout { alignment: center; Logo { width: 15px; height: 15px; radius: 4px; mark: 10px; tool: t.tool-id;
                        border-width: t.hot ? 1px : (t.tool-id == "cursor" || t.tool-id == "opencode" ? 1px : 0); border-color: t.hot ? #ffffff99 : #ffffff24; } }
                    Text { text: t.name; font-family: "Pixelify Sans"; font-weight: 600; font-size: 12px; letter-spacing: 0.36px; color: white; vertical-alignment: center; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
            }
        }
    }
}

// The side panels' rows (.card, .col h4, .stats, .meter).
component RowView inherits Rectangle {
    in property <PanelRow> r;
    // The list's width, known before the rows are laid out: a wrapped title needs it to be measured.
    in property <length> list-w;
    callback clicked;
    callback delete;
    height: lay.preferred-height;
    lay := VerticalLayout {
        if r.kind == 0: HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-bottom: 8px;
            padding-top: 6px;
            spacing: 8px;
            if r.color.alpha > 0: VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 2px; background: r.color; } }
            Text { text: r.text; font-family: "Pixelify Sans"; font-weight: 600; font-size: 12px; letter-spacing: 0.7px; color: #f6f2ff9e; horizontal-stretch: 1; }
            Text { text: r.count; font-family: "Pixelify Sans"; font-weight: 600; font-size: 12px; color: #f6f2ff61; }
        }
        if r.kind == 1 || r.kind == 3: HorizontalLayout {
            padding-bottom: 6px;
            spacing: 4px;
            card := Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                border-width: 1px;
                border-color: ta.has-hover ? #c4a2ff59 : #ffffff17;
                background: ta.has-hover ? #ffffff17 : #ffffff0a;
                accessible-role: button;
                accessible-label: r.text;
                accessible-action-default => { clicked(); }
                HorizontalLayout {
                    padding: 9px;
                    padding-left: 10px;
                    spacing: 10px;
                    VerticalLayout { alignment: center; Face { c: r.color; } }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        Text { text: r.sub; font-size: 11.5px; font-weight: 600; color: r.stage == 2 ? #30d158 : r.stage == 3 ? #ff453a : r.stage <= 1 ? #c4a2ff : #f6f2ff9e; overflow: elide; }
                        Text { text: r.text; width: list-w - 51px - (r.kind == 3 ? 44px : 0px); font-size: 12.5px; color: #f6f2ff; wrap: word-wrap; max-height: 34px; overflow: elide; }
                        if r.kind == 3: Rectangle { height: 5px; border-radius: 3px; background: #ffffff1a;
                            Rectangle { x: 0; width: parent.width * clamp(r.pct / 100, 0, 1); border-radius: 3px; background: #c4a2ff; } }
                        if r.meta != "": Text { text: r.meta; font-size: 11px; color: #f6f2ff61; overflow: elide; }
                    }
                    if r.kind == 3: VerticalLayout { alignment: center; Text { text: r.count; font-size: 11px; color: #f6f2ff61; } }
                }
                ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
            }
            if r.key != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 9px;
                    background: xa.has-hover ? #ffffff14 : transparent;
                    accessible-role: button;
                    accessible-label: "Delete " + r.text;
                    accessible-action-default => { delete(); }
                    Icon { name: PagePaths.bin; size: 15px; tint: xa.has-hover ? #f6f2ff : #f6f2ff61; }
                    xa := TouchArea { mouse-cursor: pointer; clicked => { delete(); } }
                }
            }
        }
        if r.kind == 2: HorizontalLayout {
            spacing: 8px;
            padding-bottom: 16px;
            for s[i] in [r.s1, r.s2, r.s3, r.s4]: Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                background: #ffffff0a;
                border-width: 1px;
                border-color: #ffffff17;
                VerticalLayout {
                    padding: 10px;
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: s; font-family: "Pixelify Sans"; font-weight: 600; font-size: 22px; horizontal-alignment: center;
                        color: i == 0 ? #c4a2ff : i == 1 ? #30d158 : i == 2 ? #ff453a : #8e8e93; }
                    Text { text: ["Working", "Done", "Failed", "Stopped"][i]; font-size: 11px; color: #f6f2ff9e; horizontal-alignment: center; }
                }
            }
        }
        if r.kind == 4: Text { text: r.text; font-size: 12.5px; color: #f6f2ff61; wrap: word-wrap; }
        // .hrow: the tool's logo, the task on one line, and under it how it went, when,
        // how long and where. Delete shows on hover.
        if r.kind == 6: Rectangle {
            height: 48px;
            border-radius: 10px;
            background: ha.has-hover ? #ffffff0d : transparent;
            accessible-role: button;
            accessible-label: r.text;
            accessible-action-default => { clicked(); }
            HorizontalLayout {
                padding: 8px;
                padding-right: 10px;
                spacing: 11px;
                VerticalLayout { alignment: center; Logo { width: 30px; height: 30px; radius: 9px; mark: r.sub == "codex" ? 21px : 17px; tool: r.sub; } }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 3px;
                    // .h1: the title, and its date at the right; the bin takes the date's place on hover.
                    HorizontalLayout { spacing: 8px;
                        Text { text: r.text; font-size: 13px; font-weight: 500; color: #f6f2ff; overflow: elide; horizontal-stretch: 1; }
                        Text { text: r.s1; font-size: 11.5px; color: #f6f2ff61; vertical-alignment: center; opacity: r.open != 1 && (ha.has-hover || xa2.has-hover) ? 0 : 1; }
                    }
                    HorizontalLayout { spacing: 5px;
                        VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px;
                            background: r.stage == 2 ? #30d158 : r.stage == 3 ? #ff453a : r.stage == 5 ? #ffb340 : r.stage <= 1 ? #b48cff : #8e8e93; } }
                        Text { text: r.meta; font-size: 11.5px; color: #f6f2ff9e; }
                        Text { text: "· " + r.count; font-size: 11.5px; color: #f6f2ff61; overflow: elide; horizontal-stretch: 1; }
                        if r.desk: VerticalLayout { alignment: center; Rectangle { height: 17px; width: dk.preferred-width + 12px; border-radius: 5px; background: #b48cff24;
                            dk := Text { text: "At a desk"; font-size: 10.5px; font-weight: 500; color: #d8c6ff; } } }
                        // A Kiro Web session Hover doesn't have yet (open 1): the cloud mark.
                        if r.open == 1: VerticalLayout { alignment: center; Rectangle { height: 17px; width: wk.preferred-width + 24px; border-radius: 5px; background: #6ba8ff24;
                            Icon { x: 5px; name: Icons.cloud; size: 11px; tint: #8fbcff; }
                            wk := Text { x: 19px; text: "Kiro Web"; font-size: 10.5px; font-weight: 500; color: #b8d4ff; } } }
                    }
                }
            }
            ha := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
            // Not for a Kiro Web session Hover doesn't keep (open 1): there is nothing here to delete.
            Rectangle {
                visible: r.open != 1;
                opacity: ha.has-hover || xa2.has-hover ? 1 : 0;
                x: parent.width - 32px;
                y: 5px;
                width: 26px;
                height: 24px;
                border-radius: 8px;
                background: xa2.has-hover ? #ff453a24 : transparent;
                accessible-role: button;
                accessible-label: "Delete " + r.text;
                accessible-action-default => { delete(); }
                Icon { name: PagePaths.bin; size: 14px; tint: xa2.has-hover ? #ff7b72 : #f6f2ff9e; }
                xa2 := TouchArea { mouse-cursor: pointer; clicked => { delete(); } }
            }
        }
    }
}

// .mpill: the model and its effort, with a chevron; its menu opens above it.
component MPill inherits Rectangle {
    in property <string> model;
    in property <string> effort;
    in property <bool> open;
    in property <string> id;
    in property <length> max-w: 200px;
    callback clicked(length, length);
    height: 28px;
    width: min(max-w, pl.preferred-width);
    border-radius: 14px;
    background: ta.has-hover || open ? #ffffff14 : transparent;
    accessible-role: button;
    accessible-id: id;
    accessible-label: "Model: " + model + (effort != "" ? ", " + effort : "") + ". Change";
    accessible-action-default => { clicked(self.absolute-position.x, self.absolute-position.y); }
    pl := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        Text { text: model; font-size: 12.5px; font-weight: 600; color: #f6f2ff; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        // The effort is picked in the menu the pill opens, so the pill names only the model.
        VerticalLayout { alignment: center; Icon { name: Icons.chevron-down; size: 12px; tint: #f6f2ff9e; } }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(root.absolute-position.x, root.absolute-position.y); } }
}

// .shots: the pictures attached so far, each with its ×.
component Shots inherits HorizontalLayout {
    in property <[image]> shots;
    in property <int> which;
    spacing: 6px;
    alignment: start;
    for im[i] in shots: Rectangle {
        width: 52px;
        height: 52px;
        border-radius: 9px;
        clip: true;
        background: black;
        border-width: 1px;
        border-color: #ffffff17;
        Image { width: 100%; height: 100%; source: im; image-fit: cover; }
        Rectangle {
            x: parent.width - 21px;
            y: 3px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: #000000b3;
            accessible-role: button;
            accessible-label: "Remove this image";
            accessible-action-default => { Office.unattach(which, i); }
            Icon { name: Icons.close; size: 9px; tint: white; }
            TouchArea { mouse-cursor: pointer; clicked => { Office.unattach(which, i); } }
        }
    }
}

// .clip: the round + that attaches an image.
component ClipButton inherits Rectangle {
    in property <string> id;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: ta.has-hover ? #ffffff14 : transparent;
    accessible-role: button;
    accessible-id: id;
    accessible-label: "Attach an image";
    accessible-action-default => { clicked(); }
    Icon { name: PagePaths.plus; size: 16px; tint: ta.has-hover ? #f6f2ff : #f6f2ff61; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// .go: the round send / start button (a square while it stops the run). The reply's is
// a 28 px circle (round), and shows Pause while a run goes and the box is empty.
component GoButton inherits Rectangle {
    in property <string> id;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> stop;
    in property <bool> pause;
    in property <bool> round;
    callback clicked;
    width: round ? 28px : 30px;
    height: self.width;
    border-radius: round ? 14px : 10px;
    background: !enabled && round ? #ffffff1c : ta.has-hover && enabled ? white : #f5f5f7;
    opacity: enabled || round ? 1 : 0.3;
    accessible-role: button;
    accessible-id: id;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    if stop: Rectangle { width: 11px; height: 11px; border-radius: 2.5px; background: black; }
    if pause: HorizontalLayout { alignment: center; spacing: 2.4px; padding-top: 8px; padding-bottom: 8px;
        Rectangle { width: 2.8px; border-radius: 1px; background: #131116; }
        Rectangle { width: 2.8px; border-radius: 1px; background: #131116; } }
    if !stop && !pause: Icon { name: PagePaths.up; size: 14px; tint: !enabled && round ? #ffffff5c : black; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// #mMenu's rows: a model (a check on the picked one), or an effort in its row.
component MenuRow inherits Rectangle {
    in property <MOpt> o;
    in property <bool> seg;
    callback clicked;
    height: seg ? 26px : max(28px, rt.preferred-height + 12px);
    border-radius: 8px;
    background: seg ? (o.on ? #9046ff59 : ta.has-hover ? #ffffff17 : #ffffff0d) : ta.has-hover ? #ffffff17 : transparent;
    accessible-role: list-item;
    accessible-label: o.label;
    accessible-checkable: true;
    accessible-checked: o.on;
    accessible-action-default => { clicked(); }
    HorizontalLayout {
        padding-left: seg ? 0 : 8px;
        padding-right: seg ? 0 : 8px;
        spacing: 8px;
        rt := Text { text: o.label; font-size: seg ? 11.5px : 12.5px; color: #f6f2ff; vertical-alignment: center; horizontal-alignment: seg ? center : left;
            wrap: word-wrap; horizontal-stretch: 1; }
        if o.on && !seg: VerticalLayout { alignment: center; Icon { name: Icons.check; size: 12px; tint: #c4a2ff; } }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The desk as a card, in the chat's style: who works here and on what (the chat's header),
// what it does now (its last steps, the question it waits on, or the answer it gave), its
// eight surfaces as tiles with what each holds, a reply box and the chat (#deskMenu).
component DeskCard inherits Rectangle {
    in property <length> max-w;
    in property <length> max-h;
    // A short office (Small is 340 tall): the tiles keep their title and drop what they hold.
    property <bool> tight: max-h < 340px;
    // What is in the card besides the status box, so the box takes what is left (up to 104),
    // and the card never asks for more than the office has.
    property <length> rest: 2 * 6px + hd.preferred-height + tiles.height + dcomp.preferred-height + 28px + 4 * 5px;
    property <length> now-cap: max(56px, min(104px, max-h - rest));
    width: min(408px, max-w);
    height: min(col.preferred-height, max-h);
    border-radius: 16px;
    background: #140f18f7;
    border-width: 1px;
    border-color: #ffffff1a;
    drop-shadow-blur: 40px;
    drop-shadow-offset-y: 18px;
    drop-shadow-color: #000000bf;
    clip: true;
    accessible-role: groupbox;
    accessible-id: "deskCard";
    accessible-label: Desk.c-name + "’s desk";
    // The bot's colour, washed over the top.
    // Placed by y: left to itself a Rectangle with only a height sits in the middle of the
    // card, which put this wash's hard top edge across the status box.
    Rectangle { y: 0; width: parent.width; height: 56px; background: @linear-gradient(180deg, Desk.c-color.with-alpha(0.2) 0%, Desk.c-color.with-alpha(0) 100%); }
    TouchArea { scroll-event(e) => { accept } }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            // While a permission waits, the keys answer it as they do on the notch.
            if (Desk.c-asking && !Desk.c-ask-question) {
                if (e.text == Key.Escape) { Office.answer(Desk.c-id, Desk.c-ask-id, "deny"); return accept; }
                if (e.text == "\n") { Office.answer(Desk.c-id, Desk.c-ask-id, e.modifiers.shift ? "trust" : "allow"); return accept; }
            }
            if (e.text == Key.Escape) { Desk.card-close(); return accept; }
            if (e.text == "\n") { Desk.card-chat(); return accept; }
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && Desk.card-key(e.text)) { return accept; }
            reject
        }
        col := VerticalLayout {
            padding: 6px;
            spacing: 5px;
            // .dhd: the tool's logo with a dot for how it goes; the desk's name and its chips
            // on one line, the task under them.
            hd := HorizontalLayout {
                // Flush with the box and the tiles below: the logo and the chips share their edge.
                padding: 0px;
                padding-top: 2px;
                padding-bottom: 1px;
                spacing: 9px;
                VerticalLayout { alignment: start;
                    Rectangle { width: 30px; height: 30px;
                        Logo { width: 30px; height: 30px; radius: 9px; mark: Desk.c-tool-id == "codex" ? 20px : 17px; tool: Desk.c-tool-id;
                            accessible-role: image; accessible-label: Desk.c-tool; }
                        Rectangle { x: 22px; y: 22px; width: 10px; height: 10px; border-radius: 5px; border-width: 2px; border-color: #17141b;
                            background: Desk.c-stage <= 1 ? #c4a2ff : Desk.c-stage == 2 ? #30d158 : Desk.c-stage == 3 ? #ff453a : Desk.c-stage == 5 ? #ffb340 : #8e8e93; }
                    } }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    HorizontalLayout { spacing: 8px; alignment: start;
                        VerticalLayout { alignment: center;
                            Text { text: (Desk.c-name + "’s desk").to-uppercase(); font-family: "Pixelify Sans"; font-weight: 600; font-size: 11.5px; letter-spacing: 0.7px;
                                color: Desk.c-color.mix(white, 0.45); overflow: elide; } }
                        HorizontalLayout { spacing: 5px; alignment: start; horizontal-stretch: 1;
                            Chip { text: Desk.c-clock != "" ? Desk.c-what + " · " + Desk.c-clock : Desk.c-what;
                                fg: Desk.c-stage <= 1 ? #d9c4ff : Desk.c-stage == 2 ? #7ee59a : Desk.c-stage == 3 ? #ff9a92 : Desk.c-stage == 5 ? #ffc46b : #ffffff99;
                                bg: Desk.c-stage <= 1 ? #9b6bff24 : Desk.c-stage == 2 ? #30d1581a : Desk.c-stage == 3 ? #ff453a1f : Desk.c-stage == 5 ? #ffb3401f : #ffffff0e; }
                            if Desk.c-folder != "": Chip { icon: PagePaths.folder; text: Desk.c-folder; shrink: true; }
                            if Desk.c-access != "": Chip { icon: PagePaths.shield; text: Desk.c-access; tip: Desk.c-access-note;
                                fg: Desk.c-access-id == "full" ? #ffc46b : #ffffff99; bg: Desk.c-access-id == "full" ? #ffb34017 : #ffffff0e; }
                            if Desk.c-ctx >= 0: Chip { text: Desk.c-ctx + "%"; tip: Desk.c-ctx + "% of the context window used"; }
                        }
                    }
                    Text { text: Desk.c-title; font-size: 13px; font-weight: 600; color: white; overflow: elide; accessible-role: text; accessible-id: "deskTitle"; }
                }
            }
            // .dnow: its last steps, the question, or the answer.
            Rectangle {
                vertical-stretch: 0;
                // Its content's height up to a cap (what the office leaves it); what is past
                // the cap scrolls with the wheel and fades out inside the box's own border
                // instead of running under the tiles.
                height: min(now.preferred-height, now-cap);
                border-radius: 11px;
                background: #ffffff08;
                border-width: 1px;
                border-color: #ffffff0d;
                clip: true;
                nowf := Flickable {
                    width: parent.width;
                    height: parent.height;
                    interactive: false;
                    content-height: now.preferred-height;
                now := VerticalLayout {
                    y: 0;
                    width: parent.width;
                    // Its own height, not the box's: a box capped shorter scrolls this instead
                    // of squeezing the lines together.
                    height: self.preferred-height;
                    padding: 8px;
                    padding-top: 6px;
                    padding-bottom: 7px;
                    spacing: 2px;
                    if Desk.c-asking: VerticalLayout { spacing: 2px;
                        Text { text: Desk.c-ask-title; font-size: 12px; font-weight: 600; color: #ffd59a; overflow: elide; }
                        if Desk.c-ask-line != "": Text { text: Desk.c-ask-line; font-size: 12px; color: #ffd59abf; overflow: elide; }
                        // The same answers as the bubble over the bot's head and the notch:
                        // Enter allows, Shift+Enter trusts, Esc denies. Review opens the chat.
                        if !Desk.c-ask-question: HorizontalLayout { padding-top: 4px; spacing: 6px;
                            AskButton { text: "Deny"; clicked => { Office.answer(Desk.c-id, Desk.c-ask-id, "deny"); } }
                            AskButton { text: "Review"; clicked => { Desk.card-chat(); } }
                            Rectangle { horizontal-stretch: 1; }
                            AskButton { text: "Trust"; clicked => { Office.answer(Desk.c-id, Desk.c-ask-id, "trust"); } }
                            AskButton { text: Desk.c-ask-allow; kind: Desk.c-ask-danger ? 2 : 1; clicked => { Office.answer(Desk.c-id, Desk.c-ask-id, "allow"); } } }
                        if Desk.c-ask-question: HorizontalLayout { padding-top: 4px; spacing: 6px;
                            AskButton { text: "Skip"; clicked => { Office.answer(Desk.c-id, Desk.c-ask-id, "deny"); } }
                            Rectangle { horizontal-stretch: 1; }
                            AskButton { text: "Answer…"; kind: 1; clicked => { Desk.card-chat(); } } } }
                    if !Desk.c-asking: VerticalLayout {
                        for s in Desk.c-steps: Rectangle {
                            height: 22px;
                            HorizontalLayout { spacing: 8px; padding-left: 2px;
                                VerticalLayout { alignment: center;
                                    Rectangle { width: 18px; height: 18px; border-radius: 6px; background: s.color.with-alpha(0.14); border-width: s.live ? 1px : 0; border-color: #ffc46b80;
                                        Icon { name: DeskIcons.step(s.icon); size: 12px; tint: s.fail ? #ff7b72 : s.color; } } }
                                Text { text: s.name; font-size: 12px; font-weight: 600; color: s.fail ? #ff9a92 : #f3f1f6; vertical-alignment: center; }
                                Text { text: s.text; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #ffffff8c; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                    if !Desk.c-asking && Desk.c-steps.length == 0 && Desk.c-answer == "": Text { text: Desk.c-line; font-size: 12px; color: #f6f2ff9e; wrap: word-wrap; max-height: 36px; overflow: elide; }
                    if !Desk.c-asking && Desk.c-steps.length == 0 && Desk.c-answer != "": Text { text: Desk.c-answer; font-size: 12.5px; color: Desk.c-answer-err ? #ffb0aa : #e9e7ec;
                        wrap: word-wrap; max-height: 56px; overflow: elide; }
                    if !Desk.c-asking && Desk.c-steps.length == 0 && Desk.c-answer != "" && Desk.c-meta != "": Text { text: Desk.c-meta; font-size: 12px; color: #f6f2ff9e; }
                    if Desk.c-helpers.length > 0: HorizontalLayout { padding-top: 3px; spacing: 4px; alignment: start;
                        for c in Desk.c-helpers: VerticalLayout { alignment: center; Rectangle { width: 12px; height: 11px; border-radius: 3px; background: c; } }
                        Text { text: " " + Desk.c-helpers-text; font-size: 11.5px; color: #ffffff80; vertical-alignment: center; overflow: elide; } }
                }
                }
                // Past the cap the last line fades out at the box's bottom edge, until it is scrolled to.
                if now.preferred-height > now-cap + 1px && nowf.content-y > nowf.height - now.preferred-height + 1px: Rectangle { x: 8px; y: parent.height - 26px; width: parent.width - 16px; height: 24px;
                    background: @linear-gradient(180deg, #16111a00 0%, #16111af2 100%); }
            }
            tiles := DeskTiles { tight: root.tight; }
            // .dcomp: the reply, and the round button that sends it or stops the run.
            Rectangle {
                height: dcomp.preferred-height;
                border-radius: 13px;
                background: #1b181f;
                border-width: 1px;
                border-color: dinput.has-focus ? #c4a2ff8c : #ffffff14;
                dcomp := HorizontalLayout {
                    padding-left: 10px; padding-right: 3px; padding-top: 3px; padding-bottom: 3px; spacing: 6px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: max(28px, min(96px, dinput.preferred-height + 6px));
                        dfl2 := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: false;
                            content-height: max(self.height, dinput.preferred-height + 3px);
                            dinput := TextInput {
                                y: 4px;
                                width: parent.width;
                                text <=> Desk.c-draft;
                                wrap: word-wrap;
                                single-line: false;
                                font-size: 12.5px;
                                color: #f6f2ff;
                                accessible-role: text-input;
                                accessible-id: "deskInput";
                                accessible-label: Desk.c-placeholder;
                                cursor-position-changed(c) => { dfl2.content-y = Caret.follow(dfl2.content-y, dfl2.height, c.y, self.font-size); }
                                key-pressed(e) => {
                                    if (e.text == "\n" && !e.modifiers.shift && self.preedit-text == "") { Desk.card-send(); return accept; }
                                    // Esc denies only from an empty box: with words typed it is leaving the reply.
                                    if (e.text == Key.Escape && Desk.c-asking && !Desk.c-ask-question && self.text == "") { Office.answer(Desk.c-id, Desk.c-ask-id, "deny"); return accept; }
                                    if (e.text == Key.Escape) { Desk.card-close(); return accept; }
                                    reject
                                }
                            }
                        }
                        if Desk.c-draft == "" && dinput.preedit-text == "": Text { y: 4px; width: parent.width; text: Desk.c-placeholder; font-size: 12.5px; color: #f6f2ff61; overflow: elide; }
                    }
                    VerticalLayout { alignment: end;
                        // Asking, the button is only Send: a Stop here reads as "send ends the run".
                        GoButton { id: "deskSend"; round: true;
                            property <bool> empty: Desk.c-draft == "";
                            enabled: !self.empty || (Desk.c-busy && !Desk.c-stopping && !Desk.c-asking);
                            stop: self.empty && Desk.c-busy && !Desk.c-asking;
                            label: self.empty && Desk.c-busy && !Desk.c-asking ? "Stop the run" : "Send";
                            clicked => { Desk.card-send(); } } }
                }
            }
            // The chat itself.
            Rectangle {
                height: 28px;
                border-radius: 10px;
                background: cta.has-hover ? Desk.c-color.with-alpha(0.32) : Desk.c-color.with-alpha(0.2);
                border-width: 1px;
                border-color: Desk.c-color.with-alpha(0.35);
                accessible-role: button;
                accessible-id: "deskChat";
                accessible-label: Desk.c-chat-label;
                accessible-action-default => { Desk.card-chat(); }
                HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px;
                    VerticalLayout { alignment: center; Icon { name: DeskIcons.chat; size: 16px; tint: white; } }
                    Text { text: Desk.c-chat-label; font-size: 12.5px; font-weight: 600; color: white; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    VerticalLayout { alignment: center; Icon { name: DeskIcons.enter; size: 13px; tint: #ffffff8c; } }
                }
                cta := TouchArea { mouse-cursor: pointer; clicked => { Desk.card-chat(); } }
            }
        }
    }
}

export component OfficeView inherits Rectangle {
    in property <bool> dashboard;
    in property <bool> in-settings;
    callback back();
    callback fold();
    // @media (max-height: 620px): the notch opens the office short and wide, so
    // everything over the scene gets smaller and the chat gives its height to the thread.
    property <bool> compact: root.height <= 620px;

    // Esc steps back one layer: the page's keydown on the document, which sees it
    // whichever field has the keyboard (the task box, the reply, the search).
    public function escape() {
        // The app window has nothing to fold: there Esc takes Settings back to its office.
        if (in-settings) { if (dashboard) { root.back(); } else { root.fold(); } return; }
        if (Office.confirm) { Office.confirm-no(); return; }
        if (Desk.card) { Desk.card-close(); return; }
        if (Office.model-menu != 0) { Office.open-model(0, 0, 0); return; }
        if (Office.access-menu) { Office.open-access(); return; }
        if (Office.repo-menu) { Office.open-repos(); return; }
        if (Office.menu) { Office.toggle-menu(); return; }
        if (Office.fab != 0) { Office.new-fold(); return; }
        // The reply box closes first, and keeps what was written.
        if (Office.drawer && Office.d-compose) { Office.d-compose = false; focus.focus(); return; }
        if (Office.drawer) { Office.d-close(); return; }
        if (Desk.panel) { Desk.panel-close(); return; }
        if (Office.panel != 0) { Office.panel-close(); return; }
        root.fold();
    }

    // Edge to edge: in the notch its shape clips it (the page drops its border in
    // body.host.notch), in the app window it fills the window.
    office := Rectangle {
        visible: !in-settings;
        clip: true;
        background: #07050a;
        // The box's and the chat's text fields take the keyboard; when they go, nothing
        // has it and Esc would do nothing (the page's keys are on the document, which
        // always has them). So it comes back here.
        property <int> fab-now: Office.fab;
        property <bool> drawer-now: Office.drawer;
        property <int> panel-now: Office.panel;
        property <bool> confirm-now: Office.confirm;
        property <bool> menu-now: Office.menu;
        property <bool> settings-now: root.in-settings;
        // #drawer and #panel: 12 px from the edges and up to 400 wide; 8 and 360 short.
        property <length> side-gap: compact ? 8px : 12px;
        property <length> side-w: min(compact ? 360px : 400px, self.width - 2 * side-gap);
        // The desk's panel is wider: its tabs are the eight surfaces.
        property <length> desk-w: min(720px, self.width - 2 * side-gap);
        property <bool> desk-now: Desk.card || Desk.panel;
        changed fab-now => { if (self.fab-now == 0 && !Office.drawer) { focus.focus(); } }
        changed drawer-now => { if (!self.drawer-now && Office.fab == 0) { focus.focus(); } }
        changed panel-now => { if (Office.fab == 0) { focus.focus(); } }
        changed confirm-now => { if (!self.confirm-now && Office.fab == 0) { focus.focus(); } }
        changed menu-now => { if (!self.menu-now && Office.fab == 0) { focus.focus(); } }
        changed settings-now => { if (!self.settings-now) { focus.focus(); } }
        changed desk-now => { if (!self.desk-now && Office.fab == 0) { focus.focus(); } }
        focus := FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.escape(); return accept; }
                if (e.modifiers.control && (e.text == "c" || e.text == "C") && Office.d-copy()) { return accept; }
                // A character typed while the chat is open goes to its reply box (with
                // AltGr's, which arrive as Ctrl+Alt; not a shortcut's).
                if (Office.drawer && !Office.d-compose && !Office.confirm && Office.model-menu == 0 && !Office.menu && !e.modifiers.meta
                    && (e.modifiers.control == e.modifiers.alt) && Office.d-type(e.text)) { return accept; }
                Office.key(e.text);
                accept
            }
        }
        scene-img := Image {
            width: 100%;
            height: 100%;
            init => { Backdrop.ox = self.absolute-position.x; Backdrop.oy = self.absolute-position.y; Backdrop.w = self.width; Backdrop.h = self.height; }
            changed width => { Backdrop.w = self.width; Backdrop.ox = self.absolute-position.x; }
            changed height => { Backdrop.h = self.height; Backdrop.oy = self.absolute-position.y; }
            source: Office.scene;
            image-fit: fill;
            image-rendering: pixelated;
            accessible-role: image;
            accessible-label: Office.summary;
        }
        scene-ta := TouchArea {
            mouse-cursor: Office.hint != "" ? pointer : default;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { focus.focus(); Office.pointer(1, self.mouse-x, self.mouse-y); }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) { Office.pointer(2, self.mouse-x, self.mouse-y); }
            }
            moved => { Office.pointer(0, self.mouse-x, self.mouse-y); }
            double-clicked => { Office.pointer(3, self.mouse-x, self.mouse-y); }
            scroll-event(e) => { Office.wheel(e.delta-y, self.mouse-x, self.mouse-y); accept }
            changed has-hover => { if (!self.has-hover) { Office.pointer(4, 0, 0); } }
        }
        // body.host.notch #office::before: the top 44 px fade into the notch's black.
        if !root.dashboard: Rectangle { y: 0; height: 44px; background: @linear-gradient(180deg, #000000e6 0%, #00000000 100%); }
        for t in Office.tags: Tag { t: t; clicked => { Office.tag-clicked(t.id); } }
        // The tip over a bot or a desk with a session at it.
        if Office.over-kind != 0: Rectangle {
            x: min(Office.tip-x + 14px, parent.width - self.width - 6px);
            y: Office.tip-y + 16px;
            width: ov.preferred-width;
            height: 30px;
            border-radius: 10px;
            background: #0e0a12e0;
            border-width: 1px;
            border-color: #ffffff1a;
            drop-shadow-blur: 22px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #000000b3;
            accessible-role: text;
            accessible-label: Office.over-kind == 1 ? "Chat with " + Office.over-name : Office.over-name + "’s desk";
            ov := HorizontalLayout {
                padding-left: 6px;
                padding-right: 11px;
                spacing: 7px;
                VerticalLayout { alignment: center;
                    Rectangle { width: 20px; height: 20px; border-radius: 6px; background: Office.over-color.with-alpha(0.3);
                        Icon { name: Office.over-kind == 1 ? DeskIcons.chat : DeskIcons.screen; size: 13px; tint: white; } } }
                if Office.over-kind == 1: Text { text: "Chat with"; font-size: 12px; color: #f6f2ff9e; vertical-alignment: center; }
                Text { text: Office.over-kind == 1 ? Office.over-name : Office.over-name + "’s desk"; font-size: 12px; font-weight: 600; color: white; vertical-alignment: center; }
                if Office.over-kind == 2: Text { text: "Browser, terminal, files, screen…"; font-size: 11px; color: #f6f2ff61; vertical-alignment: center; }
            }
        }
        if Office.hint != "": Rectangle {
            x: Office.tip-x + 14px;
            y: Office.tip-y + 16px;
            width: tip.preferred-width + 18px;
            height: tip.preferred-height + 8px;
            border-radius: 8px;
            background: #0a060ed9;
            border-width: 1px;
            border-color: #ffffff1a;
            tip := Text { text: Office.hint; font-family: "Pixelify Sans"; font-weight: 600; font-size: 12px; color: #f6f2ff; }
        }

        // The HUD: one menu button. Under the drawer and the panels (z-index 4 against
        // their 5): only the part a drawer leaves free shows.
        Glass {
            visible: (!Office.drawer && Office.panel == 0 && !Desk.panel) || (parent.width - side-gap - (Desk.panel ? desk-w : side-w) > self.x + self.width);
            x: parent.width - self.width - (compact ? 10px : 16px);
            y: compact ? 10px : 16px;
            width: mb.preferred-width;
            height: compact ? 32px : 40px;
            border-radius: compact ? 10px : 13px;
            mb := HorizontalLayout { padding: compact ? 2px : 3px;
                menu-btn := SegButton { id: "menuBtn"; label: "Menu"; icon: PagePaths.menu; on: Office.menu; gold: false; small: compact; clicked => { Office.toggle-menu(); } } }
        }
        // The menu button's name, under it while the pointer is on it.
        if menu-btn.hovered && !Office.menu: Rectangle {
            x: parent.width - self.width - (compact ? 10px : 16px);
            y: (compact ? 10px : 16px) + (compact ? 32px : 40px) + 6px;
            width: mtip.preferred-width + 16px;
            height: mtip.preferred-height + 8px;
            border-radius: 7px;
            background: #0a060ee6;
            border-width: 1px;
            border-color: #ffffff1a;
            mtip := Text { text: "Menu"; font-size: 11.5px; font-weight: 500; color: #f6f2ff; }
        }
        if Office.menu: TouchArea { clicked => { Office.toggle-menu(); } }
        // #hudMenu: time of day as three icons, Chill beats (with "On"), history, Settings.
        if Office.menu: Glass {
            x: parent.width - self.width - (compact ? 10px : 16px);
            y: compact ? 48px : 64px;
            width: 184px;
            height: hm.preferred-height;
            accessible-role: list;
            accessible-id: "hudMenu";
            accessible-label: "Menu";
            hm := VerticalLayout {
                padding: 5px;
                Rectangle {
                    height: 30px;
                    border-radius: 9px;
                    background: #ffffff0d;
                    HorizontalLayout { padding: 2px; spacing: 2px;
                        for m[i] in [{ id: "timeAuto", label: "Follow the clock", icon: PagePaths.auto }, { id: "timeNight", label: "Night", icon: PagePaths.night }, { id: "timeDay", label: "Day", icon: PagePaths.sun }]: Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 7px;
                            background: Office.time-mode == i ? #ffffff24 : transparent;
                            accessible-role: button;
                            accessible-id: m.id;
                            accessible-label: m.label;
                            accessible-checkable: true;
                            accessible-checked: Office.time-mode == i;
                            accessible-action-default => { Office.set-time(i); }
                            Icon { name: m.icon; size: 15px; tint: Office.time-mode == i || tt.has-hover ? #ffffff : #f6f2ff9e; }
                            tt := TouchArea { mouse-cursor: pointer; clicked => { Office.set-time(i); } }
                        }
                    }
                }
                Rectangle { height: 4px; }
                for m[i] in [{ id: "beats", label: "Chill beats", icon: PagePaths.notes }, { id: "histBtn", label: "Session history", icon: PagePaths.history }, { id: "setBtn", label: "Settings", icon: Icons.settings }]: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: ma.has-hover ? #ffffff17 : transparent;
                    accessible-role: button;
                    accessible-id: m.id;
                    accessible-label: m.label;
                    accessible-checkable: i == 0;
                    accessible-checked: i == 0 && Office.beats;
                    accessible-action-default => { if (i == 0) { Office.toggle-beats(); } else if (i == 1) { Office.toggle-menu(); Office.open-history(); } else { Office.toggle-menu(); Office.open-settings(); } }
                    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 9px;
                        VerticalLayout { alignment: center; Icon { name: m.icon; size: 15px; tint: i == 0 && Office.beats ? #ffd27a : #f6f2ff9e; } }
                        Text { text: m.label; font-size: 12.5px; font-weight: 500; color: #f6f2ff; vertical-alignment: center; horizontal-stretch: 1; }
                        if i == 0 && Office.beats: Text { text: "On"; font-size: 11px; font-weight: 600; color: #ffd27a; vertical-alignment: center; }
                    }
                    ma := TouchArea { mouse-cursor: pointer; clicked => { if (i == 0) { Office.toggle-beats(); } else if (i == 1) { Office.toggle-menu(); Office.open-history(); } else { Office.toggle-menu(); Office.open-settings(); } } }
                }
            }
        }

        // The new-task circle, the tools' logos, the box.
        Rectangle {
            x: compact ? 10px : 14px;
            y: parent.height - 34px - (compact ? 10px : 14px);
            width: 34px;
            height: 34px;
            if Office.fab != 2: Glass {
                border-radius: 17px;
                edge: false;
                accessible-role: button;
                accessible-id: "fabMain";
                accessible-label: Office.fab == 1 ? "Close" : "New task";
                accessible-action-default => { Office.fab-main(); }
                Icon { name: Office.fab == 1 ? Icons.close : PagePaths.plus; size: 14px; tint: #f6f2ff; }
                if Office.new-draft != "" && Office.fab == 0: Rectangle { x: 24px; y: 1px; width: 8px; height: 8px; border-radius: 4px; background: #c4a2ff; border-width: 2px; border-color: #140f1a; }
                TouchArea { mouse-cursor: pointer; clicked => { Office.fab-main(); } }
            }
            for t[i] in Office.tools: Logo {
                visible: Office.fab == 1;
                x: 2px + 40px + i * 36px;
                y: 2px;
                width: 30px;
                height: 30px;
                mark: 16px;
                tool: t.id;
                ready: t.ready;
                accessible-role: button;
                accessible-label: t.ready ? t.name : t.name + ": " + t.hint;
                accessible-action-default => { Office.pick-tool(i); }
                TouchArea { mouse-cursor: pointer; clicked => { Office.pick-tool(i); } }
            }
        }
        if Office.fab == 2: Glass {
            x: compact ? 10px : 14px;
            y: parent.height - self.height - (compact ? 10px : 14px);
            width: min(410px, parent.width - 52px);
            height: nt.preferred-height;
            border-radius: 20px;
            accessible-role: groupbox;
            accessible-id: "newtask";
            accessible-label: "New task";
            nt := VerticalLayout {
                padding-left: 9px;
                padding-top: 9px;
                padding-right: 8px;
                padding-bottom: 8px;
                // .ntop: the tool's logo (a click changes it), the task, fold.
                HorizontalLayout {
                    spacing: 9px;
                    VerticalLayout { alignment: start;
                        Logo { width: 30px; height: 30px; mark: 17px; tool: Office.tools[Office.new-tool].id;
                            accessible-role: button; accessible-id: "nWho"; accessible-label: Office.tools[Office.new-tool].name + ". Change agent";
                            TouchArea { mouse-cursor: pointer; clicked => { Office.fab-main(); } } } }
                    // The task grows with what is written, up to a cap, then scrolls inside
                    // (the wheel, or the caret kept in view) so a long prompt is all reachable.
                    Rectangle {
                        height: max(compact ? 40px : 44px, min(compact ? 100px : 140px, ntext.preferred-height + 4px));
                        nfl := Flickable {
                            y: 4px;
                            height: parent.height - 4px;
                            interactive: false;
                            content-height: max(self.height, ntext.preferred-height);
                            ntext := TextInput {
                                width: parent.width;
                                text <=> Office.new-draft;
                                font-size: compact ? 12.5px : 13.5px;
                                color: #f6f2ff;
                                wrap: word-wrap;
                                single-line: false;
                                accessible-role: text-input;
                                accessible-id: "nInput";
                                accessible-label: "Task";
                                edited => { Office.new-draft-edited(); }
                                cursor-position-changed(c) => { nfl.content-y = Caret.follow(nfl.content-y, nfl.height, c.y, self.font-size); }
                                key-pressed(e) => {
                                    if (e.text == "\n" && !e.modifiers.shift) { Office.new-go-clicked(); return accept; }
                                    if (e.modifiers.control && (e.text == "v" || e.text == "V") && Office.paste-image(2)) { return accept; }
                                    reject
                                }
                                init => { self.focus(); }
                            }
                        }
                        InputThumb { x: parent.width + 2px; y: nfl.y; height: nfl.height; f-height: nfl.height; f-content: nfl.content-height; f-y: nfl.content-y; }
                        if Office.new-draft == "": Text { y: 4px; text: "What should " + Office.tools[Office.new-tool].name + " do? Paste an image to show it.";
                            font-size: compact ? 12.5px : 13.5px; color: #f6f2ff61; wrap: word-wrap; vertical-alignment: top; }
                    }
                    VerticalLayout { alignment: start;
                        XButton { id: "nFold"; label: "Fold"; icon: Icons.chevron-down; small: compact; clicked => { Office.new-fold(); } } }
                }
                if Office.n-shots.length > 0: Shots { shots: Office.n-shots; which: 2; padding-top: 6px; }
                Rectangle { height: 4px; }
                // .cbar: +, the folder, the access, then the model and Start.
                HorizontalLayout {
                    spacing: 4px;
                    ClipButton { id: "nAttach"; clicked => { Office.attach(2); } }
                    // Kiro Web on or off; blue while on.
                    nc := Rectangle { width: Office.new-cloud-shown ? 28px : 0px; height: 28px; border-radius: 9px; visible: Office.new-cloud-shown;
                        background: Office.new-cloud ? #6ba8ff24 : ca.has-hover ? #ffffff12 : transparent;
                        accessible-role: checkbox; accessible-id: "nCloud"; accessible-label: "Run in Kiro Web"; accessible-checkable: true; accessible-checked: Office.new-cloud;
                        accessible-action-default => { Office.toggle-cloud(); }
                        Icon { name: Icons.cloud; size: 15px; tint: Office.new-cloud ? #8fbcff : #f6f2ff9e; }
                        ca := TouchArea { mouse-cursor: pointer; clicked => { Office.toggle-cloud(); } } }
                    // The folder, or in Kiro Web the repo it clones.
                    nf := Rectangle { width: min(fl.preferred-width, (parent.width - 60px) * 0.4); height: 28px; border-radius: 9px; background: fo.has-hover || Office.repo-menu ? #ffffff12 : transparent;
                        accessible-role: button; accessible-id: "nFolder"; accessible-label: Office.new-cloud ? "Repository: " + Office.new-repo + ". Change" : Office.new-folder;
                        fl := HorizontalLayout { padding-left: 9px; padding-right: 9px; spacing: 6px;
                            VerticalLayout { alignment: center; Icon { name: Office.new-cloud ? Icons.globe : Icons.folder; size: 14px;
                                tint: Office.new-cloud ? #8fbcff : Office.new-folder == "Choose a folder" ? #ffb36b : #f6f2ff9e; } }
                            Text { text: Office.new-cloud ? Office.new-repo : Office.new-folder; font-family: "DejaVu Sans Mono"; font-size: 11.5px;
                                color: Office.new-cloud ? #8fbcff : Office.new-folder == "Choose a folder" ? #ffb36b : #f6f2ff9e; vertical-alignment: center; overflow: elide; } }
                        fo := TouchArea { mouse-cursor: pointer; clicked => { if (Office.new-cloud) { Office.open-repos(); } else { Office.new-folder-clicked(); } } } }
                    // .fchip.acc: what the task may do on its own, amber for Trust all. Not in
                    // Kiro Web: every task there is full access, so there is nothing to pick.
                    na := Rectangle { width: Office.new-cloud ? 0px : al.preferred-width; visible: !Office.new-cloud; height: 28px; border-radius: 9px; background: aa.has-hover || Office.access-menu ? #ffffff12 : transparent;
                        accessible-role: button; accessible-id: "nAccess"; accessible-label: "Tool access: " + Office.new-access + ". Change";
                        al := HorizontalLayout { padding-left: 9px; padding-right: 9px; spacing: 6px;
                            VerticalLayout { alignment: center; Icon { name: PagePaths.shield; size: 14px; tint: Office.new-access-full ? #ffc46b : #f6f2ff9e; } }
                            Text { text: Office.new-access; font-size: 11.5px; font-weight: 500; color: Office.new-access-full ? #ffc46b : #f6f2ff9e; vertical-alignment: center; } }
                        aa := TouchArea { mouse-cursor: pointer; clicked => { Office.open-access(); } } }
                    Rectangle { horizontal-stretch: 1; }
                    if Office.n-model-shown: MPill { id: "nModel"; model: Office.n-model; effort: Office.n-model-effort; open: Office.model-menu == 2;
                        // What the row has left once +, the folder, the access and Start (and the
                        // five gaps) are in: a long model name elides instead of pushing Start out.
                        max-w: min(parent.width * 0.62, parent.width - nc.width - nf.width - na.width - 30px - 30px - 6 * 4px);
                        clicked(x, y) => { Office.open-model(Office.model-menu == 2 ? 0 : 2, x, y); } }
                    GoButton { id: "nGo"; label: "Start"; enabled: Office.new-go; clicked => { Office.new-go-clicked(); } }
                }
                // Said only when something stops the task from starting.
                if Office.new-note != "": Text { x: 6px; width: parent.width - 12px; text: Office.new-note; font-size: 11px; color: #f6f2ff61; wrap: word-wrap;
                    height: self.preferred-height + 4px; vertical-alignment: bottom; }
            }
        }

        // #mMenu for the access chip: each choice with its note, then where it holds.
        if Office.access-menu: TouchArea { clicked => { Office.open-access(); } }
        if Office.access-menu: Glass {
            x: 22px;
            y: parent.height - self.height - 60px;
            width: 250px;
            height: am.preferred-height;
            border-radius: 14px;
            accessible-role: list;
            accessible-id: "accessMenu";
            am := VerticalLayout {
                padding: 6px;
                Text { text: Office.access-head; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px; letter-spacing: 0.63px; color: #f6f2ff61;
                    height: self.preferred-height + 10px; vertical-alignment: center; x: 8px; }
                for o in Office.access-opts: Rectangle {
                    height: ol.preferred-height;
                    border-radius: 8px;
                    background: oa.has-hover ? #ffffff17 : transparent;
                    accessible-role: list-item;
                    accessible-label: o.label;
                    accessible-checkable: true;
                    accessible-checked: o.on;
                    accessible-action-default => { Office.pick-access(o.id); }
                    ol := HorizontalLayout { padding: 7px; padding-left: 8px; padding-right: 8px; spacing: 8px;
                        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                            Text { text: o.label; font-size: 12.5px; font-weight: 600; color: #f6f2ff; }
                            Text { text: o.note; font-size: 11px; color: #f6f2ff61; wrap: word-wrap; } }
                        if o.on: VerticalLayout { alignment: start; padding-top: 3px; Icon { name: Icons.check; size: 12px; tint: #c4a2ff; } } }
                    oa := TouchArea { mouse-cursor: pointer; clicked => { Office.pick-access(o.id); } }
                }
                Text { text: "For this task only. Settings keeps the default."; font-size: 11px; color: #f6f2ff61; x: 8px; height: self.preferred-height + 8px; vertical-alignment: center; }
            }
        }

        // The repos a Kiro Web task can clone: none first, then the connected ones.
        if Office.repo-menu: TouchArea { clicked => { Office.open-repos(); } }
        if Office.repo-menu: Glass {
            x: 22px;
            y: parent.height - self.height - 60px;
            width: 270px;
            height: min(rm.preferred-height, parent.height - 120px);
            border-radius: 14px;
            accessible-role: list;
            accessible-id: "repoMenu";
            rm := VerticalLayout {
                padding: 6px;
                Text { text: "KIRO WEB CLONES"; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px; letter-spacing: 0.63px; color: #f6f2ff61;
                    height: self.preferred-height + 10px; vertical-alignment: center; x: 8px; }
                // Search: typing keeps the repositories that match; Enter picks the first; Esc closes.
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: #ffffff0f;
                    border-width: 1px;
                    border-color: rs.has-focus ? #c4a2ff8c : #ffffff14;
                    rs := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 12.5px;
                        color: #f6f2ff;
                        selection-background-color: #c4a2ff66;
                        accessible-role: text-input;
                        accessible-id: "repoSearch";
                        accessible-label: "Search repositories";
                        edited => { Office.repo-search(self.text); }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) { Office.open-repos(); return accept; }
                            if (e.text == "\n" && self.preedit-text == "") { Office.repo-search-enter(); return accept; }
                            reject
                        }
                        init => { self.focus(); }
                    }
                    if rs.text == "": Text { x: 10px; text: "Search repositories"; font-size: 12.5px; color: #f6f2ff61; vertical-alignment: center; }
                }
                Rectangle { height: 4px; }
                Flickable {
                    height: min(rl.preferred-height, 260px);
                    content-height: rl.preferred-height;
                    rl := VerticalLayout {
                        for o in Office.repo-opts: Rectangle {
                            height: ro.preferred-height;
                            border-radius: 8px;
                            background: rt.has-hover ? #ffffff17 : transparent;
                            accessible-role: list-item;
                            accessible-label: o.label;
                            accessible-checkable: true;
                            accessible-checked: o.on;
                            accessible-action-default => { Office.pick-repo(o.id); }
                            ro := HorizontalLayout { padding: 7px; padding-left: 8px; padding-right: 8px; spacing: 8px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                    Text { text: o.label; font-size: 12.5px; font-weight: 600; color: #f6f2ff; overflow: elide; }
                                    if o.note != "": Text { text: o.note; font-size: 11px; color: #f6f2ff61; wrap: word-wrap; } }
                                if o.on: VerticalLayout { alignment: start; padding-top: 3px; Icon { name: Icons.check; size: 12px; tint: #c4a2ff; } } }
                            rt := TouchArea { mouse-cursor: pointer; clicked => { Office.pick-repo(o.id); } }
                        }
                    }
                }
                if Office.repo-note != "": Text { text: Office.repo-note; font-size: 11px; color: #f6f2ff61; wrap: word-wrap; x: 8px; width: parent.width - 16px;
                    height: self.preferred-height + 8px; vertical-alignment: center; }
            }
        }

        // A side panel: the board, the overview, the history.
        if Office.panel != 0: Graphite {
            x: parent.width - self.width - side-gap;
            y: side-gap;
            width: side-w;
            height: parent.height - 2 * side-gap;
            border-radius: compact ? 16px : 20px;
            accessible-role: groupbox;
            accessible-id: "panel";
            accessible-label: Office.panel-title;
            VerticalLayout {
                // Only the list takes the spare height.
                HorizontalLayout {
                    vertical-stretch: 0;
                    padding-left: 14px;
                    padding-right: 10px;
                    padding-top: 12px;
                    padding-bottom: 11px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        // Elide: a long note ("Up to 3 tasks run at once, across…") set the
                        // row's smallest width, which pushed Close off the panel's edge.
                        Text { text: Office.panel-title; font-size: 14px; font-weight: 600; letter-spacing: -0.14px; color: #f6f2ff; overflow: elide; }
                        Text { text: Office.panel-sub; font-size: 11.5px; color: #f6f2ff61; overflow: elide; }
                    }
                    VerticalLayout { alignment: center; XButton { id: "pClose"; label: "Close"; icon: Icons.close; small: compact; clicked => { Office.panel-close(); } } }
                }
                Rectangle { height: 1px; background: #ffffff0f; }
                if Office.panel == 3: HorizontalLayout {
                    vertical-stretch: 0;
                    padding-left: 12px; padding-right: 12px; padding-top: 12px;
                    // .hfind: a search box with its magnifier.
                    Rectangle { height: 34px; border-radius: 10px; border-width: 1px; border-color: find.has-focus ? #ffffff38 : #ffffff12; background: #1b181e;
                        Icon { x: 10px; name: PagePaths.search; size: 14px; tint: #f6f2ff61; }
                        find := TextInput { x: 32px; width: parent.width - 42px; text <=> Office.find; font-size: 12.5px; color: #f6f2ff; vertical-alignment: center;
                            accessible-role: text-input; accessible-id: "hFind"; accessible-label: "Find a session"; edited => { Office.find-edited(self.text); } }
                        if Office.find == "": Text { x: 32px; text: "Find a session"; font-size: 12.5px; color: #f6f2ff61; vertical-alignment: center; } }
                }
                // A Flickable is no taller than its content, so a short list would leave
                // the spare height to the header; the box around it takes it.
                Rectangle {
                    vertical-stretch: 1;
                    Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            padding: 12px;
                            padding-top: 14px;
                            for r[i] in Office.rows: RowView { r: r; list-w: side-w - 24px; clicked => { Office.row-clicked(i); } delete => { Office.row-delete(i); } }
                        }
                    }
                }
            }
        }

        // The chat drawer.
        if Office.drawer: Graphite {
            x: parent.width - self.width - side-gap;
            y: side-gap;
            width: side-w;
            height: parent.height - 2 * side-gap;
            border-radius: compact ? 16px : 20px;
            accessible-role: groupbox;
            accessible-id: "drawer";
            accessible-label: Office.d-name + ": " + Office.d-title;
            // Only to know the pointer is over the chat (an ancestor's has-hover holds over its children).
            dh := TouchArea {
            init => { Office.d-hover = false; }
            changed has-hover => { Office.d-hover = self.has-hover; }
            VerticalLayout {
                // .dh: the tool's logo, the task, and its folder, access and context; delete, close.
                HorizontalLayout {
                    padding-left: compact ? 10px : 12px;
                    padding-right: compact ? 8px : 10px;
                    padding-top: compact ? 8px : 12px;
                    padding-bottom: compact ? 8px : 11px;
                    spacing: compact ? 9px : 11px;
                    VerticalLayout { alignment: center; Logo { width: compact ? 26px : 30px; height: self.width; radius: compact ? 8px : 9px;
                        mark: compact ? 15px : Office.d-tool-id == "codex" ? 22px : 18px; tool: Office.d-tool-id;
                        accessible-role: image; accessible-label: Office.d-tool; } }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: Office.d-title; font-size: compact ? 13px : 14px; font-weight: 600; letter-spacing: -0.14px; color: #f6f2ff; overflow: elide; accessible-role: text; accessible-id: "dTitle"; }
                        Rectangle { height: compact ? 3px : 5px; }
                        HorizontalLayout { spacing: 5px; alignment: start;
                            if Office.d-folder != "": Chip { icon: PagePaths.folder; text: Office.d-folder; shrink: true; }
                            if Office.d-access != "": Chip { icon: PagePaths.shield; text: Office.d-access; tip: Office.d-access-note;
                                fg: Office.d-access-id == "full" ? #ffc46b : #ffffff99; bg: Office.d-access-id == "full" ? #ffb34017 : #ffffff0e; }
                            if Office.d-ctx >= 0: Rectangle { height: 20px; width: cx.preferred-width; border-radius: 6px; background: #ffffff0e;
                                accessible-role: text; accessible-label: Office.d-ctx + "% of the context window used";
                                cx := HorizontalLayout { padding-left: 7px; padding-right: 7px; spacing: 5px;
                                    VerticalLayout { alignment: center; Rectangle { width: 11px; height: 11px; border-radius: 5.5px; border-width: 2px; border-color: #ffffff24;
                                        Path { width: 11px; height: 11px; viewbox-width: 11; viewbox-height: 11; stroke: #ffffffbf; stroke-width: 2px; fill: transparent;
                                            commands: "M 5.5 1.5 A 4 4 0 " + (Office.d-ctx > 50 ? "1" : "0") + " 1 " + (5.5 + 4 * sin(360deg * min(Office.d-ctx, 99.9) / 100)) + " " + (5.5 - 4 * cos(360deg * min(Office.d-ctx, 99.9) / 100)); } } }
                                    Text { text: Office.d-ctx + "%"; font-size: 11px; font-weight: 500; color: #ffffff99; vertical-alignment: center; } } }
                            // Kiro Web: opens this session there; says so while hovered.
                            if Office.d-cloud: Rectangle { height: 20px; width: 26px; border-radius: 6px; background: cw.has-hover ? #6ba8ff33 : #6ba8ff1c;
                                accessible-role: button; accessible-id: "dCloud"; accessible-label: "Open cloud session";
                                accessible-action-default => { Office.d-open-cloud(); }
                                Icon { name: Icons.cloud; size: 13px; tint: #8fbcff; }
                                cw := TouchArea { mouse-cursor: pointer; clicked => { Office.d-open-cloud(); } }
                                if cw.has-hover: Rectangle { x: parent.width + 6px; y: 0; height: 20px; width: ct.preferred-width + 14px; border-radius: 6px; background: #1c1a24f2;
                                    border-width: 1px; border-color: #ffffff1a;
                                    ct := Text { text: "Open cloud session"; font-size: 11px; font-weight: 500; color: #f6f2ffde; vertical-alignment: center; } } }
                        }
                    }
                    VerticalLayout { alignment: center; XButton { id: "dDel"; label: "Delete this session"; icon: PagePaths.bin; small: compact; clicked => { Office.d-delete(); } } }
                    VerticalLayout { alignment: center; XButton { id: "dClose"; label: "Close"; icon: Icons.close; small: compact; clicked => { Office.d-close(); } } }
                }
                Rectangle { height: 1px; background: #ffffff0f; }
                thread := Rectangle {
                    vertical-stretch: 1;
                    init => { Office.d-thread-w = self.width; Office.d-thread-h = self.height; }
                    changed width => { Office.d-thread-w = self.width; }
                    changed height => { Office.d-thread-h = self.height; Office.d-resized(); }
                    Image { width: 100%; height: 100%; source: Office.d-thread; image-fit: fill; }
                    TouchArea {
                        scroll-event(e) => { Office.d-wheel(e.delta-y); accept }
                        clicked => { Office.d-click(self.mouse-x, self.mouse-y); }
                        pointer-event(e) => {
                            // A press in the thread takes the keys from the reply box, as a click on
                            // the page's text blurred its textarea: Ctrl+C then copies the selection.
                            // An empty reply box closes; one with words in it stays.
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                if (Office.d-compose && Office.d-draft == "" && Office.d-shots.length == 0) { Office.d-compose = false; }
                                focus.focus();
                                Office.d-pointer(0, self.mouse-x, self.mouse-y, e.modifiers.shift);
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Office.d-pointer(2, self.mouse-x, self.mouse-y, false); }
                        }
                        moved => { if (self.pressed) { Office.d-pointer(1, self.mouse-x, self.mouse-y, false); } }
                    }
                    // .jump: "Latest", over the thread's end, once the reader is well above it.
                    if Office.d-jump: Glass {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - (Office.d-compose ? 12px : 56px);
                        width: jl.preferred-width;
                        height: 24px;
                        border-radius: 12px;
                        accessible-role: button;
                        accessible-id: "jump";
                        accessible-label: "Jump to the latest";
                        accessible-action-default => { Office.d-latest(); }
                        jl := HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 5px;
                            VerticalLayout { alignment: center; Icon { name: PagePaths.down; size: 12px; tint: #f6f2ff; } }
                            Text { text: "Latest"; font-size: 11px; color: #f6f2ff; vertical-alignment: center; } }
                        TouchArea { mouse-cursor: pointer; clicked => { Office.d-latest(); } }
                    }
                    // The reply dock at rest (.rb): a faint glass circle at the thread's
                    // bottom right, which grows to say "Reply to Juno" (and the start of a
                    // draft) under the pointer; a dot while a draft waits. A click, or a
                    // character typed while the chat has the keyboard, opens the box.
                    if !Office.d-compose: Rectangle {
                        property <bool> draft: Office.d-draft != "" || Office.d-shots.length > 0;
                        property <bool> wide: rta.has-hover;
                        x: parent.width - self.width - 10px;
                        y: parent.height - self.height - 10px;
                        width: pill.width;
                        height: 34px;
                        accessible-role: button;
                        accessible-id: "replyBtn";
                        accessible-label: draft ? Office.d-reply-label + ". You have a draft" : Office.d-reply-label;
                        accessible-action-default => { Office.d-compose = true; }
                        pill := Rectangle {
                            x: 0;
                            width: wide ? min(260px, rbl.preferred-width + 13px + 8px + 16px + 9px) : 34px;
                            animate width { duration: Pal.motion ? 400ms : 0ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
                            height: 34px;
                            border-radius: 17px;
                            clip: true;
                            background: wide ? #2822309e : #1c182252;
                            opacity: wide || draft ? 1 : 0.72;
                            border-width: 1px;
                            border-color: #ffffff1a;
                            drop-shadow-blur: 18px;
                            drop-shadow-offset-y: 6px;
                            drop-shadow-color: #0000004d;
                            rbl := HorizontalLayout {
                                x: 13px;
                                height: parent.height;
                                spacing: 6px;
                                opacity: wide ? 1 : 0;
                                animate opacity { duration: Pal.motion ? 180ms : 0ms; }
                                if Office.d-draft != "": Text { text: Office.d-draft; font-size: 11px; color: #f6f2ff61; vertical-alignment: center; overflow: elide; max-width: 130px; }
                                Text { text: Office.d-reply-label; font-size: 12px; font-weight: 500; color: #f6f2ff; vertical-alignment: center; }
                            }
                            Icon { x: parent.width - 9px - 16px; y: 9px; name: PagePaths.chat; size: 16px; tint: #f6f2ff; }
                        }
                        if draft: Rectangle { x: parent.width - 9px; y: -1px; width: 10px; height: 10px; border-radius: 5px; background: #c4a2ff; border-width: 2px; border-color: #140f1a; }
                        rta := TouchArea { mouse-cursor: pointer; clicked => { Office.d-compose = true; } }
                    }
                }
                // The question at the end of the chat (askHTML(s, 'chat')): kept in view
                // over the composer while the agent waits.
                if Office.d-asking: HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 4px; padding-bottom: Office.d-compose ? 0 : 8px;
                    AskCard { w: parent.width - 28px; a: Office.d-ask; tool: Office.d-tool-id; over: false; answer(how) => { Office.answer(-1, Office.d-ask.id, how); }
                        pick(qi, l) => { Office.q-pick(-1, Office.d-ask.id, qi, l); } typed(qi, v) => { Office.q-text(-1, Office.d-ask.id, qi, v); }
                        send => { Office.q-send(-1, Office.d-ask.id); } } }
                // .comp: the reply box, grown out of the circle. The text, then a bar with +,
                // the model, Hide (Esc: the draft stays), and one round button that sends,
                // queues a reply while a run goes, or pauses the run when the box is empty.
                if Office.d-compose: Rectangle {
                    height: comp.preferred-height + 16px;
                    Rectangle {
                        x: 10px;
                        y: 6px;
                        width: parent.width - 20px;
                        height: comp.preferred-height;
                        border-radius: 17px;
                        background: #1b181ff0;
                        border-width: 1px;
                        border-color: input.has-focus ? #c4a2ff8c : #ffffff1a;
                        drop-shadow-blur: 30px;
                        drop-shadow-offset-y: -8px;
                        drop-shadow-color: #00000088;
                        cta := TouchArea { clicked => { input.focus(); } }
                        comp := VerticalLayout {
                            padding-left: 10px;
                            padding-right: 7px;
                            padding-top: 7px;
                            padding-bottom: 6px;
                            if Office.d-shots.length > 0: Shots { shots: Office.d-shots; which: 1; padding: 3px; padding-bottom: 6px; }
                            // Past 140 px the reply scrolls inside, the caret kept in view.
                            Rectangle {
                                height: max(24px, min(140px, input.preferred-height + 6px));
                                dfl := Flickable {
                                    x: 2px;
                                    y: 3px;
                                    width: parent.width - 4px;
                                    height: parent.height - 3px;
                                    interactive: false;
                                    content-height: max(self.height, input.preferred-height + 3px);
                                    input := TextInput {
                                        width: parent.width;
                                        text <=> Office.d-draft;
                                        // Words put in from outside (dictation): the caret goes after them, in view.
                                        property <int> to-end: Office.d-draft-to-end;
                                        changed to-end => { self.set-selection-offsets(2147483647, 2147483647); }
                                        cursor-position-changed(c) => { dfl.content-y = Caret.follow(dfl.content-y, dfl.height, c.y, self.font-size); }
                                        font-size: 13px;
                                        color: #f6f2ff;
                                        wrap: word-wrap;
                                        single-line: false;
                                        accessible-role: text-input;
                                        accessible-id: "input";
                                        accessible-label: Office.d-reply-label;
                                        // Opened by a click or a typed character: the keys go here, after what is written.
                                        init => { self.focus(); self.set-selection-offsets(2147483647, 2147483647); }
                                        key-pressed(e) => {
                                            // Enter sends (not while an IME is composing: its Enter takes the word);
                                            // Shift+Enter is a new line.
                                            if (e.text == "\n" && !e.modifiers.shift && self.preedit-text == "") { Office.d-send(); return accept; }
                                            if (e.modifiers.control && (e.text == "v" || e.text == "V") && Office.paste-image(1)) { return accept; }
                                            // Nothing selected in the box: Ctrl+C copies what is selected in the thread.
                                            if (e.modifiers.control && (e.text == "c" || e.text == "C") && self.anchor-position-byte-offset == self.cursor-position-byte-offset && Office.d-copy()) { return accept; }
                                            reject
                                        }
                                    }
                                }
                                InputThumb { x: parent.width + 1px; y: dfl.y; height: dfl.height; f-height: dfl.height; f-content: dfl.content-height; f-y: dfl.content-y; }
                                if Office.d-draft == "" && input.preedit-text == "": Text { x: 2px; y: 3px; text: Office.d-placeholder; font-size: 13px; color: #f6f2ff61; overflow: elide; width: parent.width - 4px; }
                            }
                            Rectangle { height: 3px; }
                            HorizontalLayout {
                                spacing: 4px;
                                ClipButton { id: "attach"; clicked => { Office.attach(1); } }
                                if Office.d-model-shown: MPill { id: "dModel"; model: Office.d-model; effort: Office.d-model-effort; open: Office.model-menu == 1; max-w: parent.width * 0.62;
                                    clicked(x, y) => { Office.open-model(Office.model-menu == 1 ? 0 : 1, x, y); } }
                                Rectangle { horizontal-stretch: 1; }
                                // Not confirmed yet: the tool hasn't said the run stopped.
                                if Office.d-voice != "": Text { text: Office.d-voice; font-size: 11.5px; color: #ff8fa3; vertical-alignment: center; overflow: elide; accessible-role: text; accessible-id: "dVoice"; }
                                if Office.d-stopping: Text { text: "Stopping…"; font-size: 11.5px; color: #ffc46b; vertical-alignment: center; accessible-role: text; }
                                Rectangle { width: 26px; height: 28px;
                                    accessible-role: button; accessible-id: "hideBtn"; accessible-label: "Hide. Keeps your draft";
                                    accessible-action-default => { Office.d-compose = false; focus.focus(); }
                                    Rectangle { y: 1px; width: 26px; height: 26px; border-radius: 9px; background: hta.has-hover ? #ffffff12 : transparent;
                                        Icon { name: Icons.chevron-down; size: 15px; tint: hta.has-hover ? #f6f2ff : #f6f2ff9e; } }
                                    hta := TouchArea { mouse-cursor: pointer; clicked => { Office.d-compose = false; focus.focus(); } } }
                                VerticalLayout { alignment: center;
                                    GoButton { id: "send"; round: true;
                                        property <bool> empty: Office.d-draft == "" && Office.d-shots.length == 0;
                                        enabled: !self.empty || (Office.d-busy && !Office.d-stopping);
                                        pause: self.empty && Office.d-busy;
                                        label: Office.d-stopping && self.empty ? "Stopping…" : self.empty && Office.d-busy ? "Pause this run" : Office.d-busy ? "Queue this reply" : "Send";
                                        clicked => { Office.d-send(); } } }
                            }
                        }
                    }
                }
            }
            }
        }

        // The desk's panel: wider than the others, its surfaces as tabs along the top.
        if Desk.panel: Graphite {
            x: parent.width - self.width - side-gap;
            y: side-gap;
            width: desk-w;
            height: parent.height - 2 * side-gap;
            border-radius: compact ? 16px : 20px;
            accessible-role: groupbox;
            accessible-id: "deskPanel";
            accessible-label: Desk.p-title;
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 0;
                    padding-left: 14px;
                    padding-right: 10px;
                    padding-top: 12px;
                    padding-bottom: 11px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: Desk.p-title; font-size: 14px; font-weight: 600; letter-spacing: -0.14px; color: #f6f2ff; overflow: elide; accessible-role: text; accessible-id: "pTitle"; }
                        Text { text: Desk.p-sub; font-size: 11.5px; color: #f6f2ff61; overflow: elide; }
                    }
                    VerticalLayout { alignment: center; XButton { id: "deskClose"; label: "Close"; icon: Icons.close; small: compact; clicked => { Desk.panel-close(); } } }
                }
                Rectangle { height: 1px; background: #ffffff0f; }
                DeskBody { vertical-stretch: 1; }
            }
        }

        // The desk's card, where the desk was clicked; a click elsewhere puts it away.
        if Desk.card: TouchArea { clicked => { Desk.card-close(); } }
        if Desk.card: DeskCard {
            max-w: parent.width - 16px;
            max-h: parent.height - 16px;
            x: max(8px, min(Desk.card-x + 6px, parent.width - self.width - 8px));
            y: max(8px, min(Desk.card-y - 12px, parent.height - self.height - 8px));
        }
        // #mMenu for a model pill: the tool's models, then its efforts (or the model's own
        // variants), then from when the pick holds. Above the pill, kept in the office.
        if Office.model-menu != 0: TouchArea { clicked => { Office.open-model(0, 0, 0); } }
        if Office.model-menu != 0: Glass {
            x: max(8px, min(Office.model-x - root.absolute-position.x, parent.width - 258px));
            y: max(8px, Office.model-y - root.absolute-position.y - self.height - 6px);
            width: 250px;
            height: min(mmc.preferred-height, parent.height - 20px);
            border-radius: 14px;
            accessible-role: list;
            accessible-id: "mMenu";
            mmc := VerticalLayout {
                width: 250px;
                padding: 6px;
                Text { text: Office.mm-head; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px; letter-spacing: 0.63px; color: #f6f2ff61;
                    height: self.preferred-height + 10px; vertical-alignment: center; x: 8px; }
                // The models scroll inside a box of their own, with a bar, so a long list (Codex's
                // can be) is reachable and the efforts below it always stay in view. The box
                // opens on the picked model.
                Rectangle {
                    height: min(mml.preferred-height, max(84px, root.height - 20px - 170px));
                    mmf := Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-height: mml.preferred-height;
                        // A binding, so it is the first position only: a scroll by the user replaces it.
                        content-y: -min(max(0px, Office.mm-cur * 28px - (self.height - 28px) / 2), max(0px, self.content-height - self.height));
                        mml := VerticalLayout {
                            width: parent.width;
                            for m in Office.mm-models: MenuRow { o: m; clicked => { Office.pick-model(m.id); } }
                        }
                    }
                    InputThumb { x: parent.width - 4px; y: 0px; height: parent.height; f-height: mmf.height; f-content: mmf.content-height; f-y: mmf.content-y; }
                }
                if Office.mm-efforts.length > 0: Text { text: Office.mm-effort-head; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px; letter-spacing: 0.63px; color: #f6f2ff61;
                    height: self.preferred-height + 10px; vertical-alignment: center; x: 8px; }
                if Office.mm-efforts.length > 0: HorizontalLayout { padding-left: 4px; padding-right: 4px; padding-bottom: 4px; padding-top: 2px; spacing: 3px;
                    for e in Office.mm-efforts: MenuRow { seg: true; o: e; horizontal-stretch: 1; clicked => { Office.pick-effort(e.id); } } }
                HorizontalLayout { padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 3px;
                    Text { text: Office.mm-note; font-size: 11px; color: #f6f2ff61; wrap: word-wrap; } }
            }
        }

        if Office.toast-shown: Glass {
            x: (parent.width - self.width) / 2;
            y: compact ? 10px : 18px;
            width: toast.preferred-width + (compact ? 24px : 28px);
            height: toast.preferred-height + (compact ? 12px : 16px);
            border-radius: 12px;
            toast := Text { text: Office.toast; font-family: "Pixelify Sans"; font-weight: 600; font-size: compact ? 12px : 12.5px; color: #f6f2ff; accessible-role: text; accessible-id: "toast"; }
        }
        if Office.confirm: Rectangle {
            TouchArea {}
            Glass {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(320px, parent.width - 32px);
                height: cf.preferred-height;
                border-radius: 16px;
                accessible-role: groupbox;
                accessible-id: "confirm";
                cf := VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text { text: Office.confirm-title; font-family: "Pixelify Sans"; font-weight: 600; font-size: 14px; color: #f6f2ff; }
                    Text { text: Office.confirm-text; font-size: 12.5px; color: #f6f2ff9e; wrap: word-wrap; }
                    HorizontalLayout { alignment: end; spacing: 8px; padding-top: 8px;
                        PillButton { id: "cfNo"; text: "Cancel"; bg: #ffffff0d; fg: #f6f2ff; font-size: 12.5px; bold-text: true; clicked => { Office.confirm-no(); } }
                        PillButton { id: "cfYes"; text: Office.confirm-ok; bg: #ff453ad9; fg: white; font-size: 12.5px; bold-text: true; clicked => { Office.confirm-yes(); } } }
                }
            }
        }
    }

    // KiroPage.Notice: before the first task, a card in place of the office (in the
    // notch clear of the shape's curves): the bot, what the agents may do, Got it.
    if Office.notice && !in-settings: Rectangle {
        background: Pal.panel;
        TouchArea {}
        Rectangle {
            x: dashboard ? 0 : 10px;
            y: dashboard ? 0 : 10px;
            width: parent.width - 2 * self.x;
            height: parent.height - 2 * self.y;
            border-radius: 22px;
            background: Pal.surface;
            accessible-role: groupbox;
            HorizontalLayout {
                alignment: center;
                padding-left: 24px;
                padding-right: 28px;
                padding-top: 18px;
                padding-bottom: 18px;
                HorizontalLayout {
                    max-width: 720px;
                    spacing: 26px;
                    VerticalLayout { alignment: center; BotGlyph { width: 110px; height: 110px; motion: Pal.motion; } }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: "Before an agent starts"; font-family: Fonts.display; font-size: 19px; font-weight: 600; color: Pal.ink;
                            accessible-role: text; accessible-id: "KiroNotice"; }
                        Rectangle { height: 8px; }
                        Text { text: "Kiro, Codex, Cursor, OpenCode and Claude Code work on their own here, with full access to their tools. They can edit files and run commands in the project folder you choose, without stopping to ask.";
                            font-size: 13.5px; color: Pal.ink; wrap: word-wrap; }
                        Rectangle { height: 6px; }
                        Text { text: "So pick the folder with care, and keep it under version control, so you can look over what changed and undo it if you need to. In Settings each can be made to ask first, in the notch, or (all but Codex) only read. OpenCode's own deny rules always hold.";
                            font-size: 12.5px; color: Pal.ink-dim; wrap: word-wrap; }
                        Rectangle { height: 14px; }
                        HorizontalLayout { alignment: start;
                            PillButton { id: "KiroNoticeOk"; text: "Got it"; bg: Pal.blue; fg: white; bold-text: true; pad-x: 18px; pad-y: 6px; clicked => { Office.notice-ok(); } } }
                    }
                }
            }
        }
    }

    // Settings over the office: a bar (back, and close in the notch), then the page.
    if in-settings: Rectangle {
        background: Pal.panel;
        border-radius: dashboard ? 0 : 32px;
        // The keyboard's place while Settings shows, and again when a section's rows
        // (and the switch or button that had it) are replaced: Esc keeps working.
        skeys := FocusScope {
            focus-on-click: false;
            init => { self.focus(); }
            key-pressed(e) => { if (e.text == Key.Escape) { root.escape(); return accept; } reject }
        }
        property <int> section-now: Page.current;
        changed section-now => { skeys.focus(); }
        VerticalLayout {
            HorizontalLayout {
                padding-left: 10px;
                padding-top: 10px;
                padding-right: 12px;
                padding-bottom: 8px;
                PillButton {
                    id: "BackToOffice";
                    label: "Back to the office";
                    text: "Agent office";
                    icon: Icons.chevron-left;
                    fg: Pal.ink;
                    pad-x: 9px;
                    pad-y: 4px;
                    horizontal-stretch: 0;
                    clicked => { back(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if !dashboard: PillButton {
                    id: "Close";
                    label: "Close";
                    icon: Icons.close;
                    width: 28px;
                    height: 28px;
                    pad-x: 7px;
                    pad-y: 7px;
                    fg: Pal.ink-dim;
                    clicked => { fold(); }
                }
            }
            SettingsPage {
                vertical-stretch: 1;
                sections: Page.sections;
                current: Page.current;
                blocks: Page.blocks;
                recording: Page.recording;
                section(i) => { Page.section(i); }
                toggled(id, v) => { Page.toggled(id, v); }
                pressed(id) => { Page.pressed(id); }
                picked-seg(id, n) => { Page.picked-seg(id, n); }
                open-picker(id, x, y) => { Page.open-picker(id, x, y); }
                tile(id) => { Page.tile(id); }
                record => { Page.record(); }
                chord(e) => { Page.chord(e) }
            }
        }
    }

    if Page.menu-open: TouchArea { clicked => { Page.menu-close(); } }
    if Page.menu-open: Rectangle {
        x: min(Page.menu-x - root.absolute-position.x, root.width - self.width - 8px);
        y: min(Page.menu-y - root.absolute-position.y + 4px, root.height - self.height - 8px);
        width: max(180px, items.preferred-width);
        height: items.preferred-height;
        border-radius: 10px;
        background: Pal.sheet;
        border-width: 1px;
        border-color: Pal.sheet-edge;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000055;
        items := VerticalLayout {
            padding: 5px;
            for o[i] in Page.menu: Rectangle {
                height: 26px;
                border-radius: 6px;
                background: ta.has-hover ? Pal.blue : transparent;
                accessible-role: list-item;
                accessible-label: o.label;
                accessible-checkable: true;
                accessible-checked: o.on;
                accessible-action-default => { Page.menu-pick(Page.menu-id, i); }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 14px;
                    spacing: 6px;
                    Rectangle { width: 14px; if o.on: Icon { name: Icons.check; size: 12px; tint: ta.has-hover ? white : Pal.ink; } }
                    Text { text: o.label; font-size: 13px; color: ta.has-hover ? white : Pal.ink; vertical-alignment: center; }
                }
                ta := TouchArea { clicked => { Page.menu-pick(Page.menu-id, i); } }
            }
        }
    }
}
