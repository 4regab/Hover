// Owl/Bot.cs: the Kiro bot drawn flat (BotGlyph) and the three rising dots (WorkDots),
// from the same numbers. t and since are seconds, stepped by the app's 30 fps clock
// only while one of them is on screen, and left at 0 with animations off.

export component BotGlyph inherits Rectangle {
    in property <bool> live;
    in property <bool> finished;
    in property <float> t;
    in property <float> since: 9;
    in property <bool> motion: true;
    in property <color> body: #9b6bff;
    // Shade(body, 0.55), byte by byte.
    in property <color> dark: #553a8c;
    property <bool> still: !motion || !(live || finished);
    property <float> tt: still ? 0 : t;
    property <float> s: min(self.width, self.height / 0.9) / 1px;
    property <float> k: since / 0.9;
    property <bool> hop: finished && !still && since < 0.9;
    property <float> dy: hop ? -sin(k * 180deg) * s * 0.18 : live ? sin(tt * 5.2 * 1rad) * s * 0.035 : 0;
    property <float> squash: hop && k > 0.8 ? sin((k - 0.8) / 0.2 * 180deg) * 0.08 : 0;
    property <float> x0: (self.width / 1px - s) / 2;
    property <float> top: self.height / 1px - s * 0.78 + dy + s * squash * 0.78;
    property <float> head-h: s * 0.78 * (1 - squash);
    property <float> pulse: live && !still ? 0.5 + 0.5 * sin(tt * 6 * 1rad) : 1;
    property <color> bulb-color: finished ? #4ade80 : #ffd24a;
    // Reading along a line, then down to the keys, then back; a blink now and then.
    property <float> c: mod(tt, 4.2);
    property <bool> working: live && !still;
    property <float> look: !working ? 0 : c < 2.4 ? -0.05 + 0.1 * (c / 2.4) : c < 3.6 ? 0.02 : 0.05 - 0.07 * ((c - 3.6) / 0.6);
    property <float> down: working && c >= 2.4 && c < 3.6 ? 0.05 : 0;
    property <float> blink: working && mod(tt, 3.3) < 0.12 ? 0.15 : 1;
    property <float> vx: x0 + s * 0.18;
    property <float> vy: top + head-h * 0.26;
    property <float> vh: head-h * 0.51;
    background: transparent;

    // The antenna's bulb pulsing in a soft halo.
    if live || finished: Rectangle {
        x: (x0 + s * 0.67 - s * 0.26) * 1px;
        y: (top - s * 0.13 - s * 0.26) * 1px;
        width: s * 0.52 * 1px;
        height: self.width;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, bulb-color.with-alpha((90 + 110 * pulse) / 255) 0%, bulb-color.with-alpha(0) 100%);
    }
    Rectangle { x: (x0 + s * 0.64) * 1px; y: (top - s * 0.1) * 1px; width: s * 0.06 * 1px; height: s * 0.12 * 1px; background: dark; }
    Rectangle {
        x: (x0 + s * 0.6) * 1px; y: (top - s * 0.2) * 1px; width: s * 0.14 * 1px; height: s * 0.14 * 1px;
        border-radius: s * 0.03 * 1px;
        // Mix(bulb, purple, live ? 0.25 * (1 - pulse) : 0).
        background: live ? bulb-color.mix(#9b6bff, 1 - 0.25 * (1 - pulse)) : bulb-color;
    }
    // Headphone pads, head and visor.
    Rectangle { x: x0 * 1px; y: (top + head-h * 0.28) * 1px; width: s * 1px; height: head-h * 0.44 * 1px; border-radius: s * 0.05 * 1px; background: dark; }
    Rectangle { x: (x0 + s * 0.07) * 1px; y: top * 1px; width: s * 0.86 * 1px; height: head-h * 1px; border-radius: s * 0.18 * 1px; background: body; }
    Rectangle { x: vx * 1px; y: vy * 1px; width: s * 0.64 * 1px; height: vh * 1px; border-radius: s * 0.1 * 1px; background: #121018; }
    // Eyes: pixels while it works, ^ ^ once it has finished.
    for ex in [0.34, 0.58]: Rectangle {
        property <float> eh: vh * 0.5 * blink;
        x: (x0 + s * (ex + look)) * 1px;
        y: (vy + vh * 0.25 + (vh * 0.5 - eh) / 2 + s * down) * 1px;
        width: s * 0.09 * 1px;
        height: max(0.6, eh) * 1px;
        border-radius: s * 0.02 * 1px;
        background: #aaf6ff;
        visible: !finished;
    }
    for ex in [0.34, 0.58]: Path {
        property <float> cx: x0 + s * (ex + 0.045);
        property <float> cy: vy + vh * 0.55;
        visible: finished;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: #aaf6ff;
        stroke-width: s * 0.07 * 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        MoveTo { x: cx - s * 0.06; y: cy + s * 0.04; }
        LineTo { x: cx; y: cy - s * 0.03; }
        LineTo { x: cx + s * 0.06; y: cy + s * 0.04; }
    }
}

export component WorkDots inherits Rectangle {
    in property <float> t;
    in property <bool> motion: true;
    width: 14px;
    height: 12px;
    for i in 3: Rectangle {
        property <float> k: motion ? max(0, sin((t * 6 - i * 0.9) * 1rad)) : 0;
        x: (2 + i * 5 - 1.5) * 1px;
        y: root.height / 2 + 1.5px - k * 2.5px - 1.5px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: #c4a2ff;
        opacity: 0.45 + 0.55 * k;
    }
}
