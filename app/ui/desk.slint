// web/office/desk.js and main.js's "Desk" section in Slint: the desk card (a click on a
// desk with a session at it) and the desk panel (one of its eight surfaces, as tabs).
// The data comes from hover-agents' desk.rs through office_ui/desk_ui.rs; this draws it.
// Long lists (a file, a diff, a terminal's output) are a window of rows: Rust lays all of
// them out (each has its y and height) and sends the ones in view, so a 6,000-line file
// costs what a screen of it does.

import { Pal, Fonts, Icon, Icons } from "widgets.slint";

// A tile of the card. badge: the running subagents' count on Agents (0 none).
export struct DTile { id: string, title: string, letter: string, icon: string, enabled: bool, reason: string, detail: string, live: bool, badge: int }
// A line of what the agent does now (the card's live steps). icon is a path.
export struct DStep { icon: string, color: color, name: string, text: string, live: bool, fail: bool }
// A tab of the panel.
export struct DTab { id: string, title: string, icon: string, enabled: bool, reason: string, badge: int, live: bool }
// A page the agent opened, in the Browser tab.
export struct DPage { url: string, label: string, server: bool, on: bool, tip: string }
// One row of a tab's list. kind: 0 gap, 1 heading, 2 note, 3 faint line, 4 file, 5 tree,
// 6 the open file's bar, 7 code line, 8 diff file, 9 hunk, 10 diff line, 11 more lines,
// 12 command, 13 output line, 14 subagent, 15 its section, 16 pull request head, 17 its title,
// 18 its facts, 19 button, 20 checks, 21 a check, 22 description line, 23 linked pull request,
// 24 diff summary, 25 the description as a picture of Markdown.
// tone: 0 ink, 1 green, 2 red, 3 amber, 4 blue, 5 purple, 6 dim, 7 faint.
export struct DRow {
    kind: int, y: length, h: length, depth: int,
    text: string, sub: string, right: string, num: string, num2: string,
    add: string, del: string, badge: string, tone: int, flag: int, act: string, tag1: string, tag2: string,
    // 25: the description painted as Markdown by hover-chat.
    img: image,
}

// The desk.js line icons on their 24 grid, for what icons.slint lacks.
export global DeskIcons {
    out property <string> files: "M 20 7 h -3 a 2 2 0 0 1 -2 -2 V 2 M 9 18 a 2 2 0 0 1 -2 -2 V 4 a 2 2 0 0 1 2 -2 h 7 l 4 4 v 10 a 2 2 0 0 1 -2 2 Z M 3 7.6 v 12.8 A 1.6 1.6 0 0 0 4.6 22 h 9.8";
    out property <string> diff: "M 15 2 H 6 a 2 2 0 0 0 -2 2 v 16 a 2 2 0 0 0 2 2 h 12 a 2 2 0 0 0 2 -2 V 7 Z M 9 10 h 6 M 12 7 v 6 M 9 17 h 6";
    out property <string> pr: "M 15 18 A 3 3 0 1 0 21 18 A 3 3 0 1 0 15 18 Z M 3 6 A 3 3 0 1 0 9 6 A 3 3 0 1 0 3 6 Z M 13 6 h 3 a 2 2 0 0 1 2 2 v 7 M 6 9 v 12";
    out property <string> linked: "M 9 17 H 7 A 5 5 0 0 1 7 7 h 2 M 15 7 h 2 a 5 5 0 1 1 0 10 h -2 M 8 12 h 8";
    out property <string> screen: "M 4 3 H 20 A 2 2 0 0 1 22 5 V 15 A 2 2 0 0 1 20 17 H 4 A 2 2 0 0 1 2 15 V 5 A 2 2 0 0 1 4 3 Z M 8 21 h 8 M 12 17 v 4";
    out property <string> file: "M 14 2 H 6 a 2 2 0 0 0 -2 2 v 16 a 2 2 0 0 0 2 2 h 12 a 2 2 0 0 0 2 -2 V 8 Z M 14 2 v 6 h 6";
    out property <string> ext: "M 15 3 h 6 v 6 M 10 14 L 21 3 M 18 13 v 6 a 2 2 0 0 1 -2 2 H 5 a 2 2 0 0 1 -2 -2 V 8 a 2 2 0 0 1 2 -2 h 6";
    out property <string> back: "M 12 19 l -7 -7 l 7 -7 M 19 12 H 5";
    out property <string> github: "M 15 22 v -4 a 4.8 4.8 0 0 0 -1 -3.5 c 3 0 6 -2 6 -5.5 c 0.08 -1.25 -0.27 -2.48 -1 -3.5 c 0.28 -1.15 0.28 -2.35 0 -3.5 c 0 0 -1 0 -3 1.5 c -2.64 -0.5 -5.36 -0.5 -8 0 C 6 2 5 2 5 2 c -0.3 1.15 -0.3 2.35 0 3.5 A 5.4 5.4 0 0 0 4 9 c 0 3.5 3 5.5 6 5.5 c -0.39 0.49 -0.68 1.05 -0.85 1.65 S 8.93 17.38 9 18 v 4 M 9 18 c -4.51 2 -5 -2 -7 -2";
    out property <string> search: "M 11 4 a 7 7 0 1 0 0 14 7 7 0 0 0 0 -14 Z M 20 20 l -3.5 -3.5";
    out property <string> chat: "M 7.9 20 A 9 9 0 1 0 4 16.1 L 2 22 Z";
    out property <string> up: "M 12 19 V 5 M 5 12 l 7 -7 l 7 7";
    out property <string> enter: "M 20 4 v 7 a 4 4 0 0 1 -4 4 H 4 M 9 10 l -5 5 l 5 5";
    // A surface's icon by its id (desk.js ICONS).
    public pure function of(id: string) -> string {
        if (id == "browser") { return Icons.globe; }
        if (id == "terminal") { return Icons.terminal; }
        if (id == "files") { return files; }
        if (id == "diff") { return diff; }
        if (id == "pr") { return pr; }
        if (id == "linked") { return linked; }
        if (id == "agents") { return Icons.bot; }
        if (id == "screen") { return screen; }
        if (id == "file") { return file; }
        if (id == "folder") { return Icons.folder; }
        Icons.globe
    }
    // A step's icon by its kind.
    public pure function step(kind: string) -> string {
        if (kind == "edit") { return Icons.rename; }
        if (kind == "run") { return Icons.terminal; }
        if (kind == "search") { return search; }
        if (kind == "read") { return file; }
        if (kind == "thought" || kind == "think") { return Icons.brain; }
        if (kind == "agent") { return Icons.bot; }
        if (kind == "web") { return Icons.globe; }
        Icons.sparkles
    }
}

// What the desk shows, set from Rust for each window that has an office.
export global Desk {
    // ── The card ────────────────────────────────────────────────────────
    in property <bool> card;
    // Where the click was, in the office's own coordinates.
    in property <length> card-x;
    in property <length> card-y;
    in property <string> c-name;
    in property <color> c-color;
    in property <string> c-tool-id;
    in property <string> c-tool;
    in property <string> c-title;
    // 0 waking, 1 working, 2 done, 3 failed, 4 stopped, 5 waiting, 6 queued.
    in property <int> c-stage;
    in property <string> c-what;
    in property <string> c-clock;
    in property <string> c-folder;
    in property <string> c-access;
    in property <string> c-access-id;
    in property <string> c-access-note;
    in property <float> c-ctx: -1;
    in property <[DStep]> c-steps;
    // What it says when it has no steps, or the end of its answer.
    in property <string> c-line;
    in property <string> c-answer;
    in property <bool> c-answer-err;
    in property <string> c-meta;
    in property <[color]> c-helpers;
    in property <string> c-helpers-text;
    in property <bool> c-asking;
    in property <string> c-ask-title;
    in property <string> c-ask-line;
    // The session's id and the open question's, for the buttons that answer it; the allow
    // button's word and whether it is a dangerous one; a question's choices (Skip, Answer…)
    // in place of Deny, Trust and Allow.
    in property <int> c-id;
    in property <string> c-ask-id;
    in property <string> c-ask-allow;
    in property <bool> c-ask-danger;
    in property <bool> c-ask-question;
    in property <[DTile]> tiles;
    in-out property <string> c-draft;
    in property <string> c-placeholder;
    in property <bool> c-busy;
    in property <bool> c-stopping;
    in property <string> c-chat-label;
    callback card-close();
    callback card-tile(string);
    callback card-send();
    callback card-chat();
    // Open this desk's own folder in the editor the user chose.
    callback card-editor();
    // A key the card got that may be a surface's letter: true when it opened one.
    callback card-key(string) -> bool;

    // ── The panel ───────────────────────────────────────────────────────
    in property <bool> panel;
    in property <string> p-title;
    in property <string> p-sub;
    in property <int> tab;
    in property <[DTab]> tabs;
    in property <[DRow]> rows;
    in property <length> content-h;
    in property <bool> loading;
    in property <string> empty-icon;
    in property <string> empty-title;
    in property <string> empty-text;
    // Bumped when the list is to start at its top again (another tab, another file).
    in property <int> reset;
    callback panel-close();
    callback pick-tab(int);
    // The list scrolled: its top, and its height.
    callback scrolled(length, length);
    callback resized(length, length);
    // A row or button asks for something: "file:…", "dir:…", "ext:url", …
    callback act(string);
    // Files
    in-out property <string> find;
    in property <bool> file-open;
    callback find-edited(string);
    // Browser
    in-out property <string> b-url;
    in property <bool> b-native;
    in property <bool> b-can-back;
    in property <bool> b-can-forward;
    in property <bool> b-loading;
    in property <string> b-title;
    in property <string> b-using;
    in property <string> b-error;
    in property <string> b-note;
    in property <[DPage]> b-pages;
    // Where Hover's own browser is laid over the panel (window coordinates).
    callback b-area(length, length, length, length);
    callback b-go(string);
    callback b-nav(string);
    callback b-page(string);
    // Screen
    in property <bool> s-live;
    in property <bool> s-watch;
    in property <image> s-image;
    in property <bool> s-has-image;
    in property <string> s-note;
    in property <bool> s-denied;
    in property <bool> s-supported: true;
    callback s-watch-toggle();
    callback s-allow();
    // Pull request: 0 the list, 1 the GitHub CLI's setup, 2 the form that opens one.
    in property <int> pr-mode;
    in property <string> gh-title;
    in property <string> gh-text;
    in property <string> gh-code;
    in property <string> gh-url;
    in property <string> gh-line;
    in property <string> gh-error;
    in property <string> gh-user;
    in property <string> gh-button;
    in property <string> gh-hint;
    in property <bool> gh-busy;
    in property <bool> gh-can-start;
    callback gh-start();
    callback gh-cancel();
    callback gh-copy();
    in-out property <string> pr-title;
    in-out property <string> pr-body;
    in-out property <string> pr-branch;
    in-out property <string> pr-base;
    in-out property <bool> pr-commit;
    in-out property <bool> pr-draft;
    in property <string> pr-what;
    in property <bool> pr-new-branch;
    in property <string> pr-commit-label;
    in property <bool> pr-can-commit;
    // Why Create is off ("" when it isn't).
    in property <string> pr-blocked;
    in property <bool> pr-creating;
    in property <bool> pr-ok;
    in property <string> pr-url;
    in property <string> pr-error;
    in property <string> pr-steps;
    callback pr-edited();
    callback pr-create();
}

global Tones {
    public pure function color(t: int) -> color {
        if (t == 1) { return #5de37a; }
        if (t == 2) { return #ff7b72; }
        if (t == 3) { return #ffc46b; }
        if (t == 4) { return #7cb7ff; }
        if (t == 5) { return #c4a2ff; }
        if (t == 6) { return #f6f2ff9e; }
        if (t == 7) { return #f6f2ff61; }
        #f6f2ff
    }
}

// Keeps the caret in view inside a scrolling box (as office.slint's Caret does).
global Follow {
    public pure function y(y: length, h: length, c: length, font: length) -> length {
        if (c + y < 0) { return -c; }
        if (c + font * 1.45 + y > h) { return min(0px, h - c - font * 1.45); }
        y
    }
}

// .pbtn: a small bordered button; primary is the light one.
export component DButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> small;
    in property <string> id;
    callback clicked;
    height: small ? 26px : 30px;
    width: row.preferred-width + 24px;
    border-radius: 9px;
    background: primary ? (ta.has-hover && enabled ? white : #f5f5f7) : ta.has-hover && enabled ? #ffffff1f : #ffffff0f;
    border-width: primary ? 0 : 1px;
    border-color: #ffffff1f;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-id: id;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        if icon != "": VerticalLayout { alignment: center; Icon { name: icon; size: 13px; tint: primary ? #0b0a0f : #f6f2ff; } }
        Text { text: root.text; font-size: small ? 11.5px : 12px; font-weight: 600; color: primary ? #0b0a0f : #f6f2ff; vertical-alignment: center; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A single-line box with its label above.
component DField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <string> id;
    callback edited();
    callback accepted();
    spacing: 4px;
    Text { text: label; font-size: 11px; color: #f6f2ff61; }
    Rectangle {
        height: 32px;
        border-radius: 9px;
        background: #1b181e;
        border-width: 1px;
        border-color: ti.has-focus ? #c4a2ff8c : #ffffff14;
        ti := TextInput {
            x: 10px;
            width: parent.width - 20px;
            text <=> root.value;
            single-line: true;
            font-size: 13px;
            color: #f6f2ff;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-id: id;
            accessible-label: label;
            edited => { root.edited(); }
            accepted => { root.accepted(); }
        }
        if value == "" && placeholder != "": Text { x: 10px; text: placeholder; font-size: 13px; color: #f6f2ff52; vertical-alignment: center; }
    }
}

component DCheck inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    in property <string> id;
    callback toggled();
    height: 24px;
    accessible-role: checkbox;
    accessible-id: id;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { checked = !checked; toggled(); }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center;
            Rectangle { width: 16px; height: 16px; border-radius: 5px; background: checked ? #9b6bff : #ffffff12; border-width: 1px; border-color: checked ? #9b6bff : #ffffff2e;
                if checked: Icon { x: 2px; y: 2px; name: Icons.check; size: 12px; tint: white; } } }
        Text { text: label; font-size: 12.5px; color: #ececf0; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.checked = !root.checked; root.toggled(); } }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> fg: #f6f2ff9e;
    in property <color> bg: #ffffff14;
    height: 22px;
    width: t.preferred-width + 20px;
    border-radius: 11px;
    background: bg;
    t := Text { text: root.text; font-size: 11.5px; font-weight: 600; color: fg; horizontal-alignment: center; vertical-alignment: center; }
}

// A file's one-letter status (M, A, D, U, R).
component StatusBadge inherits Rectangle {
    in property <string> letter;
    property <color> c: letter == "A" || letter == "U" ? #5de37a : letter == "D" ? #ff7b72 : letter == "R" ? #7cb7ff : #ffc46b;
    width: 17px;
    height: 17px;
    border-radius: 5px;
    background: c.with-alpha(0.15);
    Text { text: letter; font-size: 10px; font-weight: 700; color: c; horizontal-alignment: center; vertical-alignment: center; }
}

// One row of the list, by its kind (see DRow).
component DeskRowView inherits Rectangle {
    in property <DRow> r;
    callback act(string);
    height: r.h;
    // 1: a section heading.
    if r.kind == 1: HorizontalLayout {
        padding-left: 6px;
        padding-top: 14px;
        spacing: 6px;
        alignment: start;
        Text { text: r.text; font-size: 10.5px; font-weight: 600; letter-spacing: 0.8px; color: #f6f2ff61; vertical-alignment: center; }
        if r.right != "": Text { text: r.right; font-size: 10.5px; color: #f6f2ff61; vertical-alignment: center; }
    }
    // 2: a note.
    if r.kind == 2: Rectangle {
        x: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: 8px;
        background: #ffc46b14;
        Text { x: 10px; y: 7px; width: parent.width - 20px; text: r.text; font-size: 11.5px; color: #ffd59a; wrap: word-wrap; }
    }
    // 3: a faint line.
    if r.kind == 3: Text { x: 6px; width: parent.width - 12px; text: r.text; font-size: 12px; color: #f6f2ff61; wrap: word-wrap; vertical-alignment: center; }
    // 4: a file (changed, looked at, or a search hit).
    if r.kind == 4: Rectangle {
        border-radius: 8px;
        background: fa.has-hover ? #ffffff0d : transparent;
        accessible-role: button;
        accessible-label: r.sub != "" ? r.text + " in " + r.sub : r.text;
        accessible-action-default => { act(r.act); }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            VerticalLayout { alignment: center; Icon { name: DeskIcons.file; size: 14px; tint: #f6f2ff61; } }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 7px;
                Text { text: r.text; font-size: 12.5px; font-weight: 500; color: r.flag == 4 ? #f6f2ff9e : #f6f2ff; vertical-alignment: center; overflow: elide; }
                Text { text: r.sub; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #f6f2ff61; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
            if r.tag1 != "": Rectangle { width: t1.preferred-width + 12px; height: 17px; y: (parent.height - 17px) / 2; border-radius: 5px; background: r.flag == 2 ? #c4a2ff24 : #ffffff0f;
                t1 := Text { text: r.tag1; font-size: 10.5px; color: r.flag == 2 ? #d8c6ff : #f6f2ff9e; horizontal-alignment: center; vertical-alignment: center; } }
            if r.tag2 != "": Rectangle { width: t2.preferred-width + 12px; height: 17px; y: (parent.height - 17px) / 2; border-radius: 5px; background: #ffffff0f;
                t2 := Text { text: r.tag2; font-size: 10.5px; color: #f6f2ff9e; horizontal-alignment: center; vertical-alignment: center; } }
            if r.add != "": Text { text: r.add; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #5de37a; vertical-alignment: center; }
            if r.del != "": Text { text: r.del; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #ff7b72; vertical-alignment: center; }
            if r.badge != "": VerticalLayout { alignment: center; StatusBadge { letter: r.badge; } }
        }
        fa := TouchArea { mouse-cursor: pointer; clicked => { act(r.act); } }
    }
    // 5: the folder as a tree.
    if r.kind == 5: Rectangle {
        border-radius: 8px;
        background: ta5.has-hover ? #ffffff0d : transparent;
        accessible-role: button;
        accessible-label: r.text;
        accessible-expandable: r.act.starts-with("dir:");
        accessible-expanded: r.flag == 1;
        accessible-action-default => { act(r.act); }
        HorizontalLayout {
            padding-left: 8px + r.depth * 14px; padding-right: 8px; spacing: 7px;
            VerticalLayout { alignment: center; width: 12px;
                if r.act.starts-with("dir:"): Icon { name: r.flag == 1 ? Icons.chevron-down : Icons.chevron-right; size: 12px; tint: #f6f2ff61; } }
            VerticalLayout { alignment: center; Icon { name: r.act.starts-with("dir:") ? Icons.folder : DeskIcons.file; size: 14px; tint: #f6f2ff61; } }
            Text { text: r.text; font-size: 12px; color: r.flag == 2 ? #ffd59a : #dcd8e4; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        ta5 := TouchArea { mouse-cursor: pointer; clicked => { act(r.act); } }
    }
    // 6: the open file's bar: back, its name and folder, its size.
    if r.kind == 6: HorizontalLayout {
        padding-left: 2px; padding-right: 2px; spacing: 8px;
        VerticalLayout { alignment: center;
            Rectangle { width: 28px; height: 28px; border-radius: 9px; background: ba.has-hover ? #ffffff17 : #ffffff0f;
                accessible-role: button; accessible-label: "Back to the files"; accessible-action-default => { act("fback"); }
                Icon { name: DeskIcons.back; size: 14px; tint: #f6f2ff9e; }
                ba := TouchArea { mouse-cursor: pointer; clicked => { act("fback"); } } } }
        HorizontalLayout { horizontal-stretch: 1; spacing: 7px;
            Text { text: r.text; font-size: 12.5px; font-weight: 500; color: #f6f2ff; vertical-alignment: center; overflow: elide; }
            Text { text: r.sub; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #f6f2ff61; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; } }
        Text { text: r.right; font-size: 11px; color: #f6f2ff61; vertical-alignment: center; }
    }
    // 7: a line of a file, with its number.
    if r.kind == 7: Rectangle {
        background: #0b0a0d;
        Text { x: 0; width: 44px; text: r.num; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: #ffffff38; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 56px; width: parent.width - 62px; text: r.text; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: #d6d3dc; vertical-alignment: center; overflow: clip; }
    }
    // 8: a changed file of the diff; it folds and opens.
    if r.kind == 8: Rectangle {
        background: r.flag == 1 ? #ffffff09 : #ffffff09;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        border-bottom-left-radius: r.flag == 1 ? 0 : 10px;
        border-bottom-right-radius: r.flag == 1 ? 0 : 10px;
        accessible-role: button;
        accessible-label: r.text;
        accessible-expandable: true;
        accessible-expanded: r.flag == 1;
        accessible-action-default => { act(r.act); }
        if dh.has-hover: Rectangle { background: #ffffff0a; border-radius: 10px; }
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 8px;
            VerticalLayout { alignment: center; Icon { name: r.flag == 1 ? Icons.chevron-down : Icons.chevron-right; size: 12px; tint: #f6f2ff61; } }
            VerticalLayout { alignment: center; StatusBadge { letter: r.badge; } }
            Text { text: r.text; font-family: "DejaVu Sans Mono"; font-size: 12px; color: #f6f2ff; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            if r.add != "": Text { text: r.add; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #5de37a; vertical-alignment: center; }
            if r.del != "": Text { text: r.del; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #ff7b72; vertical-alignment: center; }
        }
        dh := TouchArea { mouse-cursor: pointer; clicked => { act(r.act); } }
    }
    // 9: a hunk's header.
    if r.kind == 9: Rectangle {
        background: #7cb7ff12;
        Text { x: 10px; width: parent.width - 20px; text: r.text; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: #8fb6ff; vertical-alignment: center; overflow: elide; }
    }
    // 10: a diff line, with both sides' numbers.
    if r.kind == 10: Rectangle {
        background: r.tone == 1 ? #2ea04326 : r.tone == 2 ? #f8514921 : #0f0e11;
        Text { x: 0; width: 38px; text: r.num; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #ffffff38; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 40px; width: 38px; text: r.num2; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #ffffff38; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: 88px; width: parent.width - 94px; text: r.text; font-family: "DejaVu Sans Mono"; font-size: 11.5px; vertical-alignment: center; overflow: clip;
            color: r.tone == 1 ? #aff5b4 : r.tone == 2 ? #ffc1bc : #d6d3dc; }
    }
    // 11: more lines than are shown.
    if r.kind == 11: Rectangle {
        background: #0f0e11;
        Text { x: 10px; width: parent.width - 20px; text: r.text; font-size: 11.5px; color: #f6f2ff61; vertical-alignment: center; }
    }
    // 12: a command of the terminal, and how it ended.
    if r.kind == 12: Rectangle {
        background: #ffffff09;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        border-bottom-left-radius: r.flag == 1 ? 10px : 0;
        border-bottom-right-radius: r.flag == 1 ? 10px : 0;
        border-width: 0;
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 8px;
            Text { text: "$"; font-family: "DejaVu Sans Mono"; font-size: 12px; color: #5de37a; vertical-alignment: center; }
            Text { text: r.text; font-family: "DejaVu Sans Mono"; font-size: 12px; color: #f3f1f6; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: r.right; font-family: "DejaVu Sans Mono"; font-size: 10.5px; color: Tones.color(r.tone); vertical-alignment: center; }
        }
    }
    // 13: a line of output.
    if r.kind == 13: Rectangle {
        background: #0b0a0d;
        Text { x: 10px; width: parent.width - 20px; text: r.text; font-family: "DejaVu Sans Mono"; font-size: 11.5px; color: r.tone == 7 ? #ffffff4d : #d6d3dc; vertical-alignment: center; overflow: clip; }
    }
    // 14: a subagent; it folds and opens.
    if r.kind == 14: Rectangle {
        background: #ffffff08;
        border-radius: 10px;
        accessible-role: button;
        accessible-label: r.text;
        accessible-expandable: true;
        accessible-expanded: r.flag == 1;
        accessible-action-default => { act(r.act); }
        if sh.has-hover: Rectangle { background: #ffffff08; border-radius: 10px; }
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 10px;
            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Tones.color(r.tone); } }
            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                Text { text: r.text; font-size: 13px; font-weight: 500; color: #f6f2ff; overflow: elide; }
                Text { text: r.sub; font-size: 11.5px; color: #f6f2ff61; overflow: elide; } }
            Text { text: r.right; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #f6f2ff61; vertical-alignment: center; }
            VerticalLayout { alignment: center; Icon { name: r.flag == 1 ? Icons.chevron-down : Icons.chevron-right; size: 12px; tint: #f6f2ff61; } }
        }
        sh := TouchArea { mouse-cursor: pointer; clicked => { act(r.act); } }
    }
    // 15: a subagent's section (Task, Result).
    if r.kind == 15: Text { x: 28px; text: r.text; font-size: 10.5px; font-weight: 600; letter-spacing: 0.6px; color: #f6f2ff61; vertical-alignment: bottom; }
    // 16: a pull request's state and number.
    if r.kind == 16: HorizontalLayout {
        padding-left: 4px; spacing: 8px; alignment: start;
        VerticalLayout { alignment: center; Pill { text: r.text; fg: r.tone == 1 ? #5de37a : r.tone == 5 ? #c9a8ff : r.tone == 2 ? #ff7b72 : #c9c5d1;
            bg: r.tone == 1 ? #2ea04333 : r.tone == 5 ? #a371f733 : r.tone == 2 ? #f8514930 : #ffffff1a; } }
        Text { text: r.sub; font-family: "DejaVu Sans Mono"; font-size: 12px; color: #f6f2ff61; vertical-alignment: center; }
    }
    // 17: its title.
    if r.kind == 17: Text { x: 4px; width: parent.width - 8px; text: r.text; font-size: 15px; font-weight: 600; letter-spacing: -0.15px; color: #f6f2ff; wrap: word-wrap; vertical-alignment: center; }
    // 18: its facts.
    if r.kind == 18: Text { x: 4px; width: parent.width - 8px; text: r.text; font-size: 11.5px; color: #f6f2ff9e; wrap: word-wrap; vertical-alignment: center; }
    // 19: a button that opens an address.
    if r.kind == 19: HorizontalLayout {
        padding-left: 4px; alignment: start;
        VerticalLayout { alignment: center; DButton { text: r.text; icon: DeskIcons.ext; small: true; clicked => { act(r.act); } } }
    }
    // 20: the checks' tally.
    if r.kind == 20: HorizontalLayout {
        padding-left: 4px; spacing: 12px; alignment: start;
        Text { text: "Checks"; font-size: 12px; font-weight: 600; color: #f6f2ff; vertical-alignment: center; }
        if r.del != "": Text { text: r.del; font-size: 12px; color: #ff7b72; vertical-alignment: center; }
        if r.sub != "": Text { text: r.sub; font-size: 12px; color: #ffc46b; vertical-alignment: center; }
        if r.add != "": Text { text: r.add; font-size: 12px; color: #5de37a; vertical-alignment: center; }
        if r.tag1 != "": Text { text: r.tag1; font-size: 12px; color: #f6f2ff9e; vertical-alignment: center; }
    }
    // 21: one check.
    if r.kind == 21: Rectangle {
        border-radius: 7px;
        background: r.act != "" && ca.has-hover ? #ffffff0d : transparent;
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Tones.color(r.tone); } }
            Text { text: r.text; font-size: 12px; color: #dcd8e4; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        ca := TouchArea { enabled: r.act != ""; mouse-cursor: pointer; clicked => { act(r.act); } }
    }
    // 22: a line of the description.
    if r.kind == 22: Text { x: 6px; width: parent.width - 12px; text: r.text; font-size: 13px; color: #ececf0; vertical-alignment: center; overflow: clip; }
    // 25: the description, painted as Markdown by hover-chat with the thread's 12 px at each
    // side, so the picture hangs 8 px out at the left to put its text at the rows' 4 px. A
    // click goes back with its place in the picture (a link, a code block's Copy).
    if r.kind == 25: Rectangle {
        Image { x: -8px; y: 0; width: parent.width + 16px; height: parent.height - 8px; source: r.img; image-fit: fill; }
        TouchArea { clicked => { act("md:" + round((self.mouse-x + 8px) / 1px) + ":" + round(self.mouse-y / 1px)); } }
    }
    // 23: a pull request the session mentions.
    if r.kind == 23: Rectangle {
        border-radius: 10px;
        background: la.has-hover ? #ffffff0d : transparent;
        accessible-role: button;
        accessible-label: r.text;
        accessible-action-default => { act(r.act); }
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 10px;
            if r.badge != "": VerticalLayout { alignment: center; Pill { text: r.badge; fg: r.tone == 1 ? #5de37a : r.tone == 5 ? #c9a8ff : r.tone == 2 ? #ff7b72 : #c9c5d1;
                bg: r.tone == 1 ? #2ea04333 : r.tone == 5 ? #a371f733 : r.tone == 2 ? #f8514930 : #ffffff1a; } }
            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                Text { text: r.text; font-size: 13px; font-weight: 500; color: #f6f2ff; overflow: elide; }
                Text { text: r.sub; font-size: 11.5px; color: #f6f2ff61; overflow: elide; } }
            if r.add != "": Text { text: r.add; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #5de37a; vertical-alignment: center; }
            if r.del != "": Text { text: r.del; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #ff7b72; vertical-alignment: center; }
            VerticalLayout { alignment: center; Icon { name: DeskIcons.ext; size: 13px; tint: #f6f2ff61; } }
        }
        la := TouchArea { mouse-cursor: pointer; clicked => { act(r.act); } }
    }
    // 24: the diff's summary.
    if r.kind == 24: HorizontalLayout {
        padding-left: 4px; spacing: 8px; alignment: start;
        Text { text: r.text; font-size: 12px; font-weight: 600; color: #f6f2ff; vertical-alignment: center; }
        if r.add != "": Text { text: r.add; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #5de37a; vertical-alignment: center; }
        if r.del != "": Text { text: r.del; font-family: "DejaVu Sans Mono"; font-size: 11px; color: #ff7b72; vertical-alignment: center; }
        if r.sub != "": VerticalLayout { alignment: center; Rectangle { height: 19px; width: bt.preferred-width + 16px; border-radius: 6px; background: #ffffff0e;
            bt := Text { text: r.sub; font-family: "DejaVu Sans Mono"; font-size: 10.5px; color: #f6f2ff99; horizontal-alignment: center; vertical-alignment: center; } } }
    }
}

// The windowed list: the rows in view, placed at their own y in a viewport as tall as all of them.
component DeskList inherits Rectangle {
    callback act(string);
    clip: true;
    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: Desk.content-h;
        changed content-y => { Desk.scrolled(-self.content-y, self.height); }
        changed height => { Desk.resized(self.width, self.height); Desk.scrolled(-self.content-y, self.height); }
        changed width => { Desk.resized(self.width, self.height); }
        init => { Desk.resized(self.width, self.height); Desk.scrolled(0px, self.height); }
        for r in Desk.rows: DeskRowView {
            x: 0;
            y: r.y;
            width: fl.width - 10px;
            r: r;
            act(a) => { root.act(a); }
        }
    }
    property <int> reset: Desk.reset;
    changed reset => { fl.content-y = 0; }
    // The bar beside it, so a long list shows there is more of it.
    Rectangle {
        x: parent.width - 4px;
        width: 3px;
        y: 0;
        height: parent.height;
        visible: Desk.content-h > parent.height + 1px;
        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: #ffffff38;
            height: max(20px, parent.height * (parent.height / max(1px, Desk.content-h)));
            y: (parent.height - self.height) * (-fl.content-y / max(1px, Desk.content-h - parent.height));
        }
    }
}

// Nothing to show, or not read yet.
component DeskEmpty inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding: 20px;
        if Desk.loading: Text { text: "Reading…"; font-size: 12px; color: #f6f2ff61; horizontal-alignment: center; accessible-role: text; accessible-label: "Reading"; }
        if !Desk.loading: HorizontalLayout { alignment: center; Icon { name: DeskIcons.of(Desk.empty-icon); size: 26px; tint: #f6f2ff61; } }
        if !Desk.loading: Text { text: Desk.empty-title; font-size: 13px; font-weight: 600; color: #f6f2ff9e; horizontal-alignment: center; wrap: word-wrap; }
        if !Desk.loading && Desk.empty-text != "": HorizontalLayout { alignment: center;
            Text { text: Desk.empty-text; font-size: 12px; color: #f6f2ff61; horizontal-alignment: center; wrap: word-wrap; max-width: 340px; } }
    }
}

component BarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 28px;
    Rectangle {
        y: (parent.height - 28px) / 2;
        height: 28px;
        border-radius: 8px;
        background: ta.has-hover && root.enabled ? #ffffff14 : transparent;
        opacity: root.enabled ? 1 : 0.3;
        accessible-role: button;
        accessible-label: root.label;
        accessible-enabled: root.enabled;
        accessible-action-default => { if (root.enabled) { root.clicked(); } }
        Icon { name: root.icon; size: 14px; tint: #f6f2ff9e; }
        ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    }
}

// The address box over the browser: back, forward, the address, reload or stop, and the
// page in the user's own browser.
component BrowserBar inherits Rectangle {
    height: 36px;
    border-radius: 10px;
    background: #1b181e;
    border-width: 1px;
    border-color: addr.has-focus ? #ffffff40 : #ffffff14;
    HorizontalLayout {
        padding-left: 4px; padding-right: 4px; spacing: 2px;
        if Desk.b-native: BarButton { icon: DeskIcons.back; label: "Back"; enabled: Desk.b-can-back; clicked => { Desk.b-nav("back"); } }
        if Desk.b-native: BarButton { icon: Icons.forward; label: "Forward"; enabled: Desk.b-can-forward; clicked => { Desk.b-nav("forward"); } }
        VerticalLayout { alignment: center; Icon { name: Desk.b-url.starts-with("http://localhost") || Desk.b-url.starts-with("http://127.") ? Icons.server : Icons.globe; size: 14px; tint: #f6f2ff61; } }
        Rectangle { width: 4px; }
        Rectangle {
            horizontal-stretch: 1;
            addr := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> Desk.b-url;
                single-line: true;
                font-family: "DejaVu Sans Mono";
                font-size: 12.5px;
                color: #f6f2ff;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-id: "bAddr";
                accessible-label: "Address";
                accepted => { Desk.b-go(self.text); }
            }
            if Desk.b-url == "": Text { text: "localhost:3000 or a web address"; font-size: 12.5px; color: #f6f2ff52; vertical-alignment: center; }
        }
        if Desk.b-native: BarButton { icon: Desk.b-loading ? Icons.close : Icons.refresh; label: Desk.b-loading ? "Stop" : "Reload"; enabled: Desk.b-url != "";
            clicked => { Desk.b-nav(Desk.b-loading ? "stop" : "reload"); } }
        BarButton { icon: DeskIcons.ext; label: "Open in your browser"; enabled: Desk.b-url != ""; clicked => { Desk.act("ext:" + Desk.b-url); } }
    }
}

component BrowserBody inherits VerticalLayout {
    spacing: 8px;
    BrowserBar { }
    // Hover's browser is at work in it.
    if Desk.b-using != "": HorizontalLayout { padding-left: 4px; spacing: 7px;
        VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: #7cc0ff; } }
        Text { text: Desk.b-using; font-size: 11.5px; color: #9fd0ff; vertical-alignment: center; overflow: elide; } }
    if Desk.b-using == "" && Desk.b-error != "": Text { x: 4px; text: Desk.b-error; font-size: 11.5px; color: #ff9a92; overflow: elide; }
    // The pages the agent opened.
    if Desk.b-pages.length > 0: Flickable {
        height: 26px;
        content-width: pg.preferred-width;
        interactive: true;
        pg := HorizontalLayout {
            width: self.preferred-width;
            height: parent.height;
            spacing: 6px;
            for p in Desk.b-pages: Rectangle {
                height: 26px;
                width: min(220px, pr.preferred-width + 20px);
                border-radius: 13px;
                background: p.on ? #ffffff24 : pa.has-hover ? #ffffff14 : #ffffff0f;
                accessible-role: button;
                accessible-label: p.tip;
                accessible-action-default => { Desk.b-page(p.url); }
                pr := HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 6px;
                    VerticalLayout { alignment: center; Icon { name: p.server ? Icons.server : Icons.globe; size: 12px; tint: p.on ? white : #f6f2ff9e; } }
                    Text { text: p.label; font-size: 11.5px; color: p.on ? white : #f6f2ff9e; vertical-alignment: center; overflow: elide; } }
                pa := TouchArea { mouse-cursor: pointer; clicked => { Desk.b-page(p.url); } }
            }
        }
    }
    // Where Hover's own browser is laid over the panel (macOS); elsewhere, why there isn't one.
    area := Rectangle {
        vertical-stretch: 1;
        min-height: 120px;
        border-radius: 10px;
        background: #0d0c10;
        border-width: 1px;
        border-color: #ffffff10;
        init => { Desk.b-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
        changed width => { Desk.b-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
        changed height => { Desk.b-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
        VerticalLayout {
            alignment: center; spacing: 6px; padding: 20px;
            HorizontalLayout { alignment: center; Icon { name: Icons.globe; size: 26px; tint: #f6f2ff61; } }
            Text { text: Desk.b-native ? "Nothing open" : "Hover’s browser isn’t available here"; font-size: 13px; font-weight: 600; color: #f6f2ff9e; horizontal-alignment: center; }
            HorizontalLayout { alignment: center;
                Text { text: Desk.b-note; font-size: 12px; color: #f6f2ff61; horizontal-alignment: center; wrap: word-wrap; max-width: 360px; } }
        }
    }
}

component ScreenBody inherits VerticalLayout {
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center;
            Rectangle { height: 22px; width: sl.preferred-width + 24px; border-radius: 11px; background: Desk.s-live ? #ff453a29 : #ffffff12;
                sl := HorizontalLayout { padding-left: 9px; padding-right: 9px; spacing: 6px;
                    VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Desk.s-live ? #ff453a : #ffffff66; } }
                    Text { text: Desk.s-live ? "Live" : "Desktop"; font-size: 11.5px; font-weight: 600; color: Desk.s-live ? #ffb3ad : #f6f2ff9e; vertical-alignment: center; } } } }
        Rectangle { horizontal-stretch: 1; }
        if Desk.s-supported: DButton { id: "watch"; small: true; text: Desk.s-watch ? "Stop watching" : "Watch live"; clicked => { Desk.s-watch-toggle(); } }
    }
    if Desk.s-denied: Rectangle {
        height: dn.preferred-height;
        border-radius: 10px;
        background: #ffc46b14;
        dn := VerticalLayout { padding: 10px; padding-left: 12px; spacing: 3px;
            Text { text: "Hover needs Screen Recording to show the screen"; font-size: 12px; font-weight: 600; color: #ffd59a; wrap: word-wrap; }
            Text { text: "Allow Hover in System Settings → Privacy & Security → Screen Recording, then quit and reopen Hover."; font-size: 12px; color: #ffd59a; wrap: word-wrap; }
            HorizontalLayout { padding-top: 6px; alignment: start; DButton { id: "allow"; small: true; text: "Allow…"; clicked => { Desk.s-allow(); } } } }
    }
    Rectangle {
        vertical-stretch: 1;
        min-height: 120px;
        border-radius: 10px;
        background: black;
        border-width: 1px;
        border-color: #ffffff14;
        clip: true;
        if Desk.s-has-image: Image { width: 100%; height: 100%; source: Desk.s-image; image-fit: contain; accessible-role: image; accessible-label: Desk.s-live ? "The screen, live" : "The desktop"; }
        if !Desk.s-has-image: Text { text: Desk.s-supported ? "Reading…" : Desk.s-note; font-size: 12px; color: #f6f2ff61; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
    }
    Text { text: Desk.s-note; font-size: 11.5px; color: #f6f2ff61; wrap: word-wrap; visible: Desk.s-supported; }
}

// Pull request, 1: the GitHub CLI in one click: install it, then sign in with GitHub's code.
component GhSetup inherits Rectangle {
    background: #ffffff08;
    border-radius: 12px;
    border-width: 1px;
    border-color: #ffffff0f;
    VerticalLayout {
        padding: 12px; spacing: 10px; alignment: start;
        HorizontalLayout { spacing: 12px;
            VerticalLayout { alignment: start; padding-top: 2px; Icon { name: DeskIcons.github; size: 26px; tint: white; } }
            VerticalLayout { horizontal-stretch: 1; spacing: 3px;
                Text { text: Desk.gh-title; font-size: 14px; font-weight: 600; color: #f6f2ff; wrap: word-wrap; }
                Text { text: Desk.gh-text; font-size: 12px; color: #f6f2ff9e; wrap: word-wrap; } } }
        if Desk.gh-code != "": Rectangle {
            height: cd.preferred-height;
            border-radius: 10px;
            background: #7cc0ff14;
            border-width: 1px;
            border-color: #7cc0ff33;
            cd := VerticalLayout { padding: 10px; padding-left: 12px; spacing: 4px;
                Text { text: "Your one-time code"; font-size: 11px; color: #9fd0ff; }
                Text { text: Desk.gh-code; font-family: "DejaVu Sans Mono"; font-size: 22px; font-weight: 700; letter-spacing: 2.6px; color: white; accessible-role: text; accessible-label: "Your one-time code: " + Desk.gh-code; }
                HorizontalLayout { spacing: 6px; padding-top: 4px; alignment: start;
                    DButton { id: "ghCopy"; small: true; text: "Copy code"; icon: Icons.copy; clicked => { Desk.gh-copy(); } }
                    DButton { id: "ghOpen"; small: true; primary: true; text: "Open github.com/login/device"; icon: DeskIcons.ext; clicked => { Desk.act("ext:" + Desk.gh-url); } } } }
        }
        if Desk.gh-busy: Text { text: Desk.gh-line; font-size: 12px; color: #f6f2ff9e; wrap: word-wrap; }
        if Desk.gh-error != "" && !Desk.gh-busy: Rectangle {
            height: er.preferred-height + 14px;
            border-radius: 8px;
            background: #ff453a1a;
            er := Text { x: 10px; y: 7px; width: parent.width - 20px; text: Desk.gh-error; font-size: 12px; color: #ffb0aa; wrap: word-wrap; }
        }
        if Desk.gh-hint != "": Text { text: Desk.gh-hint; font-size: 12px; color: #ffd59a; wrap: word-wrap; }
        HorizontalLayout { spacing: 10px; alignment: start;
            if Desk.gh-busy: DButton { id: "ghCancel"; text: "Cancel"; clicked => { Desk.gh-cancel(); } }
            if !Desk.gh-busy && Desk.gh-can-start: DButton { id: "ghSetup"; primary: true; text: Desk.gh-button; icon: DeskIcons.github; clicked => { Desk.gh-start(); } }
            if Desk.gh-user != "": VerticalLayout { alignment: center; Text { text: "Signed in as " + Desk.gh-user; font-size: 11.5px; color: #f6f2ff61; } } }
    }
}

// Pull request, 2: no pull request yet; open one from the session's title and answer.
component PrForm inherits Flickable {
    content-height: f.preferred-height;
    f := VerticalLayout {
        width: parent.width - 10px;
        padding: 12px; spacing: 8px;
        if Desk.pr-ok: Rectangle {
            height: 38px; border-radius: 9px; background: #30d1581a;
            HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                VerticalLayout { alignment: center; Icon { name: Icons.check; size: 15px; tint: #7ee59a; } }
                Text { text: "Pull request opened."; font-size: 12.5px; color: #7ee59a; vertical-alignment: center; horizontal-stretch: 1; }
                if Desk.pr-url != "": VerticalLayout { alignment: center; DButton { id: "prOpened"; small: true; text: "Open on GitHub"; icon: DeskIcons.ext; clicked => { Desk.act("ext:" + Desk.pr-url); } } } }
        }
        HorizontalLayout { alignment: start; Pill { text: "No pull request yet"; } }
        Text { text: Desk.pr-what; font-size: 12px; color: #f6f2ff9e; wrap: word-wrap; }
        if Desk.pr-blocked != "": Rectangle {
            height: bl.preferred-height + 14px; border-radius: 8px; background: #ffc46b14;
            bl := Text { x: 10px; y: 7px; width: parent.width - 20px; text: Desk.pr-blocked; font-size: 11.5px; color: #ffd59a; wrap: word-wrap; }
        }        DField { id: "prTitle"; label: "Title"; value <=> Desk.pr-title; edited => { Desk.pr-edited(); } }
        VerticalLayout { spacing: 4px;
            Text { text: "Description"; font-size: 11px; color: #f6f2ff61; }
            Rectangle {
                height: 84px; border-radius: 9px; background: #1b181e; border-width: 1px; border-color: body.has-focus ? #c4a2ff8c : #ffffff14; clip: true;
                bfl := Flickable {
                    x: 10px; y: 7px; width: parent.width - 20px; height: parent.height - 14px;
                    interactive: false;
                    content-height: max(self.height, body.preferred-height);
                    body := TextInput {
                        width: parent.width;
                        text <=> Desk.pr-body;
                        wrap: word-wrap;
                        single-line: false;
                        font-size: 12.5px;
                        color: #f6f2ff;
                        accessible-role: text-input;
                        accessible-id: "prBody";
                        accessible-label: "Description";
                        edited => { Desk.pr-edited(); }
                        cursor-position-changed(c) => { bfl.content-y = Follow.y(bfl.content-y, bfl.height, c.y, self.font-size); }
                    }
                }
            }
        }
        HorizontalLayout { spacing: 8px;
            if Desk.pr-new-branch: DField { id: "prBranch"; label: "New branch"; placeholder: "hover/my-change"; value <=> Desk.pr-branch; edited => { Desk.pr-edited(); } }
            DField { id: "prBase"; label: "Into"; value <=> Desk.pr-base; edited => { Desk.pr-edited(); } } }
        if Desk.pr-can-commit: DCheck { id: "prCommit"; checked <=> Desk.pr-commit; label: Desk.pr-commit-label; toggled => { Desk.pr-edited(); } }
        DCheck { id: "prDraft"; checked <=> Desk.pr-draft; label: "Open as a draft"; toggled => { Desk.pr-edited(); } }

        if Desk.pr-error != "": Rectangle {
            height: pe.preferred-height; border-radius: 8px; background: #ff453a1a;
            pe := VerticalLayout { padding: 7px; padding-left: 10px; padding-right: 10px; spacing: 2px;
                Text { text: Desk.pr-error; font-size: 12px; color: #ffb0aa; wrap: word-wrap; }
                if Desk.pr-steps != "": Text { text: "Done before it: " + Desk.pr-steps + "."; font-size: 12px; color: #ffb0aab3; wrap: word-wrap; } }
        }
        HorizontalLayout { spacing: 10px; alignment: start;
            DButton { id: "prCreate"; primary: true; icon: DeskIcons.pr; text: Desk.pr-creating ? "Opening…" : "Create pull request"; enabled: !Desk.pr-creating && Desk.pr-blocked == "" && Desk.pr-title != "";
                clicked => { Desk.pr-create(); } }
            VerticalLayout { alignment: center; Text { text: "Pushes the branch, then opens it with gh."; font-size: 11.5px; color: #f6f2ff61; } } }
    }
}

component Tab inherits Rectangle {
    in property <DTab> t;
    in property <bool> on;
    callback clicked;
    height: 30px;
    border-radius: 8px;
    background: on ? #ffffff1a : ta.has-hover && t.enabled ? #ffffff0f : transparent;
    accessible-role: tab;
    accessible-id: "dtab-" + t.id;
    accessible-label: t.enabled ? t.title : t.title + ". " + t.reason;
    accessible-item-selectable: true;
    accessible-item-selected: on;
    accessible-action-default => { clicked(); }
    Icon { name: DeskIcons.of(t.icon); size: 16px; tint: on ? white : t.enabled ? #f6f2ff9e : #f6f2ff38; }
    if t.badge > 0: Rectangle { x: parent.width / 2 + 2px; y: 1px; width: max(14px, bt.preferred-width + 6px); height: 14px; border-radius: 7px; background: #3b82f6;
        bt := Text { text: "" + t.badge; font-size: 9px; font-weight: 600; color: white; horizontal-alignment: center; vertical-alignment: center; } }
    if t.live: Rectangle { x: parent.width / 2 + 5px; y: 5px; width: 7px; height: 7px; border-radius: 3.5px; background: #ff453a; }
    ta := TouchArea { mouse-cursor: t.enabled ? pointer : default; clicked => { root.clicked(); } }
}

// The panel's inside, under its header: the eight tabs, then the one shown.
export component DeskBody inherits VerticalLayout {
    // The tabs.
    Rectangle {
        vertical-stretch: 0;
        height: 46px;
        HorizontalLayout { padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; spacing: 2px;
            for t[i] in Desk.tabs: Tab { horizontal-stretch: 1; t: t; on: Desk.tab == i; clicked => { Desk.pick-tab(i); } } }
    }
    Rectangle {
        vertical-stretch: 1;
        // Browser.
        if Desk.tab == 0: VerticalLayout { padding-left: 10px; padding-right: 10px; padding-bottom: 12px; BrowserBody { } }
        // Screen.
        if Desk.tab == 7: VerticalLayout { padding-left: 10px; padding-right: 10px; padding-bottom: 12px; ScreenBody { } }
        // Pull request: the setup, or the form.
        if Desk.tab == 4 && Desk.pr-mode == 1: VerticalLayout { padding-left: 10px; padding-right: 10px; padding-bottom: 12px; GhSetup { } }
        if Desk.tab == 4 && Desk.pr-mode == 2: VerticalLayout { padding-left: 10px; padding-right: 0px; padding-bottom: 12px; PrForm { } }
        // The lists.
        if Desk.tab != 0 && Desk.tab != 7 && !(Desk.tab == 4 && Desk.pr-mode != 0): VerticalLayout {
            padding-left: 10px; padding-right: 4px; padding-bottom: 12px; spacing: 6px;
            if Desk.tab == 2 && !Desk.file-open: Rectangle {
                vertical-stretch: 0;
                height: 34px; border-radius: 10px; background: #1b181e; border-width: 1px; border-color: ff.has-focus ? #ffffff38 : #ffffff12;
                Icon { x: 10px; name: DeskIcons.search; size: 14px; tint: #f6f2ff61; }
                ff := TextInput { x: 32px; width: parent.width - 42px; text <=> Desk.find; font-size: 12.5px; color: #f6f2ff; vertical-alignment: center;
                    accessible-role: text-input; accessible-id: "fFind"; accessible-label: "Find a file"; edited => { Desk.find-edited(self.text); } }
                if Desk.find == "": Text { x: 32px; text: "Find a file"; font-size: 12.5px; color: #f6f2ff61; vertical-alignment: center; }
            }
            Rectangle {
                vertical-stretch: 1;
                if Desk.rows.length > 0: DeskList { act(a) => { Desk.act(a); } }
                if Desk.rows.length == 0: DeskEmpty { }
            }
        }
    }
}

// The card's eight tiles, in a grid of four: the icon and the title on a line, what the
// surface holds under it. A short office (tight) keeps only the line.
export component DeskTiles inherits Rectangle {
    in property <bool> tight;
    property <length> th: tight ? 26px : 36px;
    height: 2 * th + 4px;
    for t[i] in Desk.tiles: Rectangle {
        x: mod(i, 4) * (parent.width + 4px) / 4;
        y: floor(i / 4) * (th + 4px);
        width: (parent.width - 12px) / 4;
        height: th;
        border-radius: 9px;
        background: ta.has-hover && t.enabled ? Desk.c-color.with-alpha(0.2) : t.enabled ? #ffffff0b : #ffffff07;
        border-width: 1px;
        border-color: t.live ? #ff453a59 : ta.has-hover && t.enabled ? Desk.c-color.with-alpha(0.4) : #ffffff0d;
        accessible-role: button;
        accessible-id: "dtile-" + t.id;
        accessible-label: t.enabled ? t.title + " (" + t.letter + "). " + t.detail : t.title + ". " + t.reason;
        accessible-enabled: t.enabled;
        accessible-action-default => { Desk.card-tile(t.id); }
        VerticalLayout {
            alignment: center;
            padding-left: 7px; padding-right: 5px; spacing: 1px;
            HorizontalLayout { height: 15px; spacing: 5px;
                Rectangle { width: 14px;
                    Icon { x: 0px; name: DeskIcons.of(t.icon); size: 14px; tint: t.enabled ? #ececf0e6 : #ececf061; }
                    if t.badge > 0: Rectangle { x: 9px; y: -6px; width: max(14px, bb.preferred-width + 6px); height: 14px; border-radius: 7px; background: #3b82f6;
                        bb := Text { text: "" + t.badge; font-size: 9px; font-weight: 600; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                    if t.live: Rectangle { x: 10px; y: -2px; width: 6px; height: 6px; border-radius: 3px; background: #ff453a; }
                }
                Text { text: t.title == "Linked pull requests" ? "Linked PRs" : t.title; font-size: 11px; font-weight: 600; color: t.enabled ? #ececf0 : #ececf061; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
            if !tight: Text { text: t.enabled ? t.detail : t.reason; font-size: 11px; font-weight: 500; color: #ececf073; overflow: elide; }
        }
        ta := TouchArea { mouse-cursor: t.enabled ? pointer : default; clicked => { Desk.card-tile(t.id); } }
    }
}