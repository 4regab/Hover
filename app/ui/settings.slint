// Owl/Pages.cs's SettingsPage, drawn from the blocks pages.rs builds: a 196 px sidebar
// card of the five sections beside one scrolling pane of grouped rows.

import { Pal, Fonts, Icon, Icons, PillButton, Switch, Segments, Slider, Ring, Tile, TextField, HoldButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { Mark } from "marks.slint";

export struct Opt { label: string, on: bool }
export struct Btn { id: string, text: string, red: bool }

// One row. control: 0 none, 1 switch, 2 button, 3 shortcut, 4 segments, 5 picker, 6 text,
// 7 text box, 8 badges and buttons (open: the row opens that id), 9 hold button, 10 slider (picked is its
// value, lo to hi; its new value goes out through picked-seg).
// lead: 0 none, 1 tile, 2 ring, 3 letter tile, 4 a tool's own mark (tool). progress: 0..1 under the sub, -1 none.
export struct RowData {
    label: string, sub: string, sub-id: string, enabled: bool,
    control: int, id: string, name: string, text: string, on: bool, button-enabled: bool,
    labels: [string], longest: string, picked: int, lo: int, hi: int, options: [Opt],
    lead: int, icon: string, tint: color, ring: float, tool: string,
    placeholder: string, secret: bool, badges: [Opt], buttons: [Btn], open: string, progress: float, letter: string,
}

export struct TileData {
    id: string, name: string, from: string, picked: bool,
    panel: color, surface: color, ink: color, ink-dim: color, blue: color,
    green: color, orange: color, red: color, purple: color, teal: color,
}

// Settings → Kiro's credits (pages.rs CreditsCard). A bar's hover and outside are 0..1 of
// the chart's top; month-progress is -1 with no month; range is the picked segment.
export struct CreditBar { label: string, hover: float, outside: float, partial: bool, tip: string }
export struct TopRow { title: string, folder: string, credits: string }
export struct CreditsData {
    id: string, range: int, labels: [string], longest: string,
    today: string, today-sub: string, week: string, week-sub: string,
    month-title: string, month: string, month-progress: float, month-pct: string, month-sub: string,
    bars: [CreditBar], y-top: string, y-mid: string, empty: string,
    top: [TopRow], top-empty: string, note: string, label: string,
}

// kind: 0 title (first: a lead line follows), 1 heading, 2 group, 3 footnote, 4 tiles,
// 5 link, 6 lead line, 7 Kiro's credits (credits).
export struct Block {
    kind: int, text: string, first: bool, rows: [RowData], tiles: [TileData],
    id: string, name: string, icon: string, dim: bool, status: string, credits: CreditsData,
}

export struct Side { title: string, icon: string, tint: color, tool: string }

// Ui.Text's 11.5 px dim line, wrapped.
component Sub inherits Text {
    font-size: 11.5px;
    color: Pal.ink-dim;
    wrap: word-wrap;
}

component SidebarItem inherits Rectangle {
    in property <Side> item;
    in property <bool> picked;
    in property <string> id;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: picked ? Pal.blue : ta.has-hover ? Pal.row-hover : transparent;
    accessible-role: tab;
    accessible-id: id;
    accessible-label: item.title;
    accessible-item-selectable: true;
    accessible-item-selected: picked;
    accessible-action-default => { clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 10px;
        if item.tool == "": Tile { icon: item.icon; tint: item.tint; }
        if item.tool != "": Mark { tool: item.tool; width: 24px; height: 24px; }
        Text { text: item.title; font-size: 13px; color: picked ? white : Pal.ink; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// The theme preview: the panel, a card with a title and two lines, and five accents;
// ringed in blue when it is the one in use (Pages.ThemeTile).
component ThemeTile inherits Rectangle {
    in property <TileData> t;
    callback clicked;
    width: 160px;
    height: 136px;
    border-radius: 12px;
    background: ta.has-hover ? Pal.ink.with-alpha(0.08) : transparent;
    accessible-role: button;
    accessible-id: t.id;
    accessible-label: t.name;
    accessible-action-default => { clicked(); }
    Rectangle {
        x: 5px; y: 5px; width: 150px; height: 86px;
        border-radius: 12px;
        background: t.panel;
        border-width: t.picked ? 2.5px : 1px;
        border-color: t.picked ? Pal.blue : Pal.separator;
        Rectangle {
            x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
            border-radius: 7px;
            background: t.surface;
            Rectangle { x: 9px; y: 8px; width: 9px; height: 9px; border-radius: 4.5px; background: t.blue; }
            Rectangle { x: 23px; y: 10.5px; width: 46px; height: 4px; border-radius: 2px; background: t.ink; }
            Rectangle { x: 9px; y: 25px; width: 74px; height: 4px; border-radius: 2px; background: t.ink-dim; }
            Rectangle { x: 9px; y: 34px; width: 54px; height: 4px; border-radius: 2px; background: t.ink-dim; }
            for c[i] in [t.green, t.orange, t.red, t.purple, t.teal]: Rectangle {
                x: 9px + i * 11px; y: 46px; width: 7px; height: 7px; border-radius: 3.5px; background: c;
            }
        }
    }
    Text { x: 8px; y: 97px; width: 144px; text: t.name; font-size: 12.5px; color: Pal.ink; font-weight: t.picked ? 600 : 400; overflow: elide; }
    Text { x: 8px; y: 114px; width: 144px; text: t.from; font-size: 11px; color: Pal.ink-dim; overflow: elide; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

component RowView inherits Rectangle {
    in property <RowData> r;
    in property <bool> recording;
    in property <int> index;
    callback toggled(string, bool);
    callback pressed(string);
    callback picked-seg(string, int);
    callback open-picker(string, length, length);
    callback record;
    callback chord(KeyEvent) -> bool;
    // Its own height, so the page's layout takes it as it is: measured from outside, a
    // row came out short and the rows were squeezed to fit.
    height: max(42px, layout.preferred-height);
    opacity: r.enabled ? 1 : 0.4;
    // A row that opens a page (a project): all of it is the button, behind its contents.
    if r.open != "": Rectangle {
        width: 100%;
        height: 100%;
        background: ota.has-hover ? Pal.ink.with-alpha(0.03) : transparent;
        accessible-role: button;
        accessible-id: r.open;
        accessible-label: r.label;
        accessible-action-default => { pressed(r.open); }
        ota := TouchArea { mouse-cursor: pointer; clicked => { pressed(r.open); } }
        ofs := FocusScope {
            focus-on-click: false;
            key-pressed(e) => { if (e.text == " " || e.text == "\n") { pressed(r.open); return accept; } reject }
        }
        Rectangle { border-radius: 8px; border-width: ofs.has-focus ? 2px : 0; border-color: Pal.blue.with-alpha(0.7); }
    }
    layout := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 0;
        if r.lead == 1: VerticalLayout { alignment: center; padding-right: 10px; Tile { icon: r.icon; tint: r.tint; } }
        if r.lead == 2: VerticalLayout { alignment: center; padding-left: 2px; padding-right: 12px; Ring { width: 20px; height: 20px; stroke: 2.5px; value: r.ring; } }
        if r.lead == 3: VerticalLayout {
            alignment: center;
            padding-right: 10px;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 7px;
                background: r.tint;
                Text { text: r.letter; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if r.lead == 4: VerticalLayout { alignment: center; padding-right: 10px; Mark { tool: r.tool; width: 24px; height: 24px; } }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: r.label; font-size: 13px; color: Pal.ink; overflow: elide; }
            if r.sub != "": Sub { text: r.sub; accessible-id: r.sub-id; }
            if r.progress >= 0: VerticalLayout {
                padding-top: 4px;
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Pal.wash-strong;
                    accessible-role: progress-indicator;
                    accessible-value: round(r.progress * 100) + "%";
                    Rectangle { x: 0; width: parent.width * r.progress; border-radius: 2px; background: Pal.blue; }
                }
            }
        }
        if r.control != 0: VerticalLayout {
            alignment: center;
            padding-left: 12px;
            // As wide as its control: a row without a sub line would hand it the slack.
            horizontal-stretch: 0;
            if r.control == 1: Switch { id: r.id; label: r.name; on: r.on; enabled: r.enabled; toggled(v) => { toggled(r.id, v); } }
            if r.control == 2: PillButton { id: r.id; label: r.name; text: r.text; enabled: r.enabled && r.button-enabled; clicked => { pressed(r.id); } }
            if r.control == 3: shortcut := PillButton {
                id: r.id;
                label: r.name;
                text: r.text;
                min-width: 96px;
                bold-text: true;
                // The notch's records through record(); any other shortcut asks by its id.
                clicked => { if (r.id == "WorkspaceShortcut") { record(); } else { pressed(r.id); } keys.focus(); }
                keys := FocusScope {
                    // Over the button: the click starts recording and focuses it.
                    focus-on-click: false;
                    key-pressed(e) => { if (recording) { return chord(e) ? accept : reject; } reject }
                    focus-changed-event => { if (!self.has-focus && recording) { root.record(); } }
                }
            }
            if r.control == 10: HorizontalLayout {
                spacing: 10px;
                sl := Slider { id: r.id; label: r.name; lo: r.lo; hi: r.hi; value: r.picked; enabled: r.enabled; picked(v) => { picked-seg(r.id, v); } }
                Text { width: 44px; text: sl.shown + " %"; font-size: 12.5px; color: Pal.ink; vertical-alignment: center; horizontal-alignment: right; }
            }
            if r.control == 4: Segments { id: r.id; labels: r.labels; longest: r.longest; picked: r.picked; enabled: r.enabled; pick(i) => { picked-seg(r.id, i); } }
            if r.control == 5: pk := PillButton {
                id: r.id;
                label: r.name + ": " + r.text;
                text: r.text;
                chevron: true;
                pad-x: 12px;
                pad-y: 4px;
                font-size: 12.5px;
                enabled: r.enabled;
                clicked => { open-picker(r.id, self.absolute-position.x, self.absolute-position.y + self.height); }
            }
            if r.control == 6: Text { text: r.text; font-size: 12.5px; color: Pal.ink-dim; }
            // A box's new value comes back as "{id}\u{1f}{value}" through pressed (the
            // page's one string callback); a key's Remove sends an empty value.
            if r.control == 7: HorizontalLayout {
                spacing: 8px;
                TextField {
                    id: r.id;
                    label: r.name;
                    value: r.text;
                    placeholder: r.placeholder;
                    secret: r.secret;
                    enabled: r.enabled;
                    commit(v) => { pressed(r.id + "\u{1f}" + v); }
                }
                if r.secret && r.on: PillButton {
                    id: r.id + "Remove";
                    label: "Remove key";
                    text: "Remove key";
                    bg: transparent;
                    fg: Pal.red;
                    pad-x: 4px;
                    pad-y: 3px;
                    font-size: 12.5px;
                    clicked => { pressed(r.id + "\u{1f}"); }
                }
            }
            if r.control == 8: HorizontalLayout {
                spacing: 6px;
                for g in r.badges: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: bt.preferred-width + 14px;
                        border-radius: 5px;
                        background: g.on ? #ff9f0a26 : Pal.ink.with-alpha(0.07);
                        bt := Text { text: g.label; font-size: 11px; color: g.on ? #ffb340 : Pal.ink-dim; }
                    }
                }
                for btn in r.buttons: PillButton {
                    id: btn.id;
                    text: btn.text;
                    fg: btn.red ? Pal.red : Pal.ink;
                    pad-x: 10px;
                    pad-y: 3px;
                    font-size: 12.5px;
                    enabled: r.enabled;
                    clicked => { pressed(btn.id); }
                }
                if r.open != "": VerticalLayout { alignment: center; padding-left: 2px; Icon { name: Icons.chevron-right; size: 12px; tint: Pal.ink-faint; } }
            }
            if r.control == 9: HoldButton {
                id: r.id;
                label: r.name;
                text: r.text;
                icon: r.icon;
                enabled: r.enabled;
                press => { pressed(r.id + ".press"); }
                release => { pressed(r.id + ".release"); }
            }
        }
    }
}

// One figure of the credits' summary: what it is, the number, and a dim line.
component Figure inherits VerticalLayout {
    in property <string> title;
    in property <string> value;
    in property <string> sub;
    spacing: 1px;
    Text { text: title; font-size: 11.5px; color: Pal.ink-dim; overflow: elide; }
    Text { text: value; font-size: 22px; font-weight: 600; font-family: Fonts.display; color: Pal.ink; }
    Text { text: sub; font-size: 11.5px; color: Pal.ink-dim; overflow: elide; }
}

// A legend's swatch: Hover's solid blue, Outside's tint, a partial day's fainter one.
component Swatch inherits Rectangle {
    in property <bool> outside;
    in property <bool> partial;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: !outside ? Pal.blue : partial ? Pal.blue.with-alpha(0.14) : Pal.blue.with-alpha(0.38);
    border-width: partial ? 1px : 0;
    border-color: Pal.blue.with-alpha(0.55);
}

// Settings → Kiro's credits: the heading with its range, the card (summary, the chart
// of Hover's and the outside credits by day, today's dearest sessions) and the note.
component CreditsCard inherits VerticalLayout {
    in property <CreditsData> c;
    callback pick(int);
    padding-bottom: 6px;
    HorizontalLayout {
        padding-left: 12px;
        padding-top: 10px;
        padding-bottom: 6px;
        Text { text: "CREDITS"; font-size: 10.5px; font-weight: 600; color: Pal.ink-dim; vertical-alignment: bottom; horizontal-stretch: 1; }
        Segments { id: c.id; labels: c.labels; longest: c.longest; picked: c.range; pick(i) => { pick(i); } }
    }
    Rectangle {
        border-radius: 12px;
        background: Pal.surface;
        clip: true;
        VerticalLayout {
            HorizontalLayout {
                padding: 12px;
                spacing: 18px;
                // Widths by stretch alone (1 : 1 : 2), so a column doesn't move when its number does.
                Figure { title: "Today"; value: c.today; sub: c.today-sub; horizontal-stretch: 1; preferred-width: 0; min-width: 0; }
                Figure { title: "Last 7 days"; value: c.week; sub: c.week-sub; horizontal-stretch: 1; preferred-width: 0; min-width: 0; }
                VerticalLayout {
                    horizontal-stretch: 2;
                    preferred-width: 0;
                    min-width: 0;
                    spacing: 1px;
                    Text { text: c.month-title; font-size: 11.5px; color: Pal.ink-dim; overflow: elide; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: c.month; font-size: 22px; font-weight: 600; font-family: Fonts.display; color: Pal.ink; }
                        if c.month-progress >= 0: VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: Pal.wash-strong;
                                accessible-role: progress-indicator;
                                accessible-value: c.month-pct;
                                Rectangle { x: 0; width: parent.width * c.month-progress; border-radius: 2px; background: Pal.blue; }
                            }
                        }
                        if c.month-progress >= 0: Text { text: c.month-pct; font-size: 12.5px; color: Pal.ink; vertical-alignment: center; }
                    }
                    Text { text: c.month-sub; font-size: 11.5px; color: Pal.ink-dim; overflow: elide; }
                }
            }
            HorizontalLayout { padding-left: 12px; Rectangle { height: 1px; background: Pal.separator; } }
            chart := Rectangle {
                height: 150px;
                accessible-role: text;
                accessible-label: c.label;
                property <length> pad-l: 40px;
                property <length> pad-r: 14px;
                property <length> pad-t: 14px;
                property <length> pad-b: 30px;
                property <length> plot-w: self.width - pad-l - pad-r;
                property <length> plot-h: self.height - pad-t - pad-b;
                property <length> slot: plot-w / max(1, c.bars.length);
                property <length> bar-w: min(22px, slot * 0.62);
                // The bar under the pointer, from where it is across the plot.
                property <int> hot: ta.has-hover && ta.mouse-x >= pad-l && ta.mouse-x < pad-l + plot-w ? floor((ta.mouse-x - pad-l) / slot) : -1;
                out property <string> tip: hot >= 0 && hot < c.bars.length ? c.bars[hot].tip : "";
                // The axis: 0, half and the top, with faint lines across.
                for y[k] in [0, 0.5, 1]: Rectangle {
                    Rectangle { x: pad-l - 4px; y: pad-t + plot-h * (1 - y); width: plot-w + 4px; height: 1px; background: k == 0 ? Pal.separator : Pal.separator.with-alpha(0.35); }
                    Text {
                        x: 0; y: pad-t + plot-h * (1 - y) - 7px; width: pad-l - 10px; height: 14px;
                        text: k == 0 ? "0" : k == 1 ? c.y-mid : c.y-top;
                        font-size: 10px; color: Pal.ink-dim; horizontal-alignment: right; vertical-alignment: center;
                    }
                }
                if hot >= 0: Rectangle { x: pad-l + hot * slot; y: pad-t; width: slot; height: plot-h; border-radius: 4px; background: Pal.ink.with-alpha(0.05); }
                for b[i] in c.bars: Rectangle {
                    property <length> hover-h: b.hover > 0 ? max(2px, chart.plot-h * b.hover) : 0;
                    property <length> outside-h: b.outside > 0 ? max(2px, chart.plot-h * b.outside) : 0;
                    x: chart.pad-l + i * chart.slot + (chart.slot - chart.bar-w) / 2;
                    y: 0;
                    width: chart.bar-w;
                    height: chart.height;
                    Rectangle {
                        y: chart.pad-t + chart.plot-h - hover-h - outside-h; height: outside-h;
                        border-radius: 2px;
                        background: b.partial ? Pal.blue.with-alpha(0.14) : Pal.blue.with-alpha(0.38);
                        border-width: b.partial ? 1px : 0;
                        border-color: Pal.blue.with-alpha(0.55);
                    }
                    Rectangle { y: chart.pad-t + chart.plot-h - hover-h; height: hover-h; border-radius: 2px; background: Pal.blue; }
                    if b.label != "": Text {
                        x: (parent.width - 44px) / 2; y: chart.pad-t + chart.plot-h + 5px; width: 44px;
                        text: b.label; font-size: 10px; color: Pal.ink-dim; horizontal-alignment: center;
                    }
                }
                if c.empty != "": Text {
                    x: pad-l; y: pad-t; width: plot-w; height: plot-h;
                    text: c.empty; font-size: 12px; color: Pal.ink-dim; horizontal-alignment: center; vertical-alignment: center;
                }
                ta := TouchArea { }
            }
            // The legend, or the day under the pointer.
            HorizontalLayout {
                padding-left: chart.pad-l;
                padding-right: 12px;
                padding-bottom: 10px;
                height: 26px;
                spacing: 6px;
                if chart.tip != "": Text { text: chart.tip; font-size: 11.5px; color: Pal.ink; vertical-alignment: center; overflow: elide; }
                if chart.tip == "": HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout { alignment: center; Swatch { } }
                    Text { text: "Hover"; font-size: 11.5px; color: Pal.ink-dim; vertical-alignment: center; }
                    Rectangle { width: 8px; }
                    VerticalLayout { alignment: center; Swatch { outside: true; } }
                    Text { text: "Outside"; font-size: 11.5px; color: Pal.ink-dim; vertical-alignment: center; }
                    Rectangle { width: 8px; }
                    VerticalLayout { alignment: center; Swatch { outside: true; partial: true; } }
                    Text { text: "Partial day"; font-size: 11.5px; color: Pal.ink-dim; vertical-alignment: center; }
                }
            }
            HorizontalLayout { padding-left: 12px; Rectangle { height: 1px; background: Pal.separator; } }
            VerticalLayout {
                padding: 12px;
                padding-top: 9px;
                spacing: 6px;
                Text { text: "Today’s top sessions"; font-size: 11.5px; color: Pal.ink-dim; }
                for t in c.top: HorizontalLayout {
                    spacing: 12px;
                    Text { text: t.title; font-size: 13px; color: Pal.ink; overflow: elide; horizontal-stretch: 3; }
                    Text { text: t.folder; font-size: 12px; color: Pal.ink-dim; overflow: elide; horizontal-stretch: 2; }
                    Text { text: t.credits; font-size: 12.5px; color: Pal.ink; horizontal-alignment: right; min-width: 90px; }
                }
                if c.top-empty != "": Sub { text: c.top-empty; }
            }
        }
    }
    if c.note != "": HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        Sub { text: c.note; }
    }
}

export component SettingsPage inherits Rectangle {
    in property <[Side]> sections;
    in property <int> current;
    in property <[Block]> blocks;
    in property <bool> recording;
    in-out property <length> scroll-y;
    callback section(int);
    callback toggled(string, bool);
    callback pressed(string);
    callback picked-seg(string, int);
    callback open-picker(string, length, length);
    callback tile(string);
    callback record;
    callback chord(KeyEvent) -> bool;
    // Another section opens at its top: it kept the last one's scroll, and a long page
    // (Kiro's) left a short one opened part way down, or past its end.
    changed current => { scroll-y = 0; }

    // Margin 10,0,10,10 around the grid; the sidebar card, 8 between, the pane.
    Rectangle {
        x: 10px;
        y: 0;
        width: 196px;
        height: parent.height - 10px;
        border-radius: 22px;
        background: Pal.surface;
        clip: true;
        // Nine sections don't fit a Small office (or a short window): the list scrolls.
        side := ScrollView {
            width: parent.width;
            height: parent.height;
            content-width: self.visible-width;
            content-height: list.preferred-height;
            // The picked section stays in view (opened from elsewhere, it may be below).
            function reveal() {
                let top = 8px + current * 34px;
                if (top + 34px + 8px > -self.content-y + self.visible-height) { self.content-y = min(0px, self.visible-height - top - 34px - 8px); }
                if (top - 8px < -self.content-y) { self.content-y = min(0px, 8px - top); }
            }
            property <int> at: current;
            changed at => { self.reveal(); }
            changed visible-height => { self.reveal(); }
            init => { self.reveal(); }
            list := VerticalLayout {
                width: side.visible-width;
                padding: 8px;
                alignment: start;
                for s[i] in sections: SidebarItem {
                    item: s;
                    id: "Section" + s.title;
                    picked: i == current;
                    clicked => { section(i); }
                }
            }
        }
    }
    pane := ScrollView {
        x: 214px;
        y: 0;
        width: parent.width - 224px;
        height: parent.height - 10px;
        content-y <=> scroll-y;
        content-width: self.visible-width;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: pane.visible-width;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            padding-bottom: 18px;
            // A repeated cell measures its wrapped lines at its one-line width (Slint
            // 1.18), so each block is told the width it gets: the column less its padding.
            for b in blocks: VerticalLayout {
                preferred-width: pane.visible-width - 28px;
                if b.kind == 0: Text { text: b.text; font-size: 20px; font-weight: 600; font-family: Fonts.display; color: Pal.ink; accessible-role: text; }
                if b.kind == 0: Rectangle { height: b.first ? 4px : 14px; }
                if b.kind == 6: HorizontalLayout {
                    padding-bottom: 14px;
                    Text { text: b.text; font-size: 12px; color: Pal.ink-dim; wrap: word-wrap; }
                }
                if b.kind == 1: HorizontalLayout {
                    padding-left: 12px;
                    padding-top: b.first ? 4px : 10px;
                    padding-bottom: 6px;
                    Text { text: b.text; font-size: 10.5px; font-weight: 600; color: Pal.ink-dim; }
                }
                if b.kind == 2: VerticalLayout {
                    padding-bottom: 6px;
                    Rectangle {
                        border-radius: 12px;
                        background: Pal.surface;
                        // A whole-row button's hover stays inside the rounded corners.
                        clip: true;
                        VerticalLayout {
                            for r[i] in b.rows: VerticalLayout {
                                if i > 0: HorizontalLayout { padding-left: 12px; Rectangle { height: 1px; background: Pal.separator; } }
                                RowView {
                                    r: r;
                                    index: i;
                                    recording: root.recording;
                                    toggled(id, v) => { root.toggled(id, v); }
                                    pressed(id) => { root.pressed(id); }
                                    picked-seg(id, n) => { root.picked-seg(id, n); }
                                    open-picker(id, x, y) => { root.open-picker(id, x, y); }
                                    record => { root.record(); }
                                    chord(e) => { root.chord(e) }
                                }
                            }
                        }
                    }
                }
                if b.kind == 7: CreditsCard { c: b.credits; pick(i) => { root.picked-seg(b.credits.id, i); } }
                if b.kind == 3: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 18px;
                    Sub { text: b.text; }
                }
                // A WrapPanel of 160 px tiles, 4 apart: as many a line as fit.
                if b.kind == 4: Rectangle {
                    property <int> per: max(1, floor((pane.visible-width - 32px) / 164px));
                    height: ceil(b.tiles.length / per) * 140px + 4px;
                    for t[i] in b.tiles: ThemeTile {
                        x: 4px + mod(i, per) * 164px;
                        y: floor(i / per) * 140px;
                        t: t;
                        clicked => { root.tile(t.id); }
                    }
                }
                if b.kind == 5: HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 4px;
                    alignment: start;
                    spacing: 8px;
                    PillButton {
                        id: b.id;
                        label: b.name;
                        text: b.text;
                        icon: b.icon;
                        bg: transparent;
                        fg: b.dim ? Pal.ink-dim : Pal.blue;
                        pad-x: 6px;
                        pad-y: 3px;
                        font-size: 12px;
                        clicked => { root.pressed(b.id); }
                    }
                    if b.status != "": Sub { text: b.status; vertical-alignment: center; }
                }
            }
        }
    }
}
