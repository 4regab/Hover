// Hover's windows: the notch (Notch.cs NotchShell and NotchHost's resting shapes), the
// dashboard (DashboardWindow) and the shortcut's warning (App.ShowHotKeyWarning).

import { Pal, Fonts, Icon, Icons, PillButton, Ring } from "widgets.slint";
import { LiveMark, MarkStack, StackMark, Mark, Arc } from "marks.slint";
import { OfficeView, Page, Office, Backdrop, Side, Block, Opt, TagData, ToolData, PanelRow, MOpt } from "office.slint";
import { Desk, DTile, DStep, DTab, DPage, DRow } from "desk.slint";
export { Pal, Page, Office, Backdrop, Side, Block, Opt, TagData, ToolData, PanelRow, StackMark, Desk, DTile, DStep, DTab, DPage, DRow }

// A quota on the island: its ring, the number and whether it has a % after it, and
// whether it is the dim one of a failed read.
export struct QuotaItem { id: string, name: string, ring: float, value: string, pct: bool, dim: bool }

// The question in the notch's card (NotchHost.Card): what it wants, where, and the
// buttons' words.
// A line of a change: 1 added, -1 removed, 0 context.
export struct PreviewLine { text: string, kind: int }
export struct CardData { tool: string, title: string, sub: string, count: string, command: string, path: string, preview: [PreviewLine], reason: string, danger: bool, allow: string }

// Voice's card in the notch (voice_ui.rs). kind: 1 listening, 2 working on what was
// said, 3 the preview (counting down, edited, starting), 4 pick an agent, 5 started,
// 6 cancelled, 7 an error. words: the line it shows; sub: the one under it (the time
// while listening). ring: the countdown left, 0 to 100, or -1. agent: the tool's name,
// model: its model's (the pill names only the model, as the new-task box's).
export struct VoiceCard {
    kind: int, words: string, sub: string, heard: string, note: string,
    target: string, folder: string, letter: string, tint: color, home: bool,
    tool: string, agent: string, model: string, access: string, full: bool, task: string,
    ring: float, start: string, can-start: bool, starting: bool, retry: bool, settings: bool,
}
export struct VoiceTool { id: string, name: string }

// A key's name on a voice button (the mockup's kbd): mono and faint.
component Kbd inherits Text { font-family: "DejaVu Sans Mono"; font-size: 10px; font-weight: 600; opacity: 0.5; vertical-alignment: center; }

// The voice card's buttons (.nbtn): 28 high, radius 9. The light one is Start, with
// the countdown's ring in it.
component VBtn inherits Rectangle {
    in property <string> text;
    in property <string> key;
    in property <bool> light;
    in property <bool> enabled: true;
    in property <float> ring: -1;
    callback clicked;
    property <color> ink: light ? #131116 : white;
    height: 28px;
    min-width: row.preferred-width;
    border-radius: 9px;
    background: light ? (ta.has-hover && enabled ? #ffffff : #f6f2ff) : (ta.has-hover ? #ffffff1c : #ffffff10);
    opacity: enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    HorizontalLayout {
        alignment: center;
        row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            if root.ring >= 0: VerticalLayout { alignment: center; Ring { width: 16px; height: 16px; value: root.ring; stroke: 2.5px; track: #13111633; tint: #131116; } }
            Text { text: root.text; font-size: 12px; font-weight: 600; color: ink; vertical-alignment: center; }
            if root.key != "": Kbd { text: root.key; color: ink; }
        }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The Esc chip (.esc): closes or cancels when clicked.
component EscChip inherits Rectangle {
    callback clicked;
    width: et.preferred-width + 12px;
    height: et.preferred-height + 2px;
    border-radius: 5px;
    border-width: 1px;
    border-color: ta.has-hover ? #ffffff47 : #ffffff24;
    accessible-role: button;
    accessible-label: "Cancel (Esc)";
    accessible-action-default => { clicked(); }
    et := Text { text: "Esc"; font-size: 10.5px; color: #f6f2ff61; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// .npick: the target, the agent or the access on the card, 28 high.
component VPick inherits Rectangle {
    in property <bool> amber;
    height: 28px;
    border-radius: 9px;
    background: amber ? #ffb34014 : #ffffff0f;
}

// The preview's menu rows (the office's MenuRow): an agent with its logo, a model (a
// check on the picked one), or an effort in its row (seg).
component VRow inherits Rectangle {
    in property <string> label;
    in property <string> tool;
    in property <bool> on;
    in property <bool> seg;
    callback clicked;
    height: seg ? 26px : max(28px, rt.preferred-height + 12px);
    border-radius: 8px;
    background: seg ? (on ? #9046ff59 : ta.has-hover ? #ffffff17 : #ffffff0d) : ta.has-hover ? #ffffff17 : transparent;
    accessible-role: list-item;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: on;
    accessible-action-default => { clicked(); }
    HorizontalLayout {
        padding-left: seg ? 0 : 8px;
        padding-right: seg ? 0 : 8px;
        spacing: 8px;
        if tool != "": VerticalLayout { alignment: center; Mark { tool: root.tool; width: 16px; height: 16px; } }
        rt := Text { text: label; font-size: seg ? 11.5px : 12.5px; color: #f6f2ff; vertical-alignment: center; horizontal-alignment: seg ? center : left;
            wrap: word-wrap; horizontal-stretch: 1; }
        if on && !seg: VerticalLayout { alignment: center; Icon { name: Icons.check; size: 12px; tint: #c4a2ff; } }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A pick on the preview that opens its menu (the agent, the model): a chevron after it.
component VMenuPick inherits VPick {
    in property <bool> open;
    in property <bool> enabled: true;
    callback clicked;
    background: (ta.has-hover && enabled) || open ? #ffffff1c : #ffffff0f;
    opacity: enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// .Pressable: 0 plain, 1 primary (light), 2 danger (red). small is the island's.
component Press inherits Rectangle {
    in property <string> text;
    in property <string> key;
    in property <int> kind;
    in property <bool> small;
    in property <length> r-left: small ? 7px : 9px;
    in property <length> r-right: small ? 7px : 9px;
    callback clicked;
    property <color> ink: kind == 1 ? black : white;
    height: small ? 22px : 30px;
    width: row.preferred-width;
    border-top-left-radius: r-left;
    border-bottom-left-radius: r-left;
    border-top-right-radius: r-right;
    border-bottom-right-radius: r-right;
    background: kind == 1 ? (ta.has-hover ? #ffffff : #f2f2f5) : kind == 2 ? (ta.has-hover ? #ff5b51 : #ff453a) : (ta.has-hover ? #ffffff2e : #ffffff1c);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }
    row := HorizontalLayout {
        padding-left: small ? 9px : 12px;
        padding-right: small ? 9px : 12px;
        Text { text: root.text; font-size: small ? 11.5px : 12.5px; font-weight: 600; color: ink; vertical-alignment: center; }
        if key != "": HorizontalLayout { padding-left: 8px;
            VerticalLayout { alignment: center; Rectangle { border-radius: 5px; border-width: 1px; border-color: kind == 1 ? #00000029 : #ffffff24;
                width: kt.preferred-width + 10px; height: kt.preferred-height + 1px;
                kt := Text { text: key; font-family: "DejaVu Sans Mono"; font-size: 10px; color: ink; opacity: 0.7; } } } }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The notch's little clock (Animator): seconds, stepped at 30 fps while something moves.
export global Clock {
    in property <float> t;
    in property <float> done-since: 9;
}

export component NotchWindow inherits Window {
    // The shape, in window DIPs (hover-notch's frame).
    in property <string> shape-commands;
    in property <string> rim-commands;
    in property <length> shape-x;
    in property <length> shape-w;
    in property <length> shape-h;
    in property <length> shape-r;
    in property <color> shape-fill: black;
    in property <float> rim-opacity;
    in property <float> mini-opacity: 1;
    in property <float> view-opacity;
    in property <bool> view-visible;
    // The shape's shadow: off while it opens or closes (notch.rs says why).
    in property <bool> shadow-on: true;
    in property <float> openness;
    in property <length> open-w: 1120px;
    in property <length> open-h: 440px;
    in property <length> rest-w;
    in property <length> rest-h;
    // The camera housing of a Mac's notch (0 elsewhere): the island leaves room for it between its
    // two sides, and the office starts below it.
    in property <length> hw-w;
    in property <length> hw-h;
    // The resting shape: 0 nothing, 1 the island, 2 the question's card.
    in property <int> rest-kind;
    in property <[QuotaItem]> quotas;
    // The one agent segment: 0 none, 1 a question, 2 at work, 3 an end not seen.
    in property <int> seg;
    in property <bool> divider;
    // At work: the stack, and what the one speaking is doing, for how long.
    in property <[StackMark]> stack;
    in property <int> stack-n;
    in property <string> act-verb;
    in property <string> act-obj;
    in property <string> timer;
    in property <string> act-label;
    // Asking: the tool, the words, the command in mono, and "+2" more.
    in property <string> ask-tool;
    in property <string> ask-verb;
    in property <string> ask-obj;
    in property <bool> ask-mono;
    in property <string> ask-more;
    // The agent asks a question (OpenCode's question tool): Deny reads Skip, and Review
    // opens its chat in the office, where its choices are.
    in property <bool> ask-question;
    // Ended: the tool and its badge (1 done, 2 failed, 0 stopped), how it went, the task,
    // how long it took or "+2".
    in property <string> done-tool;
    in property <int> done-badge;
    in property <string> done-verb;
    in property <string> done-title;
    in property <string> done-took;
    in property <CardData> card;
    // The island's glow (amber asking, green or red for an end): transparent for none.
    in property <color> glow: transparent;
    in property <bool> in-settings;
    // New words rise into place (320 ms): Rust sets rise to 0 with no duration, then to
    // 1 with 320 ms. fade is the cross-fade's way in.
    in property <float> rise: 1;
    in property <duration> rise-ms: 0;
    in property <float> fade: 1;
    in property <duration> fade-ms: 0;
    out property <length> pill-width: pill.preferred-width;
    out property <length> card-w: 500px;
    out property <length> card-h: card-l.preferred-height + 26px;
    // Voice's card (rest-kind 3): what it shows, the microphone's level (0 to 1) while
    // listening, the agents to pick from, and a press turned away as busy.
    in property <VoiceCard> voice;
    in property <float> voice-level;
    in property <[VoiceTool]> voice-tools;
    in property <bool> voice-busy;
    // The one-line cards (listening, working on what was said, started, cancelled) are
    // only as wide as their own line: the fixed 440 and 330 left most of the island
    // empty. The old widths stay as the most they may take, so a long line still elides
    // and no card grows past what it used to be.
    out property <length> voice-w: root.voice.kind == 1 || root.voice.kind == 2 ? min(440px, vl.preferred-width)
        : root.voice.kind == 5 || root.voice.kind == 6 ? min(330px, vs.preferred-width)
        : root.voice.kind == 7 ? 420px : 460px;
    out property <length> voice-h: root.voice.kind == 1 || root.voice.kind == 2 ? 52px : root.voice.kind == 5 || root.voice.kind == 6 ? 34px
        : root.voice.kind == 7 ? max(58px, ve.preferred-height) : vc.preferred-height;
    callback voice-start();
    callback voice-cancel();
    callback voice-edit(string);
    callback voice-retry();
    callback voice-pick(string);
    callback voice-settings();
    // The preview's menu (voice_ui.rs): 0 none, 1 the agents ready for this task (in
    // voice-tools), 2 the model, then its effort or variant, as the new-task box's.
    in property <int> voice-menu;
    in property <string> voice-menu-head;
    in property <string> voice-menu-note;
    in property <[MOpt]> voice-mm-models;
    in property <string> voice-mm-effort-head;
    in property <[MOpt]> voice-mm-efforts;
    callback voice-open-menu(int);
    callback voice-pick-model(string);
    callback voice-pick-effort(string);
    public function focus-voice() { voice-keys.focus(); }
    callback deny();
    callback review();
    // The card's answer: allow, trust, trustAll or deny.
    callback answer(string);
    public function focus-card() { card-keys.focus(); }
    callback escape();
    callback shape-pressed();
    callback shape-clicked();
    callback back();
    callback fold();
    // The shortcut opened the notch: the keyboard goes to what is showing (FocusOffice).
    // The view is made only while the office is (Office.built), so it may not be there
    // yet: it takes the keyboard when it is made, or at once when it is.
    in-out property <bool> focus-wanted;
    in-out property <int> focus-asks;
    public function focus-view() { root.focus-wanted = true; root.focus-asks += 1; }

    title: "Hover notch";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    accessible-role: groupbox;
    accessible-id: "HoverNotch";
    default-font-family: Fonts.text;

    // DropShadowEffect: blur 24, depth 4, 50 % in dark; blur 36, depth 10, 22 % in light;
    // at rest a glow instead (blur 26, no depth, 62 %) while it asks or an end is new.
    Rectangle {
        x: root.shape-x;
        y: 0;
        width: root.shape-w;
        height: root.shape-h;
        visible: root.shape-w > 1px && root.shape-h > 1px;
        border-bottom-left-radius: root.shape-r;
        border-bottom-right-radius: root.shape-r;
        background: black;
        drop-shadow-blur: root.glow.alpha > 0 ? 26px : Pal.dark ? 24px : 36px;
        drop-shadow-offset-y: root.glow.alpha > 0 ? 0 : Pal.dark ? 4px : 10px;
        drop-shadow-color: !root.shadow-on ? transparent : root.glow.alpha > 0 ? root.glow.with-alpha(0.62) : Pal.dark ? #00000080 : #00000038;
    }
    Path {
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.shape-commands;
        fill: root.shape-fill;
        stroke: transparent;
    }
    TouchArea {
        x: root.shape-x;
        y: 0;
        width: root.shape-w;
        height: root.shape-h;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.shape-pressed(); } }
        clicked => { root.shape-clicked(); }
    }

    // Mini: laid out at the target rest size, centred, and clipped to the shape as it
    // springs, so the words never reflow.
    Rectangle {
        x: root.shape-x;
        y: 0;
        width: root.shape-w;
        height: root.shape-h;
        clip: true;
        opacity: root.mini-opacity;
        visible: root.mini-opacity > 0;
        Rectangle {
            // The cross-fade's way in, animated on its own (the openness drives the outer one).
            opacity: root.fade;
            animate opacity { duration: root.fade-ms; easing: cubic-bezier(0.25, 0.46, 0.45, 0.94); }
            x: (root.shape-w - root.rest-w) / 2;
            width: root.rest-w;
            height: root.rest-h;
            pill := HorizontalLayout {
                visible: root.rest-kind == 1;
                x: 4px;
                width: self.preferred-width;
                alignment: start;
                spacing: 12px;
                // A question: the tool's breathing mark, what it wants, Deny and Review.
                if root.seg == 1: HorizontalLayout {
                    VerticalLayout { alignment: center; LiveMark { width: 26px; height: 26px; tool: root.ask-tool; ring: 3; ring-color: #ffb340; t: Clock.t; } }
                    Rectangle { width: root.hw-w; }
                    Rectangle { width: 9px; }
                    Text {
                        max-width: 260px;
                        overflow: elide;
                        vertical-alignment: center;
                        text: root.ask-verb;
                        font-size: 12.5px;
                        font-weight: 500;
                        color: #ffffff8c;
                        accessible-role: text;
                        accessible-id: "NotchAsk";
                        accessible-label: root.ask-verb + " " + root.ask-obj;
                    }
                    if root.ask-obj != "": Text { text: " " + root.ask-obj; max-width: 220px; overflow: elide; vertical-alignment: center; color: white; font-weight: 600;
                        font-family: root.ask-mono ? "DejaVu Sans Mono" : Fonts.text; font-size: root.ask-mono ? 12px : 12.5px; }
                    if root.ask-more != "": Text { text: "  " + root.ask-more; vertical-alignment: center; color: #ffffff5c; font-size: 12.5px; font-weight: 500; }
                    Rectangle { width: 11px; }
                    VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: #ffffff2e; } }
                    Rectangle { width: 10px; }
                    VerticalLayout { alignment: center; Press { text: root.ask-question ? "Skip" : "Deny"; small: true; clicked => { root.deny(); } } }
                    Rectangle { width: 6px; }
                    VerticalLayout { alignment: center; Press { text: "Review"; small: true; kind: 1; clicked => { root.review(); } } }
                    Rectangle { width: 3px; }
                }
                // At work: the stack, what the one in front is doing, and for how long.
                if root.seg == 2: HorizontalLayout {
                    VerticalLayout { alignment: center; MarkStack { marks: root.stack; n: root.stack-n; t: Clock.t; } }
                    Rectangle { width: root.hw-w; }
                    Rectangle { width: 9px; }
                    HorizontalLayout {
                        max-width: 300px;
                        opacity: root.rise;
                        y: (1 - root.rise) * 7px;
                        animate opacity { duration: root.rise-ms; }
                        animate y { duration: root.rise-ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                        accessible-role: text;
                        accessible-id: "NotchKiro";
                        accessible-label: root.act-label;
                        Text { text: root.act-verb; font-size: 12.5px; font-weight: 500; color: #ffffff8c; vertical-alignment: center; }
                        if root.act-obj != "": Text { text: " " + root.act-obj; font-size: 12.5px; font-weight: 600; color: white; vertical-alignment: center; overflow: elide; }
                    }
                    Rectangle { width: 9px; }
                    Text { text: root.timer; font-size: 11.5px; font-weight: 500; color: #ffffff8c; vertical-alignment: center; }
                }
                // An end nobody has seen: the tool with its badge, how it went, the task.
                if root.seg == 3: HorizontalLayout {
                    VerticalLayout { alignment: center; LiveMark { width: 18px; height: 18px; tile: 18px; tool: root.done-tool; ring: 0; badge: root.done-badge; } }
                    Rectangle { width: root.hw-w; }
                    Rectangle { width: 9px; }
                    HorizontalLayout {
                        max-width: 280px;
                        opacity: root.rise;
                        y: (1 - root.rise) * 7px;
                        animate opacity { duration: root.rise-ms; }
                        animate y { duration: root.rise-ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                        accessible-role: text;
                        accessible-id: "NotchKiroDone";
                        accessible-label: root.done-verb + " · " + root.done-title;
                        Text { text: root.done-verb + " · "; font-size: 12.5px; font-weight: 500; color: #ffffff8c; vertical-alignment: center; }
                        Text { text: root.done-title; font-size: 12.5px; font-weight: 600; color: white; vertical-alignment: center; overflow: elide; }
                    }
                    Rectangle { width: 9px; }
                    Text { text: root.done-took; font-size: 11.5px; font-weight: 500; color: #ffffff8c; vertical-alignment: center; }
                }
                if root.divider: VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: #ffffff2e; } }
                for q in root.quotas: HorizontalLayout {
                    VerticalLayout { alignment: center; LiveMark { width: 24px; height: 24px; tile: 14px; tool: q.id; ring: 1; value: q.ring; } }
                    Rectangle { width: 5px; }
                    Text {
                        text: q.value;
                        font-size: 11.5px;
                        font-weight: 600;
                        color: q.dim ? #ffffffa6 : white;
                        vertical-alignment: center;
                        accessible-role: text;
                        accessible-id: "NotchQuota" + (q.id == "claude" ? "Claude" : q.id == "kiro" ? "Kiro" : q.id == "codex" ? "Codex" : "Cursor");
                        accessible-label: q.ring >= 0 ? q.name + " " + q.value + "% used" : q.name + " quota";
                    }
                    if q.pct: Text { text: "%"; font-size: 10.5px; font-weight: 600; color: #ffffff5c; vertical-alignment: center; }
                }
            }
            // The question as a card, 500 wide: what it wants, the command or change, why
            // it asks, and Deny (Esc), Trust (Shift+Enter), the allow button (Enter).
            card-keys := FocusScope {
                visible: root.rest-kind == 2;
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.answer("deny"); return accept; }
                    if (e.text == Key.Return && e.modifiers.shift) { root.answer("trust"); return accept; }
                    if (e.text == Key.Return) { root.answer("allow"); return accept; }
                    reject
                }
                card-l := VerticalLayout {
                    x: 14px;
                    y: 12px;
                    width: 472px;
                    height: self.preferred-height;
                    HorizontalLayout {
                        spacing: 0;
                        VerticalLayout { alignment: center; LiveMark { width: 26px; height: 26px; tile: 26px; tool: root.card.tool; ring: 0; } }
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: root.card.title; font-size: 13.5px; font-weight: 600; color: white; overflow: elide; accessible-role: text; accessible-id: "NotchCardTitle"; }
                            Text { text: root.card.sub; font-size: 11.5px; color: #ffffff8c; overflow: elide; }
                        }
                        if root.card.count != "": VerticalLayout { alignment: center; Rectangle { border-radius: 99px; background: #ffffff17; width: cn.preferred-width + 16px; height: cn.preferred-height + 5px;
                            cn := Text { text: root.card.count; font-size: 11px; font-weight: 600; color: #ffffff8c; } } }
                    }
                    Rectangle { height: 11px; }
                    Rectangle {
                        background: #0f0f12;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: root.card.danger ? #ff453a66 : #ffffff17;
                        height: min(pre.preferred-height + 19px, 150px);
                        clip: true;
                        pre := VerticalLayout {
                            x: 12px;
                            y: 9px;
                            width: parent.width - 24px;
                            if root.card.command != "": HorizontalLayout {
                                Text { text: "$  "; font-family: "DejaVu Sans Mono"; font-size: 12.5px; color: #ffb340; }
                                Text { text: root.card.command; font-family: "DejaVu Sans Mono"; font-size: 12.5px; color: white; wrap: char-wrap; horizontal-stretch: 1; }
                            }
                            if root.card.command == "": Text { text: root.card.path; font-family: "DejaVu Sans Mono"; font-size: root.card.preview.length > 0 ? 11.5px : 12.5px;
                                color: root.card.preview.length > 0 ? #ffffff8c : white; wrap: char-wrap; }
                            for l in root.card.preview: Text { text: l.text; font-family: "DejaVu Sans Mono"; font-size: 11.5px; wrap: char-wrap;
                                color: l.kind == 1 ? #9df0ae : l.kind == -1 ? #ffaaa4 : white; }
                        }
                    }
                    Rectangle { height: 10px; }
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.card.danger ? #ff453a : #ffb340; } }
                        Text { text: root.card.reason; font-size: 11.5px; color: #ffffff8c; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    }
                    Rectangle { height: 12px; }
                    HorizontalLayout {
                        Press { text: "Deny"; key: "Esc"; clicked => { root.answer("deny"); } }
                        Rectangle { horizontal-stretch: 1; }
                        Press { text: "Trust"; key: "Shift+Enter"; r-right: 0; clicked => { root.answer("trust"); } }
                        Rectangle { width: 1px; }
                        // More: allow everything this session.
                        Press { text: "All"; r-left: 0; clicked => { root.answer("trustAll"); } }
                        Rectangle { width: 8px; }
                        Press { text: root.card.allow; key: "Enter"; kind: root.card.danger ? 2 : 1; clicked => { root.answer("allow"); } }
                    }
                }
            }
            // Voice's card (the mockup's notch steps): listening, working on it, the
            // preview with its countdown, an agent to pick, started, cancelled, an error.
            // Esc cancels the voice interaction only; Enter starts once Start can.
            voice-keys := FocusScope {
                visible: root.rest-kind == 3;
                accessible-role: groupbox;
                accessible-id: "NotchVoice";
                accessible-label: "Voice";
                key-pressed(e) => {
                    // An open menu closes first; then Esc cancels.
                    if (e.text == Key.Escape) { if (root.voice-menu != 0) { root.voice-open-menu(0); } else { root.voice-cancel(); } return accept; }
                    if (e.text == Key.Return && !e.modifiers.shift && root.voice.kind == 3 && root.voice.can-start) { root.voice-start(); return accept; }
                    reject
                }
                // The widest the listening time gets ("10:00", the ten-minute cap),
                // measured but never drawn and never in a layout: the time's cell is held
                // at this, so the card doesn't change width as the digits do.
                vclock := Text { x: 0; y: 0; width: 0; height: 0; visible: false; text: "10:00"; font-size: 11.5px; font-weight: 500; }
                // .nlisten: the mic swells a little with the voice's level; while Hover
                // works on what was said a ring goes round it.
                vl := HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: root.voice-w;
                    height: 52px;
                    visible: root.voice.kind == 1 || root.voice.kind == 2;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 11px;
                    VerticalLayout { alignment: center; Rectangle {
                        width: 26px;
                        height: 26px;
                        property <float> k: root.voice.kind == 1 ? 1 + 0.35 * min(1, root.voice-level) : 1;
                        Rectangle {
                            width: 26px * parent.k;
                            height: 26px * parent.k;
                            border-radius: self.width / 2;
                            background: #ffffff1c;
                            animate width, height { duration: Pal.motion ? 90ms : 0ms; }
                        }
                        Icon { name: Icons.mic; size: 13px; tint: white; }
                        if root.voice.kind == 2: Path {
                            x: -2px; y: -2px; width: 30px; height: 30px; viewbox-width: 30; viewbox-height: 30;
                            commands: Arc.of(15, 14, mod(Clock.t * 313, 360) * 1deg, 100deg);
                            stroke: #c4a2ff; stroke-width: 2px; stroke-line-cap: round; fill: transparent;
                        }
                    } }
                    Text {
                        text: root.voice.words;
                        font-size: 13px;
                        color: root.voice.kind == 1 ? #f6f2ff61 : #f6f2ffd9;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        accessible-role: text;
                        accessible-id: "NotchVoiceStage";
                        accessible-label: root.voice.words + " " + root.voice.sub;
                    }
                    if root.voice.sub != "": Text { text: root.voice.sub; font-size: 11.5px; font-weight: 500; color: #f6f2ff61; vertical-alignment: center;
                        min-width: vclock.preferred-width; horizontal-alignment: right; }
                    VerticalLayout { alignment: center; EscChip { clicked => { root.voice-cancel(); } } }
                }
                // .ncard: what was heard, the target, the agent and the access, the task
                // (edit it to stop the countdown), Start with its ring, and Cancel.
                vc := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: 460px;
                    height: self.preferred-height;
                    visible: root.voice.kind == 3 || root.voice.kind == 4;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 9px;
                    HorizontalLayout {
                        spacing: 7px;
                        VerticalLayout { alignment: center; Icon { name: Icons.mic; size: 12px; tint: #c4a2ff; } }
                        Text { text: "“" + root.voice.heard + "”"; font-size: 11.5px; font-italic: true; color: #f6f2ff61; overflow: elide; horizontal-stretch: 1;
                            vertical-alignment: center; accessible-role: text; accessible-label: "Heard: " + root.voice.heard; }
                    }
                    if root.voice.kind == 4: Text { text: root.voice.words; font-size: 12.5px; color: white; wrap: word-wrap; accessible-role: text; }
                    if root.voice.kind == 4: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for t in root.voice-tools: VPick {
                            accessible-role: button;
                            accessible-label: "Use " + t.name + " for this task";
                            accessible-action-default => { root.voice-pick(t.id); }
                            background: pta.has-hover ? #ffffff1f : #ffffff0f;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 10px;
                                spacing: 7px;
                                VerticalLayout { alignment: center; Mark { tool: t.id; width: 16px; height: 16px; } }
                                Text { text: t.name; font-size: 12px; color: white; vertical-alignment: center; }
                            }
                            pta := TouchArea { mouse-cursor: pointer; clicked => { root.voice-pick(t.id); } }
                        }
                    }
                    if root.voice.kind == 3: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        // The target: the project's letter tile, or the home of the default workspace.
                        VPick {
                            max-width: 190px;
                            accessible-role: text;
                            accessible-label: "Folder: " + root.voice.target + ", " + root.voice.folder;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 9px;
                                spacing: 7px;
                                VerticalLayout { alignment: center; Rectangle {
                                    width: 18px; height: 18px; border-radius: 5px;
                                    background: root.voice.home ? #ffffff1c : root.voice.tint;
                                    if !root.voice.home: Text { text: root.voice.letter; font-size: 9.5px; font-weight: 700; color: white; }
                                    if root.voice.home: Icon { name: Icons.home; size: 11px; tint: white; }
                                } }
                                Text { text: root.voice.target; font-size: 12px; color: white; vertical-alignment: center; overflow: elide; }
                                Text { text: root.voice.folder; font-family: "DejaVu Sans Mono"; font-size: 10.5px; color: #f6f2ff61; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                        // The agent and its model, for this task: each opens its menu (and
                        // stops the countdown, so it can't start mid-choice).
                        VMenuPick {
                            open: root.voice-menu == 1;
                            enabled: !root.voice.starting;
                            accessible-label: "Agent: " + root.voice.agent + ". Change";
                            accessible-id: "NotchVoiceAgent";
                            clicked => { root.voice-open-menu(root.voice-menu == 1 ? 0 : 1); }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 8px;
                                spacing: 6px;
                                VerticalLayout { alignment: center; Mark { tool: root.voice.tool; width: 16px; height: 16px; } }
                                Text { text: root.voice.agent; font-size: 12px; color: white; vertical-alignment: center; }
                                VerticalLayout { alignment: center; Icon { name: Icons.chevron-down; size: 11px; tint: #f6f2ff9e; } }
                            }
                        }
                        VMenuPick {
                            max-width: 150px;
                            open: root.voice-menu == 2;
                            enabled: !root.voice.starting;
                            accessible-label: "Model: " + root.voice.model + ". Change";
                            accessible-id: "NotchVoiceModel";
                            clicked => { root.voice-open-menu(root.voice-menu == 2 ? 0 : 2); }
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 8px;
                                spacing: 5px;
                                Text { text: root.voice.model; font-size: 12px; color: white; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                VerticalLayout { alignment: center; Icon { name: Icons.chevron-down; size: 11px; tint: #f6f2ff9e; } }
                            }
                        }
                        VPick {
                            amber: root.voice.full;
                            accessible-role: text;
                            accessible-label: "Access: " + root.voice.access;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 9px;
                                spacing: 6px;
                                VerticalLayout { alignment: center; Icon { name: Icons.shield; size: 11px; tint: root.voice.full ? #ffc46b : #f6f2ff9e; } }
                                Text { text: root.voice.access; font-size: 12px; color: root.voice.full ? #ffc46b : white; vertical-alignment: center; }
                            }
                        }
                    }
                    // The open menu, under the picks (the office's #mMenu, in the card): the
                    // agents ready for this task, or the model, then its effort or variant.
                    if root.voice.kind == 3 && root.voice-menu != 0: Rectangle {
                        height: min(vmm.preferred-height, 168px);
                        border-radius: 12px;
                        background: #ffffff0a;
                        border-width: 1px;
                        border-color: #ffffff14;
                        accessible-role: list;
                        accessible-id: "NotchVoiceMenu";
                        accessible-label: root.voice-menu-head;
                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: vmm.preferred-height;
                            vmm := VerticalLayout {
                                width: parent.width;
                                padding: 6px;
                                Text { text: root.voice-menu-head; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px; letter-spacing: 0.63px; color: #f6f2ff61;
                                    height: self.preferred-height + 10px; vertical-alignment: center; x: 8px; }
                                for t in root.voice-tools: VRow { label: t.name; tool: t.id; on: t.id == root.voice.tool; clicked => { root.voice-pick(t.id); } }
                                for m in root.voice-mm-models: VRow { label: m.label; on: m.on; clicked => { root.voice-pick-model(m.id); } }
                                if root.voice-mm-efforts.length > 0: Text { text: root.voice-mm-effort-head; font-family: "Pixelify Sans"; font-weight: 600; font-size: 10.5px;
                                    letter-spacing: 0.63px; color: #f6f2ff61; height: self.preferred-height + 10px; vertical-alignment: center; x: 8px; }
                                if root.voice-mm-efforts.length > 0: HorizontalLayout { padding-left: 4px; padding-right: 4px; padding-bottom: 4px; padding-top: 2px; spacing: 3px;
                                    for e in root.voice-mm-efforts: VRow { seg: true; label: e.label; on: e.on; horizontal-stretch: 1; clicked => { root.voice-pick-effort(e.id); } } }
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 3px;
                                    Text { text: root.voice-menu-note; font-size: 11px; color: #f6f2ff61; wrap: word-wrap; } }
                            }
                        }
                    }
                    if root.voice.note != "": Text { text: root.voice.note; font-size: 11px; color: #f6f2ff9e; wrap: word-wrap; accessible-role: text; }
                    // .ntask: four lines, then it scrolls. Focusing it stops the countdown.
                    if root.voice.kind == 3: Rectangle {
                        height: min(tin.preferred-height, 80px) + 18px;
                        border-radius: 10px;
                        background: #ffffff08;
                        border-width: 1px;
                        border-color: tin.has-focus ? #c4a2ff8c : #ffffff12;
                        TouchArea { mouse-cursor: text; clicked => { tin.focus(); } }
                        Flickable {
                            x: 10px;
                            y: 9px;
                            width: parent.width - 20px;
                            height: parent.height - 18px;
                            content-height: tin.preferred-height;
                            tin := TextInput {
                                width: parent.width;
                                text: root.voice.task;
                                font-size: 13px;
                                color: white;
                                selection-background-color: #c4a2ff66;
                                wrap: word-wrap;
                                single-line: false;
                                read-only: root.voice.starting;
                                accessible-role: text-input;
                                accessible-id: "NotchVoiceTask";
                                accessible-label: "Task";
                                // Voice's edited task comes back the same; a rebuild never undoes typing.
                                property <string> given: root.voice.task;
                                changed given => { if (!self.has-focus) { self.text = self.given; } }
                                changed has-focus => { if (self.has-focus && root.voice.ring >= 0) { root.voice-edit(self.text); } }
                                edited => { root.voice-edit(self.text); }
                                key-pressed(e) => {
                                    // Enter starts once the edit has been checked (not while an IME composes);
                                    // Shift+Enter is a new line.
                                    if (e.text == "\n" && !e.modifiers.shift && self.preedit-text == "") { if (root.voice.can-start) { root.voice-start(); } return accept; }
                                    reject
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        if root.voice.kind == 3: VBtn {
                            horizontal-stretch: 1;
                            light: true;
                            text: root.voice.start;
                            key: "Enter";
                            ring: root.voice.ring;
                            enabled: root.voice.can-start;
                            clicked => { root.voice-start(); }
                        }
                        if root.voice.kind == 4: Rectangle { horizontal-stretch: 1; }
                        if root.voice.kind == 4 && root.voice.settings: VBtn { text: "Settings"; clicked => { root.voice-settings(); } }
                        VBtn { text: "Cancel"; key: "Esc"; enabled: !root.voice.starting; clicked => { root.voice-cancel(); } }
                    }
                }
                // .nstart: the tool's logo, the task, and where it started.
                vs := HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: root.voice-w;
                    height: 34px;
                    visible: root.voice.kind == 5 || root.voice.kind == 6;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 9px;
                    accessible-role: text;
                    accessible-id: "NotchVoiceDone";
                    accessible-label: root.voice.words + ". " + root.voice.sub;
                    if root.voice.kind == 5: VerticalLayout { alignment: center; Mark { tool: root.voice.tool; width: 16px; height: 16px; } }
                    Text { text: root.voice.words; font-size: 12px; color: white; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 4px;
                        if root.voice.kind == 5: VerticalLayout { alignment: center; Icon { name: Icons.check; size: 11px; tint: #4ade80; } }
                        Text { text: root.voice.sub; font-size: 12px; color: root.voice.kind == 5 ? #4ade80 : #f6f2ff61; vertical-alignment: center; }
                    }
                }
                // .nnone: what went wrong, what was kept, and Retry (or Settings).
                ve := HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: 420px;
                    height: root.voice-h;
                    visible: root.voice.kind == 7;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 11px;
                    VerticalLayout { alignment: center; Rectangle {
                        width: 26px; height: 26px; border-radius: 13px; background: #ffffff1c;
                        Icon { name: Icons.warning; size: 13px; tint: #ff6b62; }
                    } }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 1px;
                        Text { text: root.voice.words; font-size: 12.5px; color: white; wrap: word-wrap; accessible-role: text; accessible-id: "NotchVoiceError"; }
                        Text { text: root.voice.sub; font-size: 11px; color: #f6f2ff61; overflow: elide; }
                    }
                    if root.voice.retry || root.voice.settings: VerticalLayout { alignment: center; Rectangle {
                        height: 26px;
                        width: bt.preferred-width + 20px;
                        border-radius: 8px;
                        background: bta.has-hover ? #ffffff1f : #ffffff12;
                        accessible-role: button;
                        accessible-label: bt.text;
                        accessible-action-default => { if (root.voice.retry) { root.voice-retry(); } else { root.voice-settings(); } }
                        bt := Text { text: root.voice.retry ? "Retry" : "Settings"; font-size: 11.5px; font-weight: 600; color: white; }
                        bta := TouchArea { mouse-cursor: pointer; clicked => { if (root.voice.retry) { root.voice-retry(); } else { root.voice-settings(); } } }
                    } }
                    VerticalLayout { alignment: center; EscChip { clicked => { root.voice-cancel(); } } }
                }
            }
        }
    }

    // ViewHost: laid out at the open size, clipped by the growing shape. Made only while
    // the office is: once it is dropped (30 s hidden) its items go, and the renderer's
    // layers, stencils and textures kept for them with them. (Inside the hidden host an
    // `if` is never looked at again, so the condition sits out here.)
    if Office.built: Rectangle {
        x: root.shape-x;
        y: 0;
        width: root.shape-w;
        height: root.shape-h;
        clip: true;
        border-bottom-left-radius: root.shape-r;
        border-bottom-right-radius: root.shape-r;
        visible: root.view-visible;
        keys := FocusScope {
            property <int> asks: root.focus-asks;
            changed asks => { if (root.focus-wanted) { root.focus-wanted = false; self.focus(); } }
            init => { if (root.focus-wanted) { root.focus-wanted = false; self.focus(); } }
            key-pressed(e) => {
                if (e.text == Key.Escape) { view.escape(); return accept; }
                reject
            }
            Rectangle {
                x: (root.shape-w - root.open-w) / 2;
                y: root.hw-h;
                width: root.open-w;
                height: root.open-h - root.hw-h;
                opacity: root.view-opacity;
                view := OfficeView {
                    dashboard: false;
                    in-settings: root.in-settings;
                    back => { root.back(); }
                    fold => { root.fold(); }
                }
            }
        }
    }
    // The clip above cuts the office's corners pixel by pixel (no smoothing on the GPU), so
    // over a light desktop its edge showed as white steps. A thin black edge drawn over it
    // is smoothed, and hides them.
    if Office.built: Rectangle {
        x: root.shape-x - 0.5px;
        y: -2px;
        width: root.shape-w + 1px;
        height: root.shape-h + 2.5px;
        visible: root.view-visible;
        opacity: root.view-opacity;
        border-bottom-left-radius: root.shape-r + 0.5px;
        border-bottom-right-radius: root.shape-r + 0.5px;
        border-width: 1.5px;
        border-color: black;
    }

}

// A caption button as Windows 11 draws them: 46 wide, a light fill on hover, red
// behind close.
component Caption inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> close;
    callback clicked;
    width: 46px;
    background: ta.pressed ? (close ? #b0271a : #ffffff10) : ta.has-hover ? (close ? #c42b1c : #ffffff1a) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    Path { width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; commands: glyph; fill: transparent;
        stroke: ta.has-hover && close ? white : #ffffffd9; stroke-width: 1px; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component DashboardWindow inherits Window {
    in property <bool> in-settings;
    in property <bool> is-maximized;
    // The system's own title bar and edges (a Mac's), in place of Hover's.
    in property <bool> native-frame;
    callback back();
    callback minimize();
    callback maximize();
    callback close-clicked();
    // A press on the bar drags the window; on an edge (1 n, 2 s, 3 w, 4 e, 5 nw, 6 ne,
    // 7 sw, 8 se) it resizes it.
    callback drag();
    callback resize(int);
    title: "Hover";
    // The taskbar's and Alt+Tab's icon while the dashboard shows.
    icon: @image-url("../assets/hover-mark.png");
    no-frame: !root.native-frame;
    preferred-width: 1200px;
    preferred-height: 620px;
    min-width: 880px;
    min-height: 480px;
    background: #0b0810;
    default-font-family: Fonts.text;
    accessible-role: groupbox;
    accessible-id: "HoverDashboard";
    VerticalLayout {
        // Hover's own title bar: the logo and name, then minimize, maximize, close. The
        // office fills the window under it, edge to edge.
        if !root.native-frame: Rectangle {
            height: 34px;
            background: #0b0810;
            TouchArea {
                pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag(); } }
                double-clicked => { root.maximize(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                Image { width: 16px; height: 16px; y: 9px; source: @image-url("../assets/hover-mark.png"); image-rendering: smooth; }
                Rectangle { width: 8px; }
                Text { text: "Hover"; font-size: 12px; font-weight: 500; color: #ffffffd9; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Caption { label: "Minimize"; glyph: "M 0 5 L 10 5"; clicked => { root.minimize(); } }
                Caption { label: root.is-maximized ? "Restore" : "Maximize"; glyph: root.is-maximized ? "M 0 2 L 8 2 L 8 10 L 0 10 Z M 2 2 L 2 0 L 10 0 L 10 8 L 8 8" : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"; clicked => { root.maximize(); } }
                Caption { label: "Close"; close: true; glyph: "M 0 0 L 10 10 M 10 0 L 0 10"; clicked => { root.close-clicked(); } }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            // In the app window the office sits on the panel's colour (right in light mode).
            background: Pal.panel;
            if Office.built: FocusScope {
                focus-on-click: false;
                key-pressed(e) => {
                    if (e.text == Key.Escape) { dv.escape(); return accept; }
                    reject
                }
                dv := OfficeView {
                    dashboard: true;
                    in-settings: root.in-settings;
                    back => { root.back(); }
                }
            }
        }
    }
    // The resize border, 6 px, where the frame used to be.
    if !root.is-maximized && !root.native-frame: Rectangle {
        for e in [{ k: 1, x: 6px, y: 0, w: root.width - 12px, h: 4px }, { k: 2, x: 6px, y: root.height - 6px, w: root.width - 12px, h: 6px },
                  { k: 3, x: 0, y: 6px, w: 6px, h: root.height - 12px }, { k: 4, x: root.width - 6px, y: 6px, w: 6px, h: root.height - 12px },
                  { k: 5, x: 0, y: 0, w: 6px, h: 6px }, { k: 6, x: root.width - 6px, y: 0, w: 6px, h: 6px },
                  { k: 7, x: 0, y: root.height - 6px, w: 6px, h: 6px }, { k: 8, x: root.width - 6px, y: root.height - 6px, w: 6px, h: 6px }]: TouchArea {
            x: e.x; y: e.y; width: e.w; height: e.h;
            mouse-cursor: e.k <= 2 ? ns-resize : e.k <= 4 ? ew-resize : e.k == 5 || e.k == 8 ? nwse-resize : nesw-resize;
            pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(e.k); } }
        }
    }
}

// MessageBox with the warning icon and OK.
export component WarningWindow inherits Window {
    in property <string> message;
    callback ok();
    title: "Global shortcut unavailable";
    width: 440px;
    height: layout.preferred-height;
    background: Pal.sheet;
    default-font-family: Fonts.text;
    layout := VerticalLayout {
        padding: 20px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout { alignment: start; Icon { name: Icons.warning; size: 28px; tint: Pal.orange; } }
            Text { text: root.message; wrap: word-wrap; font-size: 13px; color: Pal.ink; }
        }
        HorizontalLayout {
            alignment: end;
            PillButton { id: "OK"; text: "OK"; bg: Pal.blue; fg: white; pad-x: 22px; clicked => { root.ok(); } }
        }
    }
}
