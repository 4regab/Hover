<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hover.Images.AnnotateWindow"
        Title="Hover — mark up"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E0E"
        MinWidth="520" MinHeight="380">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Tools. The keys are printed on them, because this window is opened by a
             shortcut and closed by one. -->
        <Border Grid.Row="0" Background="#191919"
                BorderBrush="{StaticResource DarkLine}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="10,8">
                <Button Classes="tool" Name="ArrowTool" Click="OnArrow" ToolTip.Tip="Arrow (1)">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M 4,20 L 20,4 M 20,4 L 13,4 M 20,4 L 20,11" />
                </Button>
                <Button Classes="tool" Name="BoxTool" Click="OnBox" ToolTip.Tip="Box (2)">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                          Data="M 4,5 H 20 V 19 H 4 Z" />
                </Button>
                <Button Classes="tool" Name="HighlightTool" Click="OnHighlight" ToolTip.Tip="Highlight (3)">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding $parent[Button].Foreground}"
                          Data="M 3,14 H 21 V 19 H 3 Z M 6,5 H 18 V 11 H 6 Z" />
                </Button>
                <Button Classes="tool" Name="CropTool" Click="OnCrop" ToolTip.Tip="Crop (4)">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          Data="M 7,3 V 17 H 21 M 3,7 H 17 V 21" />
                </Button>

                <Border Width="1" Background="{StaticResource DarkLine}" Margin="6,4" />

                <Button Classes="swatch" Name="RedSwatch" Click="OnRed" ToolTip.Tip="Red"
                        Background="#E03E3E" />
                <Button Classes="swatch" Name="YellowSwatch" Click="OnYellow" ToolTip.Tip="Yellow"
                        Background="#FFDC49" />
                <Button Classes="swatch" Name="BlueSwatch" Click="OnBlue" ToolTip.Tip="Blue"
                        Background="#2383E2" />

                <Border Width="1" Background="{StaticResource DarkLine}" Margin="6,4" />

                <Button Classes="tool" Name="UndoButton" Click="OnUndo" ToolTip.Tip="Undo (Ctrl+Z)">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M 4,9 H 14 A 5,5 0 1 1 14,19 H 8 M 4,9 L 8,5 M 4,9 L 8,13" />
                </Button>
            </StackPanel>
        </Border>

        <!-- The picture -->
        <Border Grid.Row="1" Margin="14" Name="Stage" />

        <!-- What happens next -->
        <Border Grid.Row="2" Background="#191919"
                BorderBrush="{StaticResource DarkLine}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,9">
                <TextBlock Grid.Column="0" Name="Status" Classes="when"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="quiet" Click="OnDiscard" Margin="0,0,8,0"
                        Content="Discard  Esc" />
                <Button Grid.Column="2" Classes="primary" Click="OnSave"
                        Content="Save  ↵" />
            </Grid>
        </Border>
    </Grid>
</Window>
