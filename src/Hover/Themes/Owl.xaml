<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:owl="clr-namespace:Hover.Owl">

  <!-- The workspace's controls, drawn as Apple draws them: pill buttons (plain grey,
       filled blue, or tinted), the segmented control with a raised thumb, and the
       green switch. Keyed only, so nothing leaks into stock windows. Every colour is
       a dynamic resource; these are the dark values, and Owl/Theme.cs overrides them
       on the application for light mode. -->

  <FontFamily x:Key="OwlFont">pack://application:,,,/Hover;component/Assets/Fonts/#Inter</FontFamily>
  <owl:CapsuleCorners x:Key="Corners" />

  <SolidColorBrush x:Key="Owl.Ink" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Owl.InkDim" Color="#99EBEBF5" />
  <SolidColorBrush x:Key="Owl.Lift" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Owl.Accent" Color="#FF0A84FF" />
  <SolidColorBrush x:Key="Owl.Focus" Color="#B30A84FF" />
  <SolidColorBrush x:Key="Owl.Fill" Color="#52787880" />
  <SolidColorBrush x:Key="Owl.Thumb" Color="#FF636366" />
  <SolidColorBrush x:Key="Owl.RowHover" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Owl.SwitchOff" Color="#FF39393D" />
  <SolidColorBrush x:Key="Owl.SwitchOn" Color="#FF30D158" />
  <SolidColorBrush x:Key="Owl.Handle" Color="#66FFFFFF" />

  <!-- Focus rings, shown by WPF only when focus arrives from the keyboard: a click
       never leaves a blue outline behind. -->
  <Style x:Key="OwlFocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="11" BorderThickness="2.5"
                  BorderBrush="{DynamicResource Owl.Focus}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OwlBase" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OwlFocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Owl.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Tag" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <Border.CornerRadius>
                <MultiBinding Converter="{StaticResource Corners}">
                  <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </Border.CornerRadius>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <!-- Hover and press shade the button a little instead of fading it. -->
            <Border x:Name="Lift" Background="{DynamicResource Owl.Lift}" Opacity="0" IsHitTestVisible="False"
                    CornerRadius="{Binding CornerRadius, ElementName=Bd}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Lift" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Lift" Property="Opacity" Value="0.16" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Icon-only buttons: no fill until hovered, then a circle. -->
  <Style x:Key="OwlIconButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Tag" Value="99" />
  </Style>

  <!-- The prominent action: a filled blue pill. -->
  <Style x:Key="OwlDarkButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Background" Value="{DynamicResource Owl.Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="Tag" Value="99" />
  </Style>

  <Style x:Key="OwlBlueButton" TargetType="Button" BasedOn="{StaticResource OwlDarkButton}">
    <Setter Property="Padding" Value="14,5" />
  </Style>

  <!-- A plain grey pill: Connect calendar, Choose file, the notch's close button. -->
  <Style x:Key="OwlChromeButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Background" Value="{DynamicResource Owl.Fill}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Tag" Value="99" />
  </Style>

  <Style x:Key="OwlLightButton" TargetType="Button" BasedOn="{StaticResource OwlChromeButton}">
    <Setter Property="Padding" Value="14,5" />
  </Style>

  <!-- Text that acts: in the accent colour, as a plain button on a Mac. -->
  <Style x:Key="OwlLink" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Foreground" Value="{DynamicResource Owl.Accent}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Tag" Value="99" />
  </Style>

  <!-- The segmented control of iOS: a grey track (built in code, radius 9) with the
       picked segment raised on a thumb one step smaller. -->
  <ControlTemplate x:Key="OwlSegmentTemplate" TargetType="RadioButton">
    <Grid Background="Transparent">
      <Border x:Name="Thumb" CornerRadius="7" Background="{DynamicResource Owl.Thumb}" Opacity="0">
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.14" RenderingBias="Performance" />
        </Border.Effect>
      </Border>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Thumb" Property="Opacity" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="OwlSegmentDark" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OwlFocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Owl.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="Template" Value="{StaticResource OwlSegmentTemplate}" />
  </Style>

  <Style x:Key="OwlSegmentInk" TargetType="RadioButton" BasedOn="{StaticResource OwlSegmentDark}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- A row in the Settings sidebar: blue with white text when picked, as in
       System Settings. -->
  <Style x:Key="OwlSidebarItem" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OwlFocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Owl.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,5">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Owl.RowHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Owl.Accent}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A bare text field: whatever it sits in is the background. -->
  <Style x:Key="OwlField" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Owl.Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Owl.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Owl.Accent}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- On / off switch: the system green when on, the knob sliding across. -->
  <Style x:Key="OwlSwitch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OwlFocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Owl.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
            <Border x:Name="Track" Grid.Column="1" Width="42" Height="26" CornerRadius="13"
                    Background="{DynamicResource Owl.SwitchOff}">
              <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White"
                       HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="5" ShadowDepth="1.5" Direction="270" Opacity="0.22" RenderingBias="Performance" />
                </Ellipse.Effect>
              </Ellipse>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Owl.SwitchOn}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="16" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The splitter's keyboard focus: its handle, in blue. -->
  <Style x:Key="OwlSplitterFocus">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Width="4" Height="36" CornerRadius="2" Background="{DynamicResource Owl.Accent}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The gap between two cards: drag it to share the width differently. Invisible
       until the pointer finds it, then a short pill handle, as in a Mac split view. -->
  <Style x:Key="OwlSplitter" TargetType="GridSplitter">
    <Setter Property="Width" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="Cursor" Value="SizeWE" />
    <!-- Focusable, so the arrow keys can resize too. -->
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource OwlSplitterFocus}" />
    <Setter Property="KeyboardIncrement" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="Transparent">
            <Border x:Name="Handle" Width="4" Height="36" CornerRadius="2" Background="{DynamicResource Owl.Handle}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Handle" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Handle" Property="Opacity" Value="1" />
              <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Owl.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
