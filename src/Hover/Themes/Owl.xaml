<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The workspace's controls. Keyed only, so nothing here leaks into the notes
       deck or the ordinary windows. -->

  <FontFamily x:Key="OwlIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="OwlFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <Style x:Key="OwlBase" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#D9000000" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Tag" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#990A84FF" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Icon-only buttons on the paper cards: no fill until hovered. -->
  <Style x:Key="OwlIconButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  BorderBrush="Transparent" BorderThickness="1.5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#17000000" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#26000000" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#990A84FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OwlDarkButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Background" Value="#FF1C1C1E" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Tag" Value="8" />
  </Style>

  <Style x:Key="OwlChromeButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Background" Value="#FF333336" />
    <Setter Property="Foreground" Value="#F2FFFFFF" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Tag" Value="6" />
  </Style>

  <Style x:Key="OwlBlueButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Background" Value="#FF0A84FF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <Style x:Key="OwlLightButton" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Background" Value="#1C000000" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <Style x:Key="OwlLink" TargetType="Button" BasedOn="{StaticResource OwlBase}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="#A6000000" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Segmented controls. Dark: the header's Workspace / Insights / Settings.
       Ink: black when chosen, used on paper (Tasks/Focus, 15m/25m/45m/60m). -->
  <Style x:Key="OwlSegmentDark" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="#E6FFFFFF" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="13,3"
                  BorderBrush="Transparent" BorderThickness="1.5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF48484A" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#990A84FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OwlSegmentInk" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="#D9000000" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,2"
                  BorderBrush="Transparent" BorderThickness="1.5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#14000000" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF141416" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#990A84FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A bare text field for paper: the card is the background. -->
  <Style x:Key="OwlField" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#E6000000" />
    <Setter Property="CaretBrush" Value="#E6000000" />
    <Setter Property="SelectionBrush" Value="#660A84FF" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- On / off switch for the Settings tab. -->
  <Style x:Key="OwlSwitch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="#E6000000" />
    <Setter Property="FontFamily" Value="{StaticResource OwlFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
            <Border x:Name="Track" Grid.Column="1" Width="34" Height="20" CornerRadius="10"
                    Background="#33000000" BorderBrush="Transparent" BorderThickness="1.5">
              <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White"
                       HorizontalAlignment="Left" Margin="2,0" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#FF1C1C1E" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="#990A84FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
