# Normalise line endings so the repo is consistent across machines.
* text=auto eol=crlf

# Binary assets — never touch their bytes.
*.ico binary
*.png binary
*.gif binary
*.stickies binary

# Executed on Linux through their #! line (fake-acp.py runs as kiro-cli): a CR after
# "python3" makes the kernel look for "python3\r".
port/bench/*.py text eol=lf
native/installer/*.sh text eol=lf
Makefile text eol=lf
