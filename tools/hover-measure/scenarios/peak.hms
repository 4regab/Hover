# Where the Rust heap peaks (a profiling build: bench heap / heap-reset): a long rich
# answer streamed with the office open, then its chat opened, scrolled and closed, each
# step's peak read on its own.
launch
expect "bench visible" 30 as startup
send unfold
expect "bench reopen" 30 as first-office
sleep 5
send heap-reset
expect "bench ok" 5
mark stream-closed-chat
send task kiro @ - a long answer [seconds:3] [bytes:400000]
expect "bench task" 5
send until-idle 60
expect "bench idle" 65
sleep 2
send heap
expect "bench heap" 5
send heap-reset
expect "bench ok" 5
mark open-chat
send chat 1
expect "bench ok" 5
sleep 4
send heap
expect "bench heap" 5
send heap-reset
expect "bench ok" 5
mark scroll-chat
send scroll -3000
expect "bench ok" 5
send scroll -3000
expect "bench ok" 5
sleep 2
send heap
expect "bench heap" 5
send heap-reset
expect "bench ok" 5
mark stream-open-chat
send reply 1 another long one [seconds:3] [bytes:400000]
expect "bench reply" 5
send until-idle 60
expect "bench idle" 65
sleep 2
send heap
expect "bench heap" 5
send heap-reset
expect "bench ok" 5
mark close-chat
send chat
expect "bench ok" 5
sleep 2
send heap
expect "bench heap" 5
mark -
quit 30
