# Stress: 100 fast cycles through the office, its chat and history, Settings over it and
# the app window, and 20 at the cleanup boundary (the office is dropped 30 s after it is
# hidden): 10 reopened just before the drop (at 29.5 s, the drop must not happen) and 10
# just after it (the renderer made again at once). All the while one agent waits for
# approval (Ask first) and another works. Session ids count from 1 in a fresh data folder.
launch
expect "bench visible" 30 as startup
send task kiro @ risky - waits for approval [ask:execute:npm install left-pad] [seconds:2]
expect "bench task 1" 5
send until-ask 20
expect "bench asking 1" 25
send task codex @ - works throughout [seconds:3000]
expect "bench task 2" 5
sleep 5
mark stress-start
sleep 10

repeat 10
repeat 10
send unfold
expect "bench reopen" 60 as reopen-fast
send chat 1
expect "bench ok" 20 as ui-chat
send scroll -2000
expect "bench ok" 20 as ui-scroll
send chat 2
expect "bench ok" 20 as ui-chat
send history
expect "bench ok" 20 as ui-history
send settings 2
expect "bench ok" 20 as ui-settings
send back
expect "bench ok" 20 as ui-back
send dash
expect "bench ok" 20
send dash-close
expect "bench ok" 20 as dash-close
send fold
expect "bench folded" 20 as ui-fold
# The fold's animation ends (unfold during it is "already" open).
sleep 0.6
end
# Just before the drop: the office stays.
send unfold
expect "bench reopen" 60
send chat 1
expect "bench ok" 20 as ui-chat
send fold
expect "bench folded" 20 as ui-fold
sleep 29.5
send unfold
expect "bench reopen" 60 as reopen-at-29s
send office
expect "bench office live true" 5
# Just after it: made again at once, the chat and camera back.
send fold
expect "bench folded" 20 as ui-fold
expect "bench dropped" 40
send unfold
expect "bench reopen" 60 as reopen-after-drop
send office
expect "bench office live true" 5
send state
expect "bench state" 5
send fold
expect "bench folded" 20 as ui-fold
sleep 0.6
end

expect "bench dropped" 40
sleep 3
mark stress-end-collapsed
sleep 15
# The approval is still waiting, the other agent still at work: nothing was lost.
send sessions
expect "bench sessions 2 1:kiro:Running:1:0:1 2:codex:Running" 5
send answer 1 allow
expect "bench answer true" 5
send stopall
expect "bench ok" 20 as ui-stopall
send until-idle 30
expect "bench idle" 35
mark -
quit 30
