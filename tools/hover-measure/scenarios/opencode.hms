# OpenCode end to end through the app, against fake-opencode (copied as opencode.exe into
# the fakebin by run-memory.ps1). Session ids count from 1 in a fresh data folder.
# Run with FAKE_OPENCODE_LOG set (-Env FAKE_OPENCODE_LOG=...) to check afterwards that no
# prompt's message id was sent twice and every call named the folder.

launch
expect "bench visible" 30 as startup
send unfold
expect "bench reopen" 20 as first-office
sleep 2

# 1: a plain turn; the server is started for it (serve on 127.0.0.1, port 0, a password).
send task opencode @ - plain turn [seconds:2]
expect "bench task 1" 10
mark opencode-turn
send until-idle 40
expect "bench idle" 45
send said 1
expect "bench said 1 Done." 5

# 2: its question tool: a choice picked.
send task opencode @ - asks one [question] [seconds:1]
expect "bench task 2" 5
send until-ask 20
expect "bench asking 2" 25
mark opencode-question
sleep 4
send pick 2 Tabs
expect "bench pick true" 5
send until-idle 20
expect "bench idle" 25
send said 2
expect "bench said 2 answered [['Tabs']]" 5

# 3: the question skipped.
send task opencode @ - asks again [question] [seconds:1]
expect "bench task 3" 5
send until-ask 20
expect "bench asking 3" 25
send answer 3 deny
expect "bench answer true" 5
send until-idle 20
expect "bench idle" 25
send said 3
expect "bench said 3 the question was skipped" 5

# 4: Ask first: a command waits for the user, who allows it.
send task opencode @ risky - runs one [ask:bash:npm install left-pad] [seconds:1]
expect "bench task 4" 5
send until-ask 20
expect "bench asking 4" 25
mark opencode-permission
sleep 4
send answer 4 allow
expect "bench answer true" 5
send until-idle 20
expect "bench idle" 25
send said 4
expect "bench said 4 allowed bash npm install left-pad" 5

# 5: denied.
send task opencode @ risky - runs another [ask:bash:rm -rf build] [seconds:1]
expect "bench task 5" 5
send until-ask 20
expect "bench asking 5" 25
send answer 5 deny
expect "bench answer true" 5
send until-idle 20
expect "bench idle" 25
send said 5
expect "bench said 5 denied bash rm -rf build" 5

# 6: the event stream drops halfway through a long answer: Hover reconnects and reads back.
send task opencode @ - drops [drop] [seconds:4] [bytes:40000]
expect "bench task 6" 5
mark opencode-drop
send until-idle 60
expect "bench idle" 65

# 7: the prompt's response is lost: looked up by its id, never sent twice.
send task opencode @ - lost [lose] [seconds:2]
expect "bench task 7" 5
send until-idle 60
expect "bench idle" 65
send said 7
expect "bench said 7 Done." 5

# 8: the turn fails.
send task opencode @ - fails [fail] [seconds:1]
expect "bench task 8" 5
send until-idle 30
expect "bench idle" 35

# 9: a reply to 7 (the same conversation on the same server). Eight tasks were started and
# six are kept, so 1 and 2 have given up their desks by now.
send sessions
expect "bench sessions" 5
send reply 7 and once more [seconds:1]
expect "bench reply true" 5
send until-idle 30
expect "bench idle" 35
send said 7
expect "bench said 7 Done." 5

send sessions
expect "bench sessions" 5
mark -
quit 30
