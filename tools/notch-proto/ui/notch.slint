// The notch (Notch.cs NotchShell) in Slint: one full-size, transparent window; the shape
// grows from its resting size to the office by one openness value, set from Rust.
// Everything outside the shape stays fully transparent (and click-through, see win.rs).

export component NotchWindow inherits Window {
    // The shape, in window DIPs (from hover-notch).
    in property <string> shape-commands;
    in property <string> rim-commands;
    in property <length> shape-x;
    in property <length> shape-w;
    in property <length> shape-h;
    in property <length> shape-r;
    in property <color> shape-fill: black;
    in property <float> rim-opacity;
    in property <float> mini-opacity: 1;
    in property <float> view-opacity;
    in property <bool> view-visible;
    in property <length> open-w: 1120px;
    in property <length> open-h: 440px;
    in property <string> status: "Kiro · Reading the code";
    in property <image> scene;
    in property <bool> live: true;
    in-out property <string> draft;
    callback escape();
    callback shape-pressed();
    callback shape-clicked();
    public function focus-input() { input.focus(); }

    title: "Hover notch";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    // DropShadowEffect (dark): blur 24, depth 4, opacity 0.5, straight down. Slint shadows
    // follow rectangles, so the ears (at most 10 px) cast none; listed as a gap.
    Rectangle {
        x: root.shape-x;
        y: 0;
        width: root.shape-w;
        height: root.shape-h;
        visible: root.shape-w > 1px && root.shape-h > 1px;
        border-bottom-left-radius: root.shape-r;
        border-bottom-right-radius: root.shape-r;
        background: black;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000080;
    }
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.shape-commands;
        fill: root.shape-fill;
        stroke: transparent;
    }
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.rim-commands;
        fill: transparent;
        stroke: #ffffff1a;
        stroke-width: 1px;
        opacity: root.rim-opacity;
    }
    shape-area := TouchArea {
        x: root.shape-x;
        width: root.shape-w;
        height: root.shape-h;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.shape-pressed(); }
        }
        clicked => { root.shape-clicked(); }
    }

    // The resting pill: the bot glyph and the running task.
    HorizontalLayout {
        x: root.shape-x + 12px;
        width: root.shape-w - 24px;
        height: 24px;
        opacity: root.mini-opacity;
        visible: root.mini-opacity > 0;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 17px;
            height: 17px;
            y: 3px;
            // BotGlyph at rest: head, visor, eyes, bulb.
            Rectangle { x: 1px; y: 4px; width: 15px; height: 13px; border-radius: 3px; background: #9b6bff; }
            Rectangle { x: 3px; y: 7px; width: 11px; height: 7px; border-radius: 2px; background: #121018; }
            Rectangle { x: 5px; y: 9px; width: 1.5px; height: 3px; background: #aaf6ff; }
            Rectangle { x: 9px; y: 9px; width: 1.5px; height: 3px; background: #aaf6ff; }
            Rectangle { x: 10px; y: 0px; width: 2.4px; height: 2.4px; border-radius: 0.5px; background: #ffd24a; }
        }
        Text {
            text: root.status;
            color: white;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: root.status;
        }
    }

    // ViewHost: laid out at the open size, clipped by the growing shape.
    Rectangle {
        x: root.shape-x;
        y: 0;
        width: root.shape-w;
        height: root.shape-h;
        clip: true;
        border-bottom-left-radius: root.shape-r;
        border-bottom-right-radius: root.shape-r;
        visible: root.view-visible;
        view := Rectangle {
            x: (root.shape-w - root.open-w) / 2;
            width: root.open-w;
            height: root.open-h;
            opacity: root.view-opacity;
            // The office's stand-in: a wgpu scene rendered on Slint's own device.
            Image {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                source: root.scene;
                image-fit: fill;
            }
            Text {
                x: 24px;
                y: 20px;
                text: "Agent office (prototype)";
                color: #f6f2ff;
                font-size: 14px;
                font-weight: 600;
            }
            FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.escape(); return accept; }
                    return reject;
                }
                Rectangle {
                    x: 22px;
                    y: parent.height - 70px;
                    width: 410px;
                    height: 48px;
                    border-radius: 18px;
                    background: #000000a0;
                    border-width: 1px;
                    border-color: input.has-focus ? #c4a2ff8c : #ffffff26;
                    input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        vertical-alignment: center;
                        text <=> root.draft;
                        color: #f6f2ff;
                        font-size: 13px;
                        accessible-role: text-input;
                        accessible-label: "Task";
                    }
                    Text {
                        x: 14px;
                        height: parent.height;
                        vertical-alignment: center;
                        visible: input.text == "";
                        text: "What should Kiro do?";
                        color: #f6f2ff61;
                        font-size: 13px;
                    }
                }
            }
        }
    }
}
