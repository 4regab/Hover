// Marks.Draw: the tile (radius 0.3 w; Cursor's with a 1 px edge), inset by the tool's
// pad, and the glyph fitted into it by its bounds, centred.
export component Mark inherits Rectangle {
    in property <string> tool;
    property <string> id: tool == "codex" || tool == "cursor" || tool == "claude" || tool == "opencode" ? tool : "kiro";
    property <float> pad: id == "codex" ? 0.1 : id == "cursor" || id == "opencode" ? 0.2 : id == "claude" ? 0.19 : 0.17;
    // The glyph's bounds on its 24-unit grid.
    property <[float]> bb: id == "codex" ? [3,3,18,18] : id == "cursor" ? [1.474,0.001,21.053,23.998]
        : id == "claude" ? [0,0,24,24] : id == "opencode" ? [4,2,16,20] : [1.999,-0,19.733,24];
    property <length> box: self.width * (1 - 2 * pad);
    property <float> k: min(box / 1px / bb[2], box / 1px / bb[3]);
    border-radius: self.width * 0.3;
    background: id == "codex" ? white : id == "cursor" ? #18181c : id == "claude" ? #d97757 : id == "opencode" ? #101012 : #9046ff;
    border-width: id == "cursor" || id == "opencode" ? 1px : 0;
    border-color: #ffffff2e;
    // Kiro as an image (see office.slint's Logo): its 24-unit grid laid where the Path's would be.
    if id == "kiro": Image {
        x: root.width * pad + (box - bb[2] * k * 1px) / 2 - bb[0] * k * 1px;
        y: root.width * pad + (box - bb[3] * k * 1px) / 2 - bb[1] * k * 1px;
        width: 24 * k * 1px;
        height: 24 * k * 1px;
        source: @image-url("../assets/kiro.svg");
    }
    if id != "kiro": Path {
        x: root.width * pad + (box - bb[2] * k * 1px) / 2;
        y: root.width * pad + (box - bb[3] * k * 1px) / 2;
        width: bb[2] * k * 1px;
        height: bb[3] * k * 1px;
        viewbox-x: bb[0];
        viewbox-y: bb[1];
        viewbox-width: bb[2];
        viewbox-height: bb[3];
        commands: id == "codex" ? MarkPaths.codex : id == "cursor" ? MarkPaths.cursor : id == "claude" ? MarkPaths.claude : MarkPaths.opencode;
        fill-rule: id == "cursor" || id == "opencode" ? evenodd : nonzero;
        fill: id == "codex" ? @linear-gradient(90deg, #b1a7ff 0%, #7a9dff 50%, #3941ff 100%) : id == "cursor" ? #ececf0 : id == "opencode" ? #f4f4f6 : white;
        stroke: transparent;
    }
    if id == "codex": Path {
        x: root.width * pad + (box - bb[2] * k * 1px) / 2;
        y: root.width * pad + (box - bb[3] * k * 1px) / 2;
        width: bb[2] * k * 1px;
        height: bb[3] * k * 1px;
        viewbox-x: bb[0];
        viewbox-y: bb[1];
        viewbox-width: bb[2];
        viewbox-height: bb[3];
        commands: MarkPaths.codex-glyph;
        fill: white;
        stroke: transparent;
    }
}

// Marks.Accent: the colour a tool's ring and glow take.
export global Accent {
    public pure function of(tool: string) -> color {
        return tool == "codex" ? #7a9dff : tool == "cursor" ? #ececf0 : tool == "opencode" ? #f4f4f6 : tool == "claude" ? #d97757 : #b48cff;
    }
    // Ui.QuotaColor: green, amber, red as a quota fills.
    public pure function quota(v: float) -> color { return v < 70 ? #32d74b : v < 90 ? #ffb340 : #ff453a; }
}

// An arc of the ring round (c, c) of radius r, from angle a0 (0 at 12 o'clock) sweeping
// clockwise, as SVG path commands.
export global Arc {
    public pure function of(c: float, r: float, a0: angle, sweep: angle) -> string {
        return "M " + (c + r * sin(a0)) + " " + (c - r * cos(a0)) + " A " + r + " " + r + " 0 " + (sweep > 180deg ? "1" : "0") + " 1 "
            + (c + r * sin(a0 + sweep)) + " " + (c - r * cos(a0 + sweep));
    }
}

// LiveMark: a ring round the tool's tile, and a badge. ring: 0 none (the tile fills it),
// 1 value (a quota), 2 spin (at work), 3 breathe (asking). badge: 0 none, 1 done, 2
// failed, 3 asking. t is the notch's clock in seconds (0 with animations off).
export component LiveMark inherits Rectangle {
    in property <string> tool;
    in property <length> tile: 16px;
    in property <int> ring;
    in property <float> value: -1;
    in property <color> ring-color: transparent;
    in property <int> badge;
    in property <float> t;
    property <float> s: min(self.width, self.height) / 1px;
    property <float> r: s / 2 - 1.25;
    property <length> side: ring == 0 ? s * 1px : tile;
    // The track under a value or spin ring.
    if ring == 1 || ring == 2: Path {
        width: s * 1px; height: s * 1px; viewbox-width: s; viewbox-height: s;
        commands: "M " + (s / 2) + " " + (s / 2 - r) + " A " + r + " " + r + " 0 1 1 " + (s / 2 - 0.001) + " " + (s / 2 - r) + " Z";
        stroke: #ffffff33; stroke-width: 2px; fill: transparent;
    }
    if ring == 1 && value >= 0: Path {
        width: s * 1px; height: s * 1px; viewbox-width: s; viewbox-height: s;
        commands: min(value, 100) * 3.6 >= 359.9 ? "M " + (s / 2) + " " + (s / 2 - r) + " A " + r + " " + r + " 0 1 1 " + (s / 2 - 0.001) + " " + (s / 2 - r) + " Z"
            : Arc.of(s / 2, r, 0deg, max(0.01, min(value, 100)) * 3.6deg);
        stroke: ring-color.alpha > 0 ? ring-color : Accent.quota(value); stroke-width: 2px; stroke-line-cap: round; fill: transparent;
    }
    // Spin: a 100 degree arc going round at 313 degrees a second, in the tool's colour.
    if ring == 2: Path {
        width: s * 1px; height: s * 1px; viewbox-width: s; viewbox-height: s;
        commands: Arc.of(s / 2, r, mod(t * 313, 360) * 1deg, 100deg);
        stroke: ring-color.alpha > 0 ? ring-color : Accent.of(tool); stroke-width: 2px; stroke-line-cap: round; fill: transparent;
    }
    // Breathe: the whole ring, its alpha rising and falling.
    if ring == 3: Path {
        width: s * 1px; height: s * 1px; viewbox-width: s; viewbox-height: s;
        commands: "M " + (s / 2) + " " + (s / 2 - r) + " A " + r + " " + r + " 0 1 1 " + (s / 2 - 0.001) + " " + (s / 2 - r) + " Z";
        stroke: ring-color.with-alpha(0.45 + 0.55 * (0.5 + 0.5 * sin(t * 3.9 * 1rad)));
        stroke-width: 2px; fill: transparent;
    }
    // The tile; none for a ring alone (tile 0). femtovg draws a path sized to nothing
    // at its viewbox's own size, which put a second, full-size logo over the stack.
    tile-r := Mark { tool: root.tool; x: (s * 1px - side) / 2; y: (s * 1px - side) / 2; width: side; height: side; visible: side > 0; }
    // The badge: 10 px across at the tile's bottom right, with a 2 px black edge.
    if badge != 0: Rectangle {
        x: tile-r.x + tile-r.width - 1px - 6px;
        y: tile-r.y + tile-r.height - 1px - 6px;
        width: 12px; height: 12px; border-radius: 6px;
        background: black;
        Rectangle {
            x: 1px; y: 1px; width: 10px; height: 10px; border-radius: 5px;
            background: badge == 1 ? #32d74b : badge == 2 ? #ff453a : #ffb340;
            Path {
                width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10;
                commands: badge == 1 ? "M 2.8 5.1 L 4.4 6.7 L 7.3 3.4" : badge == 2 ? "M 3.2 3.2 L 6.8 6.8 M 6.8 3.2 L 3.2 6.8" : "M 5 2.7 L 5 5.4 M 5 7.1 L 5 7.1";
                stroke: badge == 2 ? white : black; stroke-width: 1.5px; stroke-line-cap: round; fill: transparent;
            }
        }
    }
}

// One mark of the stack, as the app orders them (the one in front last) with how far
// it has come to the front (0 to 1).
export struct StackMark { tool: string, front: float, i: int }

// MarkStack: the agents at work, 13 px apart; the one speaking comes to the front with
// its spinning ring, the others sit smaller and dimmer behind.
export component MarkStack inherits Rectangle {
    in property <[StackMark]> marks;
    in property <int> n;
    in property <float> t;
    width: (26 + max(0, n - 1) * 13) * 1px;
    height: 26px;
    for m in marks: Rectangle {
        property <length> side: 16px * (0.82 + 0.18 * m.front);
        x: (13 + m.i * 13) * 1px - 13px;
        y: 0;
        width: 26px;
        height: 26px;
        // The cut-out that keeps a mark apart from the one behind it.
        if n > 1: Rectangle {
            x: (26px - side - 4px) / 2; y: (26px - side - 4px) / 2; width: side + 4px; height: side + 4px;
            border-radius: (side + 4px) * 0.32; background: black;
        }
        Rectangle {
            opacity: 0.5 + 0.5 * m.front;
            if m.front > 0.02: LiveMark { width: 26px; height: 26px; tool: m.tool; ring: 2; t: root.t; opacity: m.front; tile: 0px; }
            Mark { tool: m.tool; x: (26px - side) / 2; y: (26px - side) / 2; width: side; height: side; }
        }
    }
}
