// The office's chat drawer (page.html #drawer, at the notch's short height), in Slint.
// The thread itself is painted by hover-chat into `thread`; this file draws the chrome:
// the header, the composer and its buttons, and lays accessible text nodes over the
// thread so UI Automation reads the conversation.
import "../../../../web/office/fonts/PixelifySans.ttf";

export struct A11yBlock {
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
}

component Icon inherits Path {
    in property <color> ink;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: ink;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

// .x: 26 x 26, radius 8, rgba(255,255,255,.06); .x:hover .12
component XButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: area.has-hover ? #ffffff1f : #ffffff0f;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    Icon {
        width: 14px;
        height: 14px;
        commands: icon;
        ink: #f6f2ff9e;
        stroke-width: 2.2px;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// .av: the mascot's head.
component Avatar inherits Rectangle {
    in property <color> c;
    border-radius: 8px;
    background: c;
    Rectangle {
        x: parent.width * 0.60;
        y: -parent.height * 0.18;
        width: parent.width * 0.14;
        height: parent.height * 0.20;
        border-radius: 2px;
        background: #ffd24a;
        drop-shadow-blur: 6px;
        drop-shadow-color: #ffd24a;
    }
    Rectangle {
        x: parent.width * 0.18;
        y: parent.height * 0.28;
        width: parent.width * 0.64;
        height: parent.height * 0.48;
        border-radius: 4px;
        background: #121018;
    }
    for dx in [0, 0.22]: Rectangle {
        x: parent.width * (0.33 + dx);
        y: parent.height * 0.40;
        width: parent.width * 0.12;
        height: parent.height * 0.22;
        border-radius: 1px;
        background: #aaf6ff;
    }
}

export component ChatWindow inherits Window {
    in property <image> thread;
    in property <[A11yBlock]> blocks;
    in property <string> who: "Juno";
    in property <string> tool: "Codex";
    in property <color> tool-color: #3fd6a0;
    in property <string> session-title: "Fix the notch flicker on resize";
    in property <string> folder: "C:\\hover";
    in property <color> bot-color: #2fc9b0;
    in property <float> context: 48;
    in property <bool> busy;
    in-out property <string> draft;
    out property <length> thread-width: thread-area.width;
    out property <length> thread-height: thread-area.height;
    // kind: 0 down, 1 move, 2 up; shift for extending.
    callback pointer(int, length, length, bool);
    callback wheel(length);
    callback copy-selection();
    callback send(string);
    callback stop();
    callback close();
    title: "Hover · chat prototype";
    width: 1104px;
    height: 424px;
    background: #0b0810;
    default-font-family: "Segoe UI";

    // #drawer at max-height: 620px: top/right/bottom 8, width min(360px, 100% - 16px), radius 16.
    drawer := Rectangle {
        x: parent.width - self.width - 8px;
        y: 8px;
        width: min(360px, parent.width - 16px);
        height: parent.height - 16px;
        border-radius: 16px;
        background: rgb(22, 14, 26);
        border-width: 1px;
        border-color: #ffffff17;
        clip: true;
        accessible-role: groupbox;
        accessible-label: "Session";

        VerticalLayout {
            // .dh: padding 9 8 0 10, gap 9
            HorizontalLayout {
                padding-top: 9px;
                padding-right: 8px;
                padding-left: 10px;
                spacing: 9px;
                Avatar {
                    width: 28px;
                    height: 26px;
                    c: root.bot-color;
                    y: 2px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.who;
                            font-family: "Pixelify Sans";
                            font-size: 13px;
                            font-weight: 600;
                            color: #f6f2ff;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: badge.preferred-width + 10px;
                            height: 13px;
                            y: 3px;
                            border-radius: 5px;
                            background: root.tool-color.with-alpha(0.2);
                            badge := Text {
                                text: root.tool;
                                font-size: 9.5px;
                                font-weight: 600;
                                color: root.tool-color;
                                letter-spacing: 0.03 * 9.5px;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.session-title;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: #f6f2ff;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 1px;
                        Text {
                            text: root.folder;
                            font-family: "Cascadia Code";
                            font-size: 11px;
                            color: #f6f2ff61;
                            overflow: elide;
                        }
                        // #ctxRing: a 14 px ring, conic from #C4A2FF.
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            accessible-role: text;
                            accessible-label: round(root.context) + "% of the context window used";
                            Path {
                                width: 14px;
                                height: 14px;
                                viewbox-width: 14;
                                viewbox-height: 14;
                                stroke: #ffffff1f;
                                stroke-width: 1.5px;
                                fill: transparent;
                                MoveTo { x: 7; y: 2.25; }
                                ArcTo { x: 7; y: 11.75; radius-x: 4.75; radius-y: 4.75; sweep: true; }
                                ArcTo { x: 7; y: 2.25; radius-x: 4.75; radius-y: 4.75; sweep: true; }
                            }
                            Path {
                                property <float> a: root.context / 100 * 2 * 3.14159265;
                                width: 14px;
                                height: 14px;
                                viewbox-width: 14;
                                viewbox-height: 14;
                                stroke: #c4a2ff;
                                stroke-width: 1.5px;
                                fill: transparent;
                                MoveTo { x: 7; y: 2.25; }
                                ArcTo {
                                    x: 7 + 4.75 * sin(a * 1rad);
                                    y: 7 - 4.75 * cos(a * 1rad);
                                    radius-x: 4.75;
                                    radius-y: 4.75;
                                    sweep: true;
                                    large-arc: root.context > 50;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                XButton {
                    label: "Delete this session";
                    icon: "M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3";
                }
                XButton {
                    label: "Close";
                    icon: "M6 6l12 12M18 6 6 18";
                    clicked => { root.close(); }
                }
            }

            // #thread: painted by hover-chat, one viewport at a time.
            thread-area := Rectangle {
                vertical-stretch: 1;
                accessible-role: list;
                accessible-label: "Conversation";
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.thread;
                    image-fit: fill;
                }
                for b in root.blocks: Rectangle {
                    x: b.x;
                    y: b.y;
                    width: b.w;
                    height: b.h;
                    accessible-role: text;
                    accessible-label: b.text;
                }
                keys := FocusScope {
                    key-pressed(event) => {
                        if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                            root.copy-selection();
                            return accept;
                        }
                        return reject;
                    }
                    TouchArea {
                        mouse-cursor: text;
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                keys.focus();
                                root.pointer(0, self.mouse-x, self.mouse-y, e.modifiers.shift);
                            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                root.pointer(2, self.mouse-x, self.mouse-y, false);
                            }
                        }
                        moved => { root.pointer(1, self.mouse-x, self.mouse-y, false); }
                        scroll-event(e) => {
                            root.wheel(-e.delta-y);
                            return accept;
                        }
                    }
                }
            }

            // .composer: margin 6 10 10, padding 6 6 5 9, radius 15, rgba(0,0,0,.32), 1px line.
            Rectangle {
                height: composer.preferred-height + 16px;
                composer := Rectangle {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    height: col.preferred-height;
                    border-radius: 15px;
                    background: #00000052;
                    border-width: 1px;
                    border-color: input.has-focus ? #c4a2ff8c : (hover.has-hover ? #ffffff26 : #ffffff17);
                    // .composer:focus-within: box-shadow 0 0 0 3px rgba(144,70,255,.15)
                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 18px;
                        border-width: 3px;
                        border-color: input.has-focus ? #9046ff26 : transparent;
                    }
                    hover := TouchArea {
                        mouse-cursor: text;
                        clicked => { input.focus(); }
                    }
                    col := VerticalLayout {
                        padding-top: 6px;
                        padding-right: 6px;
                        padding-bottom: 5px;
                        padding-left: 9px;
                        Rectangle {
                            height: clamp(input.preferred-height + 6px, 28px, 112px);
                            FocusScope {
                                capture-key-pressed(event) => {
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        if (input.text != "") {
                                            root.send(input.text);
                                            input.text = "";
                                        }
                                        return accept;
                                    }
                                    return reject;
                                }
                                input := TextInput {
                                    x: 2px;
                                    y: 3px;
                                    width: parent.width - 4px;
                                    text <=> root.draft;
                                    font-size: 13px;
                                    color: #f6f2ff;
                                    selection-background-color: #9046ff66;
                                    wrap: word-wrap;
                                    single-line: false;
                                    accessible-role: text-input;
                                    accessible-label: "Reply";
                                }
                            }
                            Text {
                                x: 2px;
                                y: 3px;
                                visible: input.text == "";
                                text: root.busy ? "Reply now, " + root.tool + " reads it when this run ends" : "Reply to " + root.who + "…";
                                font-size: 13px;
                                color: #f6f2ff61;
                            }
                        }
                        // .cbar at the short height: margin-top 2
                        HorizontalLayout {
                            padding-top: 2px;
                            spacing: 4px;
                            height: 32px;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 15px;
                                background: attach.has-hover ? #ffffff14 : transparent;
                                accessible-role: button;
                                accessible-label: "Attach an image";
                                Icon {
                                    width: 16px;
                                    height: 16px;
                                    commands: "M12 5v14M5 12h14";
                                    ink: attach.has-hover ? #f6f2ff : #f6f2ff61;
                                    stroke-width: 1.9px;
                                }
                                attach := TouchArea { }
                            }
                            Rectangle {
                                width: pill.preferred-width + 18px + 17px;
                                height: 28px;
                                y: 1px;
                                border-radius: 14px;
                                background: pilla.has-hover ? #ffffff14 : transparent;
                                accessible-role: button;
                                accessible-label: "Model: Default. Change";
                                pill := Text {
                                    x: 9px;
                                    text: "Default";
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: #f6f2ff;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                Icon {
                                    x: pill.x + pill.preferred-width + 5px;
                                    width: 12px;
                                    height: 12px;
                                    commands: "m6 9 6 6 6-6";
                                    ink: #f6f2ff9e;
                                    stroke-width: 2.4px;
                                }
                                pilla := TouchArea { }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // .go: sends; .go.stop: stops the run when the box is empty.
                            go := Rectangle {
                                property <bool> stop: input.text == "" && root.busy;
                                property <bool> enabled: input.text != "" || stop;
                                width: 30px;
                                height: 30px;
                                border-radius: 15px;
                                background: stop ? #f2eef8 : #9046ff;
                                opacity: enabled ? 1 : 0.3;
                                accessible-role: button;
                                accessible-label: stop ? "Stop this run" : (root.busy ? "Queue this reply" : "Send");
                                accessible-enabled: enabled;
                                if !go.stop: Icon {
                                    width: 14px;
                                    height: 14px;
                                    commands: "M12 19V5M5 12l7-7 7 7";
                                    ink: white;
                                    stroke-width: 2.5px;
                                }
                                if go.stop: Rectangle {
                                    width: 11px * 14 / 24;
                                    height: 11px * 14 / 24;
                                    border-radius: 2px;
                                    background: #1a1220;
                                }
                                TouchArea {
                                    enabled: go.enabled;
                                    clicked => {
                                        if (go.stop) {
                                            root.stop();
                                        } else {
                                            root.send(input.text);
                                            input.text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
