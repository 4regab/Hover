// The office's chat drawer (page.html #drawer, at the notch's short height), in Slint.
// The thread itself is painted by hover-chat into `thread`; this file draws the chrome:
// the header, the composer and its buttons, and lays accessible text nodes over the
// thread so UI Automation reads the conversation.
import "../../../../web/office/fonts/PixelifySans.ttf";

export struct MenuItem {
    label: string,
    checked: bool,
}

export struct A11yBlock {
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
}

component Icon inherits Path {
    in property <color> ink;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: ink;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

// .x: 26 x 26, radius 8, rgba(255,255,255,.06); .x:hover .12
component XButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: area.has-hover ? #ffffff1f : #ffffff0f;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    Icon {
        width: 14px;
        height: 14px;
        commands: icon;
        ink: #f6f2ff9e;
        stroke-width: 2.2px;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// .av: the mascot's head.
component Avatar inherits Rectangle {
    in property <color> c;
    border-radius: 8px;
    background: c;
    Rectangle {
        x: parent.width * 0.60;
        y: -parent.height * 0.18;
        width: parent.width * 0.14;
        height: parent.height * 0.20;
        border-radius: 2px;
        background: #ffd24a;
        drop-shadow-blur: 6px;
        drop-shadow-color: #ffd24a;
    }
    Rectangle {
        x: parent.width * 0.18;
        y: parent.height * 0.28;
        width: parent.width * 0.64;
        height: parent.height * 0.48;
        border-radius: 4px;
        background: #121018;
    }
    for dx in [0, 0.22]: Rectangle {
        x: parent.width * (0.33 + dx);
        y: parent.height * 0.40;
        width: parent.width * 0.12;
        height: parent.height * 0.22;
        border-radius: 1px;
        background: #aaf6ff;
    }
}

export component ChatWindow inherits Window {
    in property <image> thread;
    in property <[A11yBlock]> blocks;
    in property <string> who: "Juno";
    in property <string> tool: "Codex";
    in property <color> tool-color: #3fd6a0;
    in property <string> session-title: "Fix the notch flicker on resize";
    in property <string> folder: "C:\\hover";
    in property <color> bot-color: #2fc9b0;
    in property <float> context: 48;
    in property <bool> busy;
    in-out property <string> draft;
    out property <length> thread-width: thread-area.width;
    out property <length> thread-height: thread-area.height;
    // kind: 0 down, 1 move while down, 2 up, 3 move (hover); shift for extending.
    callback pointer(int, length, length, bool);
    // dx, dy, the pointer, shift.
    callback wheel(length, length, length, length, bool);
    // Over a scrollbar: the arrow, not the text cursor.
    in property <bool> over-bar;
    callback copy-selection();
    callback select-all();
    callback send(string);
    callback stop();
    callback close();
    // The composer's images: pasted, dropped or picked, not sent yet.
    in property <[image]> shots;
    callback remove-shot(int);
    callback paste-image() -> bool;
    callback attach();
    in property <bool> drag-over;
    // A saved session shown from history (the transcript view).
    in property <bool> archived;
    // The model pill and its menu.
    in property <bool> has-models: true;
    in property <string> model-name: "Default";
    in property <string> effort-name;
    in property <string> tool-upper: "CODEX";
    in property <[MenuItem]> models;
    in property <[MenuItem]> efforts;
    in-out property <bool> menu-open;
    in-out property <int> menu-focus;
    callback toggle-menu();
    callback pick-model(int);
    callback pick-effort(int);
    in property <string> toast;
    in property <bool> toast-shown;
    // Windows' animation effects (off: nothing slides or fades).
    in property <bool> motion: true;
    // The drawer's .open, and a click on the office (the page: a bot opens it, the empty
    // floor closes it).
    in property <bool> open: true;
    callback office-click();
    title: "Hover · chat prototype";
    width: 1104px;
    height: 424px;
    background: #0b0810;
    default-font-family: "Segoe UI";

    TouchArea {
        clicked => { root.office-click(); }
    }
    if !root.open: Text {
        x: 24px;
        y: 24px;
        text: "Click the office to open " + root.who + "'s chat (prototype stand-in for a bot).";
        color: #f6f2ff61;
        font-size: 12px;
    }

    // #drawer at max-height: 620px: top/right/bottom 8, width min(360px, 100% - 16px), radius 16.
    // Closed, it sits translateX(100% + 24px) away and transparent; it slides in .35s on
    // cubic-bezier(.2, .9, .25, 1) and fades in .25s.
    drawer := Rectangle {
        x: parent.width - self.width - 8px + (root.open ? 0 : self.width + 24px);
        opacity: root.open ? 1 : 0;
        animate x { duration: root.motion ? 350ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        animate opacity { duration: root.motion ? 250ms : 0ms; easing: ease; }
        y: 8px;
        width: min(360px, parent.width - 16px);
        height: parent.height - 16px;
        border-radius: 16px;
        background: rgb(22, 14, 26);
        border-width: 1px;
        border-color: #ffffff17;
        clip: true;
        accessible-role: groupbox;
        accessible-label: "Session";

        VerticalLayout {
            // Inside the 1 px border, as the page's box model puts the content (the
            // thread is 358 px wide in a 360 px drawer).
            padding: 1px;
            // .dh: padding 9 8 0 10, gap 9
            HorizontalLayout {
                padding-top: 9px;
                padding-right: 8px;
                padding-left: 10px;
                spacing: 9px;
                Avatar {
                    width: 28px;
                    height: 26px;
                    c: root.bot-color;
                    y: 2px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.who;
                            font-family: "Pixelify Sans";
                            font-size: 13px;
                            font-weight: 600;
                            color: #f6f2ff;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: badge.preferred-width + 10px;
                            height: 13px;
                            y: 3px;
                            border-radius: 5px;
                            background: root.tool-color.with-alpha(0.2);
                            badge := Text {
                                text: root.tool;
                                font-size: 9.5px;
                                font-weight: 600;
                                color: root.tool-color;
                                letter-spacing: 0.03 * 9.5px;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.session-title;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: #f6f2ff;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 1px;
                        Text {
                            text: root.folder;
                            font-family: "Cascadia Code";
                            font-size: 11px;
                            color: #f6f2ff61;
                            overflow: elide;
                        }
                        // #ctxRing: a 14 px ring, conic from #C4A2FF.
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            accessible-role: text;
                            accessible-label: round(root.context) + "% of the context window used";
                            Path {
                                width: 14px;
                                height: 14px;
                                viewbox-width: 14;
                                viewbox-height: 14;
                                stroke: #ffffff1f;
                                stroke-width: 1.5px;
                                fill: transparent;
                                MoveTo { x: 7; y: 2.25; }
                                ArcTo { x: 7; y: 11.75; radius-x: 4.75; radius-y: 4.75; sweep: true; }
                                ArcTo { x: 7; y: 2.25; radius-x: 4.75; radius-y: 4.75; sweep: true; }
                            }
                            Path {
                                property <float> a: root.context / 100 * 2 * 3.14159265;
                                width: 14px;
                                height: 14px;
                                viewbox-width: 14;
                                viewbox-height: 14;
                                stroke: #c4a2ff;
                                stroke-width: 1.5px;
                                fill: transparent;
                                MoveTo { x: 7; y: 2.25; }
                                ArcTo {
                                    x: 7 + 4.75 * sin(a * 1rad);
                                    y: 7 - 4.75 * cos(a * 1rad);
                                    radius-x: 4.75;
                                    radius-y: 4.75;
                                    sweep: true;
                                    large-arc: root.context > 50;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                XButton {
                    label: "Delete this session";
                    icon: "M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3";
                }
                XButton {
                    label: "Close";
                    icon: "M6 6l12 12M18 6 6 18";
                    clicked => { root.close(); }
                }
            }

            // #thread: painted by hover-chat, one viewport at a time.
            thread-area := Rectangle {
                vertical-stretch: 1;
                accessible-role: list;
                accessible-label: "Conversation";
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.thread;
                    image-fit: fill;
                }
                for b in root.blocks: Rectangle {
                    x: b.x;
                    y: b.y;
                    width: b.w;
                    height: b.h;
                    accessible-role: text;
                    accessible-label: b.text;
                }
                keys := FocusScope {
                    key-pressed(event) => {
                        if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                            root.copy-selection();
                            return accept;
                        }
                        if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                            root.select-all();
                            return accept;
                        }
                        return reject;
                    }
                    TouchArea {
                        mouse-cursor: root.over-bar ? default : text;
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                keys.focus();
                                root.pointer(0, self.mouse-x, self.mouse-y, e.modifiers.shift);
                            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                root.pointer(2, self.mouse-x, self.mouse-y, false);
                            } else if (e.kind == PointerEventKind.move) {
                                root.pointer(3, self.mouse-x, self.mouse-y, false);
                            }
                        }
                        moved => { root.pointer(1, self.mouse-x, self.mouse-y, false); }
                        scroll-event(e) => {
                            root.wheel(-e.delta-x, -e.delta-y, self.mouse-x, self.mouse-y, e.modifiers.shift);
                            return accept;
                        }
                    }
                }
            }

            // .composer: margin 6 10 10, padding 6 6 5 9, radius 15, rgba(0,0,0,.32), 1px line.
            Rectangle {
                height: composer.preferred-height + 16px;
                composer := Rectangle {
                    // .composer:focus-within and .over (files dragged over it) look the same.
                    property <bool> lit: input.has-focus || root.drag-over;
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    height: col.preferred-height;
                    border-radius: 15px;
                    background: #00000052;
                    border-width: 1px;
                    border-color: lit ? #c4a2ff8c : (hover.has-hover ? #ffffff26 : #ffffff17);
                    // box-shadow 0 0 0 3px rgba(144,70,255,.15)
                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 18px;
                        border-width: 3px;
                        border-color: composer.lit ? #9046ff26 : transparent;
                    }
                    hover := TouchArea {
                        mouse-cursor: text;
                        clicked => { input.focus(); }
                    }
                    col := VerticalLayout {
                        padding-top: 6px;
                        padding-right: 6px;
                        padding-bottom: 5px;
                        padding-left: 9px;
                        // .shots: flex, gap 6, padding 3 3 6; .shot 52 x 52, radius 9, black,
                        // a 1 px ring; its remove button 18 x 18 at top 3 right 3.
                        if root.shots.length > 0: HorizontalLayout {
                            padding: 3px;
                            padding-bottom: 6px;
                            spacing: 6px;
                            alignment: start;
                            for shot[i] in root.shots: Rectangle {
                                width: 52px;
                                height: 52px;
                                Rectangle {
                                    x: -1px;
                                    y: -1px;
                                    width: 54px;
                                    height: 54px;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #ffffff17;
                                }
                                Rectangle {
                                    border-radius: 9px;
                                    clip: true;
                                    background: black;
                                    Image {
                                        width: 52px;
                                        height: 52px;
                                        source: shot;
                                        image-fit: cover;
                                        accessible-role: image;
                                        accessible-label: "Image " + (i + 1);
                                    }
                                }
                                Rectangle {
                                    x: 52px - 3px - 18px;
                                    y: 3px;
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: #000000b3;
                                    accessible-role: button;
                                    accessible-label: "Remove image " + (i + 1);
                                    accessible-action-default => { root.remove-shot(i); }
                                    Icon {
                                        width: 9px;
                                        height: 9px;
                                        commands: "M6 6l12 12M18 6 6 18";
                                        ink: white;
                                        stroke-width: 1.125px;
                                    }
                                    TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.remove-shot(i); }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: clamp(input.preferred-height + 6px, 28px, 112px);
                            FocusScope {
                                capture-key-pressed(event) => {
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        if (input.text != "" || root.shots.length > 0) {
                                            root.send(input.text);
                                            input.text = "";
                                        }
                                        return accept;
                                    }
                                    // A paste with an image (or image files) on the clipboard
                                    // attaches it; otherwise the text goes in as usual.
                                    if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                                        if (root.paste-image()) {
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                                input := TextInput {
                                    x: 2px;
                                    y: 3px;
                                    width: parent.width - 4px;
                                    text <=> root.draft;
                                    font-size: 13px;
                                    color: #f6f2ff;
                                    selection-background-color: #9046ff66;
                                    wrap: word-wrap;
                                    single-line: false;
                                    accessible-role: text-input;
                                    accessible-label: "Reply";
                                }
                            }
                            Text {
                                x: 2px;
                                y: 3px;
                                visible: input.text == "";
                                text: root.archived ? "Reply to wake " + root.tool + " and carry on…" : (root.busy ? "Reply now, " + root.tool + " reads it when this run ends" : "Reply to " + root.who + "…");
                                font-size: 13px;
                                color: #f6f2ff61;
                            }
                        }
                        // .cbar at the short height: margin-top 2
                        HorizontalLayout {
                            padding-top: 2px;
                            spacing: 4px;
                            height: 32px;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 15px;
                                background: attach.has-hover ? #ffffff14 : transparent;
                                accessible-role: button;
                                accessible-label: "Attach an image";
                                accessible-action-default => { root.attach(); }
                                Icon {
                                    width: 16px;
                                    height: 16px;
                                    commands: "M12 5v14M5 12h14";
                                    ink: attach.has-hover ? #f6f2ff : #f6f2ff61;
                                    stroke-width: 1.9px;
                                }
                                attach := TouchArea {
                                    clicked => { root.attach(); }
                                }
                            }
                            // .mpill: 28 tall, padding 0 9, gap 5, 12.5px 600; em (the effort)
                            // in dim 500; a 12 px chevron. Hidden when the tool has no models.
                            pillbox := Rectangle {
                                visible: root.has-models;
                                width: root.has-models ? min(pillrow.preferred-width + 18px, 0.62 * (composer.width - 15px)) : 0;
                                height: 28px;
                                y: 1px;
                                border-radius: 14px;
                                background: pilla.has-hover || root.menu-open ? #ffffff14 : transparent;
                                accessible-role: button;
                                accessible-label: "Model: " + root.model-name + (root.effort-name != "" ? ", " + root.effort-name : "") + ". Change";
                                accessible-action-default => { root.toggle-menu(); }
                                clip: true;
                                pillrow := HorizontalLayout {
                                    x: 9px;
                                    width: parent.width - 18px;
                                    spacing: 5px;
                                    Text {
                                        text: root.model-name;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: #f6f2ff;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if root.effort-name != "": Text {
                                        text: root.effort-name;
                                        font-size: 12.5px;
                                        font-weight: 500;
                                        color: #f6f2ff9e;
                                        vertical-alignment: center;
                                    }
                                    Icon {
                                        width: 12px;
                                        height: 12px;
                                        y: 8px;
                                        commands: "m6 9 6 6 6-6";
                                        ink: #f6f2ff9e;
                                        stroke-width: 2.4px;
                                    }
                                }
                                pilla := TouchArea {
                                    clicked => {
                                        root.toggle-menu();
                                        if (root.menu-open) {
                                            menukeys.focus();
                                        }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // .go: sends; .go.stop: stops the run when the box is empty.
                            go := Rectangle {
                                property <bool> empty: input.text == "" && root.shots.length == 0;
                                property <bool> stop: empty && root.busy && !root.archived;
                                property <bool> enabled: !empty || stop;
                                width: 30px;
                                height: 30px;
                                border-radius: 15px;
                                background: stop ? #f2eef8 : #9046ff;
                                opacity: enabled ? 1 : 0.3;
                                accessible-role: button;
                                accessible-label: stop ? "Stop this run" : (root.busy ? "Queue this reply" : "Send");
                                accessible-enabled: enabled;
                                if !go.stop: Icon {
                                    width: 14px;
                                    height: 14px;
                                    commands: "M12 19V5M5 12l7-7 7 7";
                                    ink: white;
                                    stroke-width: 2.5px;
                                }
                                if go.stop: Rectangle {
                                    width: 11px * 14 / 24;
                                    height: 11px * 14 / 24;
                                    border-radius: 2px;
                                    background: #1a1220;
                                }
                                TouchArea {
                                    enabled: go.enabled;
                                    clicked => {
                                        if (go.stop) {
                                            root.stop();
                                        } else {
                                            root.send(input.text);
                                            input.text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // A click beside the open menu closes it (the page's window pointerdown).
    if root.menu-open: TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.menu-open = false;
            }
        }
    }

    // #mMenu: 250 wide, above the pill and 6 px clear of it, inside the office by 8 px;
    // glass, radius 14, padding 6. Headings in the pixel font; model rows 6 8, radius 8,
    // with a check on the current one; the efforts as a row of equal buttons.
    // The glass's shadow (0 12px 36px rgba(0,0,0,.4)), apart from the clipped menu: the
    // software renderer drops an element that has both.
    Rectangle {
        visible: root.menu-open;
        x: menu.x;
        y: menu.y;
        width: menu.width;
        height: menu.height;
        border-radius: 14px;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000066;
    }
    menu := Rectangle {
        property <int> n: root.models.length;
        property <length> h: min(menucol.preferred-height, 360px, root.height - 20px);
        visible: root.menu-open;
        x: max(8px, min(pillbox.absolute-position.x - root.absolute-position.x, root.width - 258px));
        y: max(8px, pillbox.absolute-position.y - root.absolute-position.y - self.h - 6px);
        width: 250px;
        height: self.h;
        border-radius: 14px;
        background: #160f1eb8;
        border-width: 1px;
        border-color: #ffffff17;
        clip: true;
        accessible-role: list;
        accessible-label: root.tool + " model";
        menukeys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.menu-focus = Math.mod(root.menu-focus + 1, menu.n + root.efforts.length);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.menu-focus = Math.mod(root.menu-focus - 1 + menu.n + root.efforts.length, menu.n + root.efforts.length);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.menu-open = false;
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") {
                    if (root.menu-focus < menu.n) {
                        root.pick-model(root.menu-focus);
                    } else {
                        root.pick-effort(root.menu-focus - menu.n);
                    }
                    return accept;
                }
                return reject;
            }
        }
        menucol := VerticalLayout {
            padding: 6px;
            Text {
                text: root.tool-upper + " MODEL";
                font-family: "Pixelify Sans";
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: 0.06 * 10.5px;
                color: #f6f2ff61;
                // margin 6 8 4
                height: self.preferred-height + 10px;
                x: 8px;
                vertical-alignment: center;
            }
            for m[i] in root.models: Rectangle {
                height: mt.preferred-height + 12px;
                border-radius: 8px;
                background: ma.has-hover || root.menu-focus == i ? #ffffff17 : transparent;
                accessible-role: button;
                accessible-label: m.label;
                accessible-checked: m.checked;
                accessible-action-default => { root.pick-model(i); }
                mt := Text {
                    x: 8px;
                    width: parent.width - 16px - 16px;
                    text: m.label;
                    font-size: 12.5px;
                    color: #f6f2ff;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // ::after: 8 x 4, border 0 0 2px 2px var(--li), rotated -45 deg.
                if m.checked: Path {
                    x: parent.width - 8px - 10px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    stroke: #c4a2ff;
                    stroke-width: 2px;
                    fill: transparent;
                    commands: "M1.2 4.2 L3.8 6.8 L8.8 1.8";
                }
                ma := TouchArea { clicked => { root.pick-model(i); } }
            }
            if root.efforts.length > 0: Text {
                text: "EFFORT";
                font-family: "Pixelify Sans";
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: 0.06 * 10.5px;
                color: #f6f2ff61;
                height: self.preferred-height + 10px;
                x: 8px;
                vertical-alignment: center;
            }
            if root.efforts.length > 0: HorizontalLayout {
                spacing: 3px;
                padding-top: 2px;
                padding-left: 4px;
                padding-right: 4px;
                padding-bottom: 4px;
                for e[i] in root.efforts: Rectangle {
                    horizontal-stretch: 1;
                    height: et.preferred-height + 10px;
                    border-radius: 8px;
                    background: e.checked ? #9046ff59 : (ea.has-hover || root.menu-focus == menu.n + i ? #ffffff17 : #ffffff0d);
                    accessible-role: button;
                    accessible-label: e.label;
                    accessible-checked: e.checked;
                    accessible-action-default => { root.pick-effort(i); }
                    et := Text {
                        text: e.label;
                        font-size: 11.5px;
                        color: #f6f2ff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ea := TouchArea { clicked => { root.pick-effort(i); } }
                }
            }
            Text {
                text: "Used by " + root.tool + " from its next turn.";
                font-size: 11px;
                color: #f6f2ff61;
                x: 8px;
                height: self.preferred-height + 7px;
                vertical-alignment: center;
            }
        }
    }

    // #toast: centred, 10 px from the top, glass, radius 12, padding 6 12, the pixel
    // font at 600 12px; it drops in over .25s and leaves after 2.8 s.
    toastbox := Rectangle {
        property <bool> show: root.toast != "" && root.toast-shown;
        x: (root.width - self.width) / 2;
        y: show ? 10px : -2px;
        width: tt.preferred-width + 24px;
        height: tt.preferred-height + 12px;
        opacity: show ? 1 : 0;
        animate y, opacity { duration: root.motion ? 250ms : 0ms; easing: ease; }
        border-radius: 12px;
        background: #160f1eb8;
        border-width: 1px;
        border-color: #ffffff17;
        accessible-role: text;
        accessible-label: show ? root.toast : "";
        tt := Text {
            text: root.toast;
            font-family: "Pixelify Sans";
            font-size: 12px;
            font-weight: 600;
            color: #f6f2ff;
        }
    }
}
