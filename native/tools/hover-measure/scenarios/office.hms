# The office alone: resting, open and idle, then dropped. Short, for A/B checks.
launch
expect "bench visible" 30 as startup
mark collapsed-fresh
sleep 15
mark -
send unfold
expect "bench reopen" 20 as first-office
sleep 3
mark office-open-idle
sleep 25
send frames 10
expect "bench frames" 5
mark -
send fold
expect "bench folded" 5
expect "bench dropped" 40
sleep 3
mark collapsed-after-drop
sleep 15
mark -
quit 30
