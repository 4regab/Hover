# The shared GPU device's allocator (bench gpu full) and the Rust heap (profiling
# builds: bench heap) at each state, with a region breakdown: what the office leaves
# behind after it is dropped, and where.
launch
expect "bench visible" 30 as startup
sleep 5
mark collapsed-fresh
send gpu full
expect "bench gpu" 5
send heap
expect "bench heap" 5
regions regions-collapsed-fresh.txt
sleep 5
send unfold
expect "bench reopen" 30 as first-office
sleep 8
mark office-open-idle
send gpu full
expect "bench gpu" 5
send heap
expect "bench heap" 5
regions regions-office-open.txt
sleep 5
send task kiro @ - a long answer [seconds:3] [bytes:400000]
expect "bench task" 5
send until-idle 60
expect "bench idle" 65
send sessions
expect "bench sessions" 5
send chat 1
expect "bench ok" 5
sleep 5
mark chat-rich-open
send gpu full
expect "bench gpu" 5
send heap
expect "bench heap" 5
sleep 5
send chat
expect "bench ok" 5
send fold
expect "bench folded" 5
expect "bench dropped" 40
sleep 5
mark collapsed-after-drop
send gpu full
expect "bench gpu" 5
send heap
expect "bench heap" 5
regions regions-collapsed-after-drop.txt
sleep 5
mark -
quit 30
