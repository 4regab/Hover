# Reopening, timed: ten times after the office was dropped (hidden 30 s) and ten times
# warm (hidden a moment), with a chat open, as the user finds it again.
launch
expect "bench visible" 30 as startup
send task kiro @ - a chat to find again [seconds:1] [bytes:20000]
expect "bench task" 5
send until-idle 30
expect "bench idle" 35
send unfold
expect "bench reopen" 20 as first-office
send chat 1
expect "bench ok" 5
sleep 3
repeat 10
send fold
expect "bench folded" 5
sleep 2
send unfold
expect "bench reopen" 20 as reopen-warm
sleep 3
send fold
expect "bench folded" 5
expect "bench dropped" 40
sleep 2
send unfold
expect "bench reopen" 20 as reopen-after-drop
sleep 3
end
quit 30
