# The Rust heap at each state, from a `--features profiling` build (bench.rs `heap`):
# live bytes, the peak since the last reset, and allocations made. Two readings 10 s
# apart in each state give its allocation rate.
launch
expect "bench visible" 30 as startup
sleep 10
mark collapsed-fresh
send heap
expect "bench heap" 5
sleep 10
send heap
expect "bench heap" 5

send heap-reset
expect "bench ok" 5
send unfold
expect "bench reopen" 20 as first-office
sleep 5
mark office-open-idle
send heap
expect "bench heap" 5
sleep 10
send heap
expect "bench heap" 5

send task kiro @ - three [seconds:30]
expect "bench task" 5
send task codex @ - three [seconds:30]
expect "bench task" 5
send task kiro @ - three [seconds:30]
expect "bench task" 5
sleep 5
mark agents-3
send heap
expect "bench heap" 5
sleep 10
send heap
expect "bench heap" 5
send until-idle 40
expect "bench idle" 45

send task kiro @ - a long answer [seconds:3] [bytes:400000]
expect "bench task" 5
send until-idle 60
expect "bench idle" 65
send chat 4
expect "bench ok" 5
sleep 5
mark chat-rich-open
send heap
expect "bench heap" 5
sleep 10
send heap
expect "bench heap" 5
send chat
expect "bench ok" 5

send fold
expect "bench folded" 5
expect "bench dropped" 40
sleep 5
mark collapsed-after-drop
send heap
expect "bench heap" 5
sleep 10
send heap
expect "bench heap" 5
mark -
quit 30
