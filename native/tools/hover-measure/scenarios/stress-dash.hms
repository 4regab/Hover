# The app window minimised and restored over and over while the office draws at full
# speed (three agents at work): each restore sets the window's surface up again while
# the office thread submits frames on the same GPU device (Windows).
launch
expect "bench visible" 30 as startup
send task kiro @ - one [seconds:120]
expect "bench task" 5
send task codex @ - two [seconds:120]
expect "bench task" 5
send task kiro @ - three [seconds:120]
expect "bench task" 5
send dash
expect "bench ok" 5
sleep 3
mark dash-cycles
repeat 80
send dash-min
expect "bench ok" 5
sleep 0.4
send dash-restore
expect "bench ok" 5
sleep 0.4
send state
expect "bench state" 5
end
mark -
send stopall
expect "bench ok" 5
quit 30
